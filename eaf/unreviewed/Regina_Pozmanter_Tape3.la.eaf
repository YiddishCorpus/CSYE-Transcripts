			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1168" TIME_SLOT_REF1="ts1087" TIME_SLOT_REF2="ts1088">
				<ANNOTATION_VALUE>hob ikh bafoyln az zi zol, az zi zol nokh dort fun nokh nokh gornisht visn gemakht</ANNOTATION_VALUE>
