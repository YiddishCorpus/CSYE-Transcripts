		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts1107" TIME_SLOT_REF2="ts1108">
				<ANNOTATION_VALUE>aheym in undzer shtetl iz keyner nisht gekumen.</ANNOTATION_VALUE>
