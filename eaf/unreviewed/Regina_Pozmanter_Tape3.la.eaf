			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts1082" TIME_SLOT_REF2="ts1084">
				<ANNOTATION_VALUE>neyn, &lt;hot er do-&gt;, hob ikh gezogt "neyn, zol &lt;oykh&gt; dort zayn"</ANNOTATION_VALUE>
