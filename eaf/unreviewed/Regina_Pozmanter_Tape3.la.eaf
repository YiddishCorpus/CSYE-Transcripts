		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts1109" TIME_SLOT_REF2="ts1110">
				<ANNOTATION_VALUE>nakher, nakher, nokh efsher nokh ale di yor arum</ANNOTATION_VALUE>
