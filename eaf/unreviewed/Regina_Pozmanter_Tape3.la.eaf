			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1171" TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1094">
				<ANNOTATION_VALUE>biz kh'el hobn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
