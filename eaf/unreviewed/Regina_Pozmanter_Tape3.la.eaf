		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts1100" TIME_SLOT_REF2="ts1103">
				<ANNOTATION_VALUE>eh ah ah s- a vunder! eyn yidish kind iz aheymgekumen. ikh bin geven di eyntsike vos &lt;ikh bin&gt; gekumen.</ANNOTATION_VALUE>
