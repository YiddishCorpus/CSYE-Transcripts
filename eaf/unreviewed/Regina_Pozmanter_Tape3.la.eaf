			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1172" TIME_SLOT_REF1="ts1095" TIME_SLOT_REF2="ts1096">
				<ANNOTATION_VALUE>HELTSHE zayn ayngeordnt, zenen dokh bald gevor gevorn.</ANNOTATION_VALUE>
