			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1070">
				<ANNOTATION_VALUE>tsen monatn hob ikh gevoynt in mayn shtub </ANNOTATION_VALUE>
