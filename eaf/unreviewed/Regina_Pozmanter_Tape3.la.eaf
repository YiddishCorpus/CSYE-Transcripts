		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1174" TIME_SLOT_REF1="ts1099" TIME_SLOT_REF2="ts1101">
				<ANNOTATION_VALUE>iz di ale kristn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
