		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a738" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts4">
				<ANNOTATION_VALUE>in eh vu ir hot, in di plats, in di shtetl vu ir hot gevoynt,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a740" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
				<ANNOTATION_VALUE>hot ir gehat oykh farbindung mit di goyim dortn?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
