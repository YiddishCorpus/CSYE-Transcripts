				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a742" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts13">
				<ANNOTATION_VALUE>ir f- neyn, ikh hob gezogt az ir hot dertseylt</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a744" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts16">
				<ANNOTATION_VALUE>az mit di yidn hot men hot men gehat shtar- eh shtark in kontakt. m'hot geholfn m'hot ge- a mentsh vos hot nisht gehat oyf shabes, hot ir, dos hot ir getsolt. yo. vos far a farbindung hot ir gehat mit di goyim in di shtetl?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a745" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts21">
				<ANNOTATION_VALUE>yo.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a746" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts105">
				<ANNOTATION_VALUE>ven hot ir gezen az s- s'kumt a shlekhte tsayt yetst?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a747" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts109">
				<ANNOTATION_VALUE>biz damolts niks?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a748" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts113">
				<ANNOTATION_VALUE>vi hot ir dos gefilt, vi hot ir dos gehert?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
