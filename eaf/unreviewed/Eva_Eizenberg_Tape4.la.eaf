		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a860" TIME_SLOT_REF1="ts837" TIME_SLOT_REF2="ts838">
				<ANNOTATION_VALUE>ikh meyn az dos iz geven a sheliekh fun got.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
