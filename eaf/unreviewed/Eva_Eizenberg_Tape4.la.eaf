			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a904" TIME_SLOT_REF1="ts937" TIME_SLOT_REF2="ts938">
				<ANNOTATION_VALUE>m'hot undz ongetun in zeyer eh, in, ir zolt mir moykhl zayn, in gatyes un in groyse hemder</ANNOTATION_VALUE>
