		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a861" TIME_SLOT_REF1="ts839" TIME_SLOT_REF2="ts840">
				<ANNOTATION_VALUE>ehm er hot undz geratevet fun hunger un fun, fun alemen</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a862" TIME_SLOT_REF1="ts841" TIME_SLOT_REF2="ts842">
				<ANNOTATION_VALUE>eh vayl di eltste shvester undzere iz geblibn, un dernokh fun MOGILEV iz zi gegangen tsu fus</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
