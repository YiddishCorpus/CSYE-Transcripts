		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a859" TIME_SLOT_REF1="ts835" TIME_SLOT_REF2="ts836">
				<ANNOTATION_VALUE>eh der yid eh I- IOSIF ZELMANOVICH FEL'DMAN</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
