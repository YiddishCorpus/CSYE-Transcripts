		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a822" TIME_SLOT_REF1="ts755" TIME_SLOT_REF2="ts756">
				<ANNOTATION_VALUE>zenen mir gezesn oyf der gas, es iz shmutsike, dos shmuts, kh'ken zikh nisht fargesn dos shmuts.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
