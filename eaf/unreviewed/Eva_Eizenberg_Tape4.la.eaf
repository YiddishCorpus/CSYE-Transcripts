		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a855" TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts822">
				<ANNOTATION_VALUE>vos zey zenen gegangen fun Sibir, zenen zey gegangen nokh der armey. dos iz geven</ANNOTATION_VALUE>
