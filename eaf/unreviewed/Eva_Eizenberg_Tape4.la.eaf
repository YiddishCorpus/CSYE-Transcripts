			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a908" TIME_SLOT_REF1="ts945" TIME_SLOT_REF2="ts946">
				<ANNOTATION_VALUE>un m'hot gezogt az m'vet kumen morgn oyfn tsveytn tog</ANNOTATION_VALUE>
