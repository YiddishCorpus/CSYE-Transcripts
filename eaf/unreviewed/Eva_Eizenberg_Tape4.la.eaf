		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a839" TIME_SLOT_REF1="ts789" TIME_SLOT_REF2="ts790">
				<ANNOTATION_VALUE>un mir zoln dertseyln vos iz mit undz forgekumen.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
