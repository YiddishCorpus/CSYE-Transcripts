		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a824" TIME_SLOT_REF1="ts759" TIME_SLOT_REF2="ts760">
				<ANNOTATION_VALUE>eh plutsem iz tsun undz tsugekumen a, a, a r- a rusisher ofitser</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
