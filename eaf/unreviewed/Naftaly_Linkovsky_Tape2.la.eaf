			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a941" TIME_SLOT_REF1="ts1043" TIME_SLOT_REF2="ts1044">
				<ANNOTATION_VALUE>er iz a lerer, iz er oykhet gegangen mit ir tsuzamen dortn, iz er oykhet umgekumen.</ANNOTATION_VALUE>
