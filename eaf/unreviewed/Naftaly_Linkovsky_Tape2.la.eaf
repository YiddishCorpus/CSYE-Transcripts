			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a928" TIME_SLOT_REF1="ts1017" TIME_SLOT_REF2="ts1018">
				<ANNOTATION_VALUE>iz geblibn lebn vos fun im hobn mir oysgefunen</ANNOTATION_VALUE>
