		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a931" TIME_SLOT_REF1="ts1023" TIME_SLOT_REF2="ts1024">
				<ANNOTATION_VALUE>un er iz geven shtark, a shtarker mentsh. m'hot oysgekloybn di shtarkste. yene hot men do oysgeshosn</ANNOTATION_VALUE>
