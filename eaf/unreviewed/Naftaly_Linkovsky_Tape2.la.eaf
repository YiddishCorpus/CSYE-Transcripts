		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a930" TIME_SLOT_REF1="ts1021" TIME_SLOT_REF2="ts1022">
				<ANNOTATION_VALUE>vos er hot bagrobn di meysim</ANNOTATION_VALUE>
