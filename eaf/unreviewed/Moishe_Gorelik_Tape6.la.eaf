		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts400">
				<ANNOTATION_VALUE>un tsu dem blok bin ikh dergangen.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
