		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts396">
				<ANNOTATION_VALUE>trakht, "ikh vel geyn itster hargenen zikh.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
