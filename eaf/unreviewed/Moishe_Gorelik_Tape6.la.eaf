			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1208" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts366">
				<ANNOTATION_VALUE>hobn zey mir oykhet nit ge- nit, nit fa- zey hobn gezen, nor nit farshtanen, uh, zey meynen az ikh gey,</ANNOTATION_VALUE>
