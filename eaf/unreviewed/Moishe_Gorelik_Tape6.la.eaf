		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1209" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts388">
				<ANNOTATION_VALUE>un tsvishn di blokn iz di, der ployt zet zikh durkh,</ANNOTATION_VALUE>
