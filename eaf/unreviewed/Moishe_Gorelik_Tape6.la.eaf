			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts361" TIME_SLOT_REF2="ts362">
				<ANNOTATION_VALUE>kurts geredt, iz di vakh-manes, az ikh fleg durkhgeyn afile</ANNOTATION_VALUE>
