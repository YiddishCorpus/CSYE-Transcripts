		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts394">
				<ANNOTATION_VALUE>do iz nor der ployt, un do &lt;i-&gt; a VYSHKe a groyse shteyt, hm, a VYSHKe vu der soldat mit alts.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
