			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts398">
				<ANNOTATION_VALUE>&lt;s'iz&gt; shoyn nito vos &lt;tsum&gt; kenen zikh UNK."</ANNOTATION_VALUE>
