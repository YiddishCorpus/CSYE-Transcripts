			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts322">
				<ANNOTATION_VALUE>farshteyst? aza min agitatsye iz geven un aza min retsikhe &lt;k-&gt; iz geven tsum yidn.</ANNOTATION_VALUE>
