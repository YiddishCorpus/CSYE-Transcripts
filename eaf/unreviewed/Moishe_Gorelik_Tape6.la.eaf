		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts386">
				<ANNOTATION_VALUE>hob ikh zikh shoyn fardreyt aher tsu di blokn un ikh gey,</ANNOTATION_VALUE>
