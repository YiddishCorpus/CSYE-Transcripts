		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts488">
				<ANNOTATION_VALUE>zi hot zikh dortn oysgelernt un zi ken.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
