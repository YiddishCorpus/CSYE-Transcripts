		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts532">
				<ANNOTATION_VALUE>hot er gehert un iz gegangen, hot zikh ISPRAVet di shkole, "vos heyst&lt;, uh, z-&gt; zogst azoy oyf a kind?"</ANNOTATION_VALUE>
