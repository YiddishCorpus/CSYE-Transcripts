		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts402">
				<ANNOTATION_VALUE>un zi zogt, "BABUSHKA, kh'hob dikh lib," un aldings. uh, &lt;iz&gt; hob ikh a UDOVOL'STVe.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts410">
				<ANNOTATION_VALUE>DA, DA, DA. zi re- ONA, zi farshteyt aldings oyf yidish, aldings, nor zi ken nit redn.</ANNOTATION_VALUE>
