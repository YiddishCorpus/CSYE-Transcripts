		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts394">
				<ANNOTATION_VALUE>er shloft bay mir, ikh fir im in SADIK.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
