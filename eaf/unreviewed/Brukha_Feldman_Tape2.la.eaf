		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts412">
				<ANNOTATION_VALUE>azoy vi &lt;z-&gt; redn ken zi nit, nor zi redt shoyn a bisl oykhet.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts413" TIME_SLOT_REF2="ts414">
				<ANNOTATION_VALUE>un, uh, zi zogt, "ven ikh bin," zogt zi, "azoy oyf Anye's ort"...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts416">
				<ANNOTATION_VALUE>ven, uh, zi darf zikh nemen bay im a RAZRESHENIE, zi zol forn un aldings, er ken zi nit oplozn in IZRAILe... "ven ikh bin oyf Anyen,"</ANNOTATION_VALUE>
