		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts374">
				<ANNOTATION_VALUE>VSЁ. kum ikh tsu geyn, breng ikh a PODAROK, zits ikh un, uh, un es op dortn tsi vos, tsi, tsi kh'trink op tsi vos, I VSЁ.</ANNOTATION_VALUE>
