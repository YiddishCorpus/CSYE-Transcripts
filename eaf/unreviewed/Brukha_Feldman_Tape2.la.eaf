		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts400">
				<ANNOTATION_VALUE>az dos eltere eynikl ligt bay mir itster in BOL'NITSe, gey ikh in BOL'NITSe, trog ir op epes un, uh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
