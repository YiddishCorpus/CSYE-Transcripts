		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts398">
				<ANNOTATION_VALUE>ver den vet geyn NAVSTRECHе? a mame muz geyn NAVSTRECHе, a bobe. VSЁ.</ANNOTATION_VALUE>
