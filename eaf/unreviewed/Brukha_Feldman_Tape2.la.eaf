		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts392">
				<ANNOTATION_VALUE>ikh hob zey lib.</ANNOTATION_VALUE>
