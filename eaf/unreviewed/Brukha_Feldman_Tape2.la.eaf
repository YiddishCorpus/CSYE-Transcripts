			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts744" TIME_SLOT_REF2="ts746">
				<ANNOTATION_VALUE>zog ikh, "nu, vel ikh geyn oyfbagrobn mayn mamen, &lt;vet&gt; mayn mame dertseyln. ikh hob zikh mit der mamen gemutshet, aldings."</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
