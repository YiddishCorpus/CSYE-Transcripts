		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts672">
				<ANNOTATION_VALUE>in ansambl ANACHNU KAN vos zenen gekumen tsurik mit draysik yor</ANNOTATION_VALUE>
