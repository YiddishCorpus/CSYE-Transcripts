		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
				<ANNOTATION_VALUE>CANTOR LINKOVSKY, IR VILT EPES ZOGN?</ANNOTATION_VALUE>
