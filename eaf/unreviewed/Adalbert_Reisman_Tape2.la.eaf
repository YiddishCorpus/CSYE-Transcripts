		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts560">
				<ANNOTATION_VALUE>ikh bin geven tsuzamen mit dem Laslo un eh fun detsember</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
