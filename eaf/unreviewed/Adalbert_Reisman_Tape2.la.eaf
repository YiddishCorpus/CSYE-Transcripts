		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts561" TIME_SLOT_REF2="ts562">
				<ANNOTATION_VALUE>un mit Bondi bin ikh geven oykh vi heyst er biz biz mertsh.</ANNOTATION_VALUE>
