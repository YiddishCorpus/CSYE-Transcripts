		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts843" TIME_SLOT_REF2="ts845">
				<ANNOTATION_VALUE>veyst, in a, v&lt;UNK&gt;, veyst vos s'heyst tyurme? nu, oykhet, nu, dos iz a lager UNK.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts848">
				<ANNOTATION_VALUE>tsk, VOT. nor frier iz geven a tyurme. zey hobn OSVOBO- aroysgelozn di,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1161" TIME_SLOT_REF1="ts849" TIME_SLOT_REF2="ts850">
				<ANNOTATION_VALUE>uh, di, hm, di vos flegn hargenen mentshn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
