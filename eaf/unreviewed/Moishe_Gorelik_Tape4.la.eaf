		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts851" TIME_SLOT_REF2="ts853">
				<ANNOTATION_VALUE>fun tyurme, di ganovim aroysgelozn un UNK, di NEMTSes. iz...</ANNOTATION_VALUE>
