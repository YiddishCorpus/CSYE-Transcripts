			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts854" TIME_SLOT_REF2="ts857">
				<ANNOTATION_VALUE>ha?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts858" TIME_SLOT_REF2="ts860">
				<ANNOTATION_VALUE>do iz geven, in dem lager, kh'bin geven in d&lt;UNK&gt; in dos o a, a teg tsen in gantsn,</ANNOTATION_VALUE>
