			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts861" TIME_SLOT_REF2="ts862">
				<ANNOTATION_VALUE>in DNEPROPETROVSK.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
