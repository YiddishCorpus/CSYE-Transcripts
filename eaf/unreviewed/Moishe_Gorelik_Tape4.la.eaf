		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts810">
				<ANNOTATION_VALUE>un der yid flegt dortn mit tsores</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
