		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts626">
				<ANNOTATION_VALUE>VOT. uh, tsvey hundert I draysik zekste teyl heyst zi, &lt;artteyl&gt;.</ANNOTATION_VALUE>
