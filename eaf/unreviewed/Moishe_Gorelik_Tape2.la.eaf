		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts628">
				<ANNOTATION_VALUE>&lt;m'hot mir&gt; gegebn shoyn naye soldatn.</ANNOTATION_VALUE>
