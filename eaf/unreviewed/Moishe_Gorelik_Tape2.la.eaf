		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts379" TIME_SLOT_REF2="ts380">
				<ANNOTATION_VALUE>mir hobn gemeynt az m'vet undz heysn az mir zoln do aynfestikn zikh.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
