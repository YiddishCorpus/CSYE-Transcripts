		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1130" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts374">
				<ANNOTATION_VALUE>do hobn mir ongehoybn optretn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
