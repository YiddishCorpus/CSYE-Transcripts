		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts684">
				<ANNOTATION_VALUE>forn di pozharnikes un shrayen, "ha ha ha ha!"</ANNOTATION_VALUE>
