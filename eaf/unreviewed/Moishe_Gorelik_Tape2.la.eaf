		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
				<ANNOTATION_VALUE>hot zikh ongehoybn di milkhome, hobn mir glaykh ongehoybn... bay undz iz</ANNOTATION_VALUE>
