		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts674">
				<ANNOTATION_VALUE>mir hobn gedarft forn ahin gikh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
