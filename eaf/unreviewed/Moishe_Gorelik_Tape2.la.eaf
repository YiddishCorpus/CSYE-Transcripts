		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts632">
				<ANNOTATION_VALUE>vi tsu... m'hot undz gegebn &lt;a,&gt; soldatn iber hoypt shoyn eltere mentshn: shoyn geven draysik yorike,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
