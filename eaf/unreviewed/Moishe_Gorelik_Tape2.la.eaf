		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts318">
				<ANNOTATION_VALUE>di pushkes undzere zaynen geven, m&lt;'iz,&gt; do iz geven eyn pushke un eyn traktor.</ANNOTATION_VALUE>
