		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts630">
				<ANNOTATION_VALUE>mir hobn zey dortn o a khoydesh tsayt gelernt, gelernt</ANNOTATION_VALUE>
