		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts388">
				<ANNOTATION_VALUE>do hot men shoyn gebrakht fun dortn, fun GOMEL', avu s'iz geven undzer CHAST'</ANNOTATION_VALUE>
