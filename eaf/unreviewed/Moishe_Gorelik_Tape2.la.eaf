		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts312">
				<ANNOTATION_VALUE>oyf morgn, dray a zeyger UNK gekumen, hot zikh ongehoybn di milkhome.</ANNOTATION_VALUE>
