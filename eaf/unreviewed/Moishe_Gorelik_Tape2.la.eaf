		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts678">
				<ANNOTATION_VALUE>SKORAYA POMOSHCH', &lt;f-&gt; oyf &lt;g- fo-&gt; vos fort un shrayt</ANNOTATION_VALUE>
