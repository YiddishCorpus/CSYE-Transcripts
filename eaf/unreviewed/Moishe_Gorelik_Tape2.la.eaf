		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts676">
				<ANNOTATION_VALUE>azoy vi gikhe,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
