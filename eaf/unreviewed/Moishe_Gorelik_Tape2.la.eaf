			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts276">
				<ANNOTATION_VALUE>nit visn vos... er hot &lt;geb-&gt; gebrakht tsu firn</ANNOTATION_VALUE>
