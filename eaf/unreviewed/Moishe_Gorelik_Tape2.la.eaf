		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts352">
				<ANNOTATION_VALUE>iz flegn onflien MESSER- MESSERSCHMITTn azoy vi flign,</ANNOTATION_VALUE>
