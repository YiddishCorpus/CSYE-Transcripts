		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1145" TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts624">
				<ANNOTATION_VALUE>opgeshikt in an ander teyl.</ANNOTATION_VALUE>
