		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts386">
				<ANNOTATION_VALUE>zaynen mir derforn bi&lt;z Zh&gt;lobin.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
