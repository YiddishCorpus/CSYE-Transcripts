		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts638">
				<ANNOTATION_VALUE>mir iz geven, uh, dan tsvantsik eynter yor iz avek.</ANNOTATION_VALUE>
