		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts384">
				<ANNOTATION_VALUE>hot men geheysn vayter forn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
