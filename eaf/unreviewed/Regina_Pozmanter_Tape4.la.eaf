		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts150">
				<ANNOTATION_VALUE>&lt;hob&gt;, dos hot geheyst di repartiantn. </ANNOTATION_VALUE>
