		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts864" TIME_SLOT_REF2="ts866">
				<ANNOTATION_VALUE>UNK in lager hot men undz gegebn hering oykhet,</ANNOTATION_VALUE>
