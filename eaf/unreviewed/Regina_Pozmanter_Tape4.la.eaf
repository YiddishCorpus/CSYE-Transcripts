			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts156">
				<ANNOTATION_VALUE>un als repartrantkin bin ikh geforn azoy &lt;az s'hot mikh&gt; gornisht gekost</ANNOTATION_VALUE>
