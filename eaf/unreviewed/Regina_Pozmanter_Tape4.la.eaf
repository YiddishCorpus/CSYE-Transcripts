		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts403">
				<ANNOTATION_VALUE>un shoyn nakher tsu UNK avade far UNK</ANNOTATION_VALUE>
