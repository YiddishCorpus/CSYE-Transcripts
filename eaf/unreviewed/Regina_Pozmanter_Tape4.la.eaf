			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts872">
				<ANNOTATION_VALUE>un &lt;demolt&gt; hob ikh gekokht hob ikh di floymen gekokht oyf di bar-mitsve mit di bulkelekh, mit der hering</ANNOTATION_VALUE>
