			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts881" TIME_SLOT_REF2="ts882">
				<ANNOTATION_VALUE>ikh hob im, kh'veys nisht fun vanen ikh hob</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
