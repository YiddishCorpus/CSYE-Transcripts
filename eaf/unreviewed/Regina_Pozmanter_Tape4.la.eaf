			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1080" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts164">
				<ANNOTATION_VALUE>hot dokh gornisht gekost, ikh bin geforn.</ANNOTATION_VALUE>
