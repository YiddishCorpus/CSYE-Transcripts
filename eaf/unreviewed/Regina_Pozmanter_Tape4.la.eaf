			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts168">
				<ANNOTATION_VALUE>vegn ikh hob di kinder iber&lt;UNK&gt; bay mayn shvoger. mayn shvoger hot dort khasene gehat, di ershte froy</ANNOTATION_VALUE>
