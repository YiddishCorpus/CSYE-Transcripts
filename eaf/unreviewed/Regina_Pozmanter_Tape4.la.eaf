		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts148">
				<ANNOTATION_VALUE>hobn zey gehat dos rekht tsu forn, es hot gornisht gekost.</ANNOTATION_VALUE>
