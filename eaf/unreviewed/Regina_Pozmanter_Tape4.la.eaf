		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts396">
				<ANNOTATION_VALUE>un ikh, un ikh hob geshikt in politsey, me hot geshikt politsey, me hot zey</ANNOTATION_VALUE>
