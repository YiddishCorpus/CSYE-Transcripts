		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts152">
				<ANNOTATION_VALUE>hob ikh zikh demolt oykh</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
