		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts432">
				<ANNOTATION_VALUE>ikh vel im nisht iberlozn bay keyn kristn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
