		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1111" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts428">
				<ANNOTATION_VALUE>un s'ken zayn az s'iz nisht mayn shvester's a kind.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
