		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts438">
				<ANNOTATION_VALUE>me hot gegebn gelt, zikher hot men gegebn gelt.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
