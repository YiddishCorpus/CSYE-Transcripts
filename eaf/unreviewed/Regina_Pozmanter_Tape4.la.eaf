		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1108" TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts409">
				<ANNOTATION_VALUE>az zi iz shoyn, zi hot dokh nisht gevolt geyn, UNK &lt;zogt&gt; zi vet nisht geyn.</ANNOTATION_VALUE>
