		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts887" TIME_SLOT_REF2="ts888">
				<ANNOTATION_VALUE>mit UNK dos tfiln-zekele halt er azoy vi a, er vet es aykh vayzn az &lt;er&gt; vet dort zayn.</ANNOTATION_VALUE>
