			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts434">
				<ANNOTATION_VALUE>me muz im aroysnemen.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
