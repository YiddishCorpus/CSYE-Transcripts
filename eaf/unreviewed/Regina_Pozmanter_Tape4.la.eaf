			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts142">
				<ANNOTATION_VALUE>haynt nokh Poyln tsu forn, s'iz geven zeyer nisht gut tsu forn nokh Poyln.</ANNOTATION_VALUE>
