		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts876">
				<ANNOTATION_VALUE>az der rebe hot gezogt</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
