		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a51" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts144">
				<ANNOTATION_VALUE>ober eh s'iz nokh geven in Poyln in Daytshland iz geven</ANNOTATION_VALUE>
