		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts146">
				<ANNOTATION_VALUE>geblibene, di Polyakn vos zenen geven oyf arbet,</ANNOTATION_VALUE>
