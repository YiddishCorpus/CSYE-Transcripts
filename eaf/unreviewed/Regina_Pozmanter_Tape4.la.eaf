			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1114" TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts450">
				<ANNOTATION_VALUE>iz geven ayngehoykert, aynge- dos ober ikh hob dos ponem derkent.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
