		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1168" TIME_SLOT_REF1="ts863" TIME_SLOT_REF2="ts865">
				<ANNOTATION_VALUE>hering tsuzamengeshlept, kh'veys nisht fun vu</ANNOTATION_VALUE>
