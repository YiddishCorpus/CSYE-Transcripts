		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts425" TIME_SLOT_REF2="ts426">
				<ANNOTATION_VALUE>s'kon zayn az s'iz mayn shvester's a kind</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
