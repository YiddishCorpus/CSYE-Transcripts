		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts886">
				<ANNOTATION_VALUE>ikh hob im gemakht a tfiln &lt;bay&gt; a zekele</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
