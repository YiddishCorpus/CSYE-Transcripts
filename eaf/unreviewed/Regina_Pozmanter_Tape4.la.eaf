		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts873" TIME_SLOT_REF2="ts874">
				<ANNOTATION_VALUE>se fregt zhe gornisht vos far a bar-mitsve dos iz geven.</ANNOTATION_VALUE>
