			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts440">
				<ANNOTATION_VALUE>ikh hob farkoyft epes vi mayn hoyz, hob ikh gehat a bisl gelt.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
