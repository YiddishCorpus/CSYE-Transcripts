		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts424">
				<ANNOTATION_VALUE>un az ikh bin dergangen tsu dem ort, tsu der kind...</ANNOTATION_VALUE>
