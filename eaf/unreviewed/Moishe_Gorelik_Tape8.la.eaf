		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts488">
				<ANNOTATION_VALUE>instinktiv." zogt er, "host nit gezen in Horlovke vos hobn zey geton mit kinder,</ANNOTATION_VALUE>
