		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts448">
				<ANNOTATION_VALUE>di tsvey vakh-manes.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
