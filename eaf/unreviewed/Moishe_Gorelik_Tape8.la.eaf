		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts418">
				<ANNOTATION_VALUE>keseyder trakht ikh, "v- tsulib vos hot, hob ikh dos geton? ikh hob &lt;dokh&gt; geton rikhtik, tsi nit?"</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
