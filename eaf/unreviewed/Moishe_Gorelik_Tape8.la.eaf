			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts450">
				<ANNOTATION_VALUE>es iz ongegangen, ongelo- -gegangen a, a, a vaybl a NEMKe</ANNOTATION_VALUE>
