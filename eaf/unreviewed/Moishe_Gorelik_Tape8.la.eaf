		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts420">
				<ANNOTATION_VALUE>nor instinktiv bin ikh avek, instinktiv.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
