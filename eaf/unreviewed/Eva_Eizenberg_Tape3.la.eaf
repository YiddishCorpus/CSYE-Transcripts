		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a15" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
				<ANNOTATION_VALUE>eh m'hot undz gesh- vayter. m'hot tsunam- tsuzamengenumen a s- mer mentshn, vayl</ANNOTATION_VALUE>
