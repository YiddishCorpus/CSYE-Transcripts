			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts446">
				<ANNOTATION_VALUE>hot mikh ongeboygn oyf a taburet, ikh zol zikh eh, mit di hent zol ikh zikh</ANNOTATION_VALUE>
