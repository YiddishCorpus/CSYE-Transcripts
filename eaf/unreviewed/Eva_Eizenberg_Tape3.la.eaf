		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a17" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
				<ANNOTATION_VALUE>iz vos a mol ver veyniker, in, in MOGILEV</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
