			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a16" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
				<ANNOTATION_VALUE>eh me falt un me shist un me harget un me shlogt</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
