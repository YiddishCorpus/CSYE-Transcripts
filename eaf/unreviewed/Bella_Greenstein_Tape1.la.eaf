		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1044" TIME_SLOT_REF1="ts993" TIME_SLOT_REF2="ts994">
				<ANNOTATION_VALUE>un yeder yontev iz geven a yontev, rosheshone iz geven a yontev,</ANNOTATION_VALUE>
