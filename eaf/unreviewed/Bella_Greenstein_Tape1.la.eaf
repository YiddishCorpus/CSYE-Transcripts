				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1216" TIME_SLOT_REF1="ts1023" TIME_SLOT_REF2="ts1024">
				<ANNOTATION_VALUE>un azoy nor di kinder shpiln zikh un me git zey.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1217" TIME_SLOT_REF1="ts1025" TIME_SLOT_REF2="ts1027">
				<ANNOTATION_VALUE>un s'iz geven genug plats far alemen.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1051" TIME_SLOT_REF1="ts1026" TIME_SLOT_REF2="ts1028">
				<ANNOTATION_VALUE>un yedn yontev, khanike un dem iz geven a yontev, oykhet in shule.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1052" TIME_SLOT_REF1="ts1029" TIME_SLOT_REF2="ts1033">
				<ANNOTATION_VALUE>in shule, afile in der yidisher shule.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1219" TIME_SLOT_REF1="ts1034" TIME_SLOT_REF2="ts1036">
				<ANNOTATION_VALUE>hot men yedn yontev gemakht yontev.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
