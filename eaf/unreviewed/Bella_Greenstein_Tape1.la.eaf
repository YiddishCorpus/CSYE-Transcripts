			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a936" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts631">
				<ANNOTATION_VALUE>di kinder</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
