			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1208" TIME_SLOT_REF1="ts989" TIME_SLOT_REF2="ts990">
				<ANNOTATION_VALUE>der tate iz gegangen in shul ober er flegt kumen in shtub. </ANNOTATION_VALUE>
