		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1207" TIME_SLOT_REF1="ts987" TIME_SLOT_REF2="ts988">
				<ANNOTATION_VALUE>oyf azoy vayt.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
