			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1041" TIME_SLOT_REF1="ts981" TIME_SLOT_REF2="ts982">
				<ANNOTATION_VALUE>kedey di shkheynim zoln nisht zogn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
