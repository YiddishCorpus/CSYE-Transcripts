		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a939" TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts639">
				<ANNOTATION_VALUE>fun di, fun di kinder</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
