		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a937" TIME_SLOT_REF1="ts634" TIME_SLOT_REF2="ts636">
				<ANNOTATION_VALUE>Skif dos, der kh- &lt;snif&gt;</ANNOTATION_VALUE>
