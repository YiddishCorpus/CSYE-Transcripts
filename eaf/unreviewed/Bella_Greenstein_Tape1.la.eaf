			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1040" TIME_SLOT_REF1="ts978" TIME_SLOT_REF2="ts980">
				<ANNOTATION_VALUE>un nisht gegesn, gefast a gantsn tog.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
