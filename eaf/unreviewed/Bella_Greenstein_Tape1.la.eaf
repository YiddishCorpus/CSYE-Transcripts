		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1042" TIME_SLOT_REF1="ts991" TIME_SLOT_REF2="ts992">
				<ANNOTATION_VALUE>nisht esn nor trinken epes. </ANNOTATION_VALUE>
