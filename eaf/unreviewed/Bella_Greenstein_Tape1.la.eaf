		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1053" TIME_SLOT_REF1="ts1037" TIME_SLOT_REF2="ts1038">
				<ANNOTATION_VALUE>un m'iz gegangen un m'iz, vayl mir flegn zeyer mekane zayn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1220" TIME_SLOT_REF1="ts1039" TIME_SLOT_REF2="ts1040">
				<ANNOTATION_VALUE>di poylishe kinder</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1221" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1042">
				<ANNOTATION_VALUE>vos zenen gegangen in di shvartse rekelekh mit vayse bluzkelekh TRZECIEGO MAJA,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1222" TIME_SLOT_REF1="ts1043" TIME_SLOT_REF2="ts1045">
				<ANNOTATION_VALUE>dem dritn may,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1054" TIME_SLOT_REF1="ts1044" TIME_SLOT_REF2="ts1046">
				<ANNOTATION_VALUE>dos iz geven a groyser poylisher yontev ven Poyln iz gevorn zelbshtendik.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1055" TIME_SLOT_REF1="ts1047" TIME_SLOT_REF2="ts1048">
				<ANNOTATION_VALUE>un dan zenen zey gegangen mit poylishe fener</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1251" TIME_SLOT_REF1="ts1049" TIME_SLOT_REF2="ts1051">
				<ANNOTATION_VALUE>un zey hobn zikh gefreyt un mir flegn, ikh fleg kumen, fleg ikh zogn "mame, un ven veln mir zikh freyen?"</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1223" TIME_SLOT_REF1="ts1050" TIME_SLOT_REF2="ts1052">
				<ANNOTATION_VALUE>zogt zi "mir'n zikh freyen dem ershtn may".</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1056" TIME_SLOT_REF1="ts1053" TIME_SLOT_REF2="ts1055">
				<ANNOTATION_VALUE>vos &lt;ken do&gt; zayn?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1057" TIME_SLOT_REF1="ts1056" TIME_SLOT_REF2="ts1061">
				<ANNOTATION_VALUE>neyn, neyn, neyn. mir zenen geshtanen in zayt un gekukt UNK.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1224" TIME_SLOT_REF1="ts1062" TIME_SLOT_REF2="ts1063">
				<ANNOTATION_VALUE>LO, LO, neyn, neyn, neyn, neyn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1059" TIME_SLOT_REF1="ts1064" TIME_SLOT_REF2="ts1066">
				<ANNOTATION_VALUE>di vos hobn gevolt lebn, hobn mir gevolt lebn mit undzer eh</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1060" TIME_SLOT_REF1="ts1067" TIME_SLOT_REF2="ts1071">
				<ANNOTATION_VALUE>als, als yidn, nisht als Polyakn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1061" TIME_SLOT_REF1="ts1072" TIME_SLOT_REF2="ts1074">
				<ANNOTATION_VALUE>keyner. m'iz nisht geven frum ober keyner hot nisht gevolt vern keyn Polyak,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1226" TIME_SLOT_REF1="ts1075" TIME_SLOT_REF2="ts1078">
				<ANNOTATION_VALUE>un nisht keyn goy. zeltn ver fun shtetl</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1062" TIME_SLOT_REF1="ts1079" TIME_SLOT_REF2="ts1080">
				<ANNOTATION_VALUE>iz geven eyn froy vos hot khasene gehat mit a krist</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1063" TIME_SLOT_REF1="ts1081" TIME_SLOT_REF2="ts1082">
				<ANNOTATION_VALUE>un zi hot zikh gevolt,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1227" TIME_SLOT_REF1="ts1083" TIME_SLOT_REF2="ts1084">
				<ANNOTATION_VALUE>m'hot gezogt az zi vil zikh shmadn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1228" TIME_SLOT_REF1="ts1085" TIME_SLOT_REF2="ts1087">
				<ANNOTATION_VALUE>azoy iz &lt;akhuts ir&gt; nisht geven keyn eyner, me hot khasene gehat.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1064" TIME_SLOT_REF1="ts1086" TIME_SLOT_REF2="ts1088">
				<ANNOTATION_VALUE>&lt;tsu&gt; mit poylishe yidn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1065" TIME_SLOT_REF1="ts1089" TIME_SLOT_REF2="ts1090">
				<ANNOTATION_VALUE>me hot geredt a shidekh mit a yid fun Lodzh oder mit oder fun Rusland, oder fun</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1066" TIME_SLOT_REF1="ts1091" TIME_SLOT_REF2="ts1092">
				<ANNOTATION_VALUE>fun ergets vu</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1067" TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1094">
				<ANNOTATION_VALUE>ober keyner hot nisht khasene gehat kimat mit keyn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1229" TIME_SLOT_REF1="ts1095" TIME_SLOT_REF2="ts1096">
				<ANNOTATION_VALUE>eyne eyntsike froy vos iz arayn in KLOSZ- eh in KLASZTOR</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1230" TIME_SLOT_REF1="ts1097" TIME_SLOT_REF2="ts1098">
				<ANNOTATION_VALUE>iz gevezn, vos der tate iz geven zeyer a frumer</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1231" TIME_SLOT_REF1="ts1099" TIME_SLOT_REF2="ts1100">
				<ANNOTATION_VALUE>un er hot ir dervaytert fun zikh.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1068" TIME_SLOT_REF1="ts1101" TIME_SLOT_REF2="ts1104">
				<ANNOTATION_VALUE>vayl z'iz gegangen mit a goy, un zi iz demolt avek tsu di goyim.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1232" TIME_SLOT_REF1="ts1105" TIME_SLOT_REF2="ts1106">
				<ANNOTATION_VALUE>azoy iz keyner nisht geven in Krinik.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1069" TIME_SLOT_REF1="ts1107" TIME_SLOT_REF2="ts1108">
				<ANNOTATION_VALUE>un azoy i- UNK</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1070" TIME_SLOT_REF1="ts1109" TIME_SLOT_REF2="ts1110">
				<ANNOTATION_VALUE>azoy zenen mir arum in &lt;t- k-&gt; eh zenen mir gekumen der BET-HAKNESET.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1233" TIME_SLOT_REF1="ts1111" TIME_SLOT_REF2="ts1112">
				<ANNOTATION_VALUE>s'iz gevezn BET-HANKESET un nakher &lt;iz&gt; geven shtiblekh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1234" TIME_SLOT_REF1="ts1113" TIME_SLOT_REF2="ts1114">
				<ANNOTATION_VALUE>vos in di shtiblekh flegn zitsn di mentshn vos davnen a gants yor.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1235" TIME_SLOT_REF1="ts1115" TIME_SLOT_REF2="ts1116">
				<ANNOTATION_VALUE>in shul iz gevezn zeyer sheyn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1236" TIME_SLOT_REF1="ts1117" TIME_SLOT_REF2="ts1119">
				<ANNOTATION_VALUE>un m'hot ongetsundn ale likht</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1071" TIME_SLOT_REF1="ts1118" TIME_SLOT_REF2="ts1120">
				<ANNOTATION_VALUE>un in shul iz geven ful rosheshone, yom-kiper</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1072" TIME_SLOT_REF1="ts1121" TIME_SLOT_REF2="ts1122">
				<ANNOTATION_VALUE>di tsaytn, afile mir als bundistn, mir zenen nisht geven keyn kegner fun fun yom-toyvim.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1073" TIME_SLOT_REF1="ts1123" TIME_SLOT_REF2="ts1124">
				<ANNOTATION_VALUE>mir zenen nisht gevezn frum ober fun kegner fun dem zenen mir nisht gevezn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1074" TIME_SLOT_REF1="ts1125" TIME_SLOT_REF2="ts1126">
				<ANNOTATION_VALUE>un azoy zenen mir</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1237" TIME_SLOT_REF1="ts1127" TIME_SLOT_REF2="ts1128">
				<ANNOTATION_VALUE>bin ikh ongekumen biz ikh bin alt gevorn zekhtsn yor</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1075" TIME_SLOT_REF1="ts1129" TIME_SLOT_REF2="ts1130">
				<ANNOTATION_VALUE>un me darf, muz trakhtn a tsukunft.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1076" TIME_SLOT_REF1="ts1131" TIME_SLOT_REF2="ts1132">
				<ANNOTATION_VALUE>un ikh bin avekgeforn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1238" TIME_SLOT_REF1="ts1133" TIME_SLOT_REF2="ts1134">
				<ANNOTATION_VALUE>ikh hob gegat tsvey gute khavertes, Rokhl un MIKHLE,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1239" TIME_SLOT_REF1="ts1135" TIME_SLOT_REF2="ts1136">
				<ANNOTATION_VALUE>vos mir hobn ale dray gedarft zayn in Vilne, in, in Vilne.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1240" TIME_SLOT_REF1="ts1137" TIME_SLOT_REF2="ts1138">
				<ANNOTATION_VALUE>un layder nisht, zey zenen geblibn in Krinik</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
