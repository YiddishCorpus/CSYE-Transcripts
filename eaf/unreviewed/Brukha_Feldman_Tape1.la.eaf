		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a35" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
				<ANNOTATION_VALUE>iz di NEMTSes gelofn, nokhgelofn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
