				<ANNOTATION_VALUE>NO UNK EY VNUKI, DA.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts1086" TIME_SLOT_REF2="ts1089">
				<ANNOTATION_VALUE>nu, KOGDA YA, ikh hob gearbet oyf der fabrike,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts1090" TIME_SLOT_REF2="ts1092">
				<ANNOTATION_VALUE>iz, iz... kh'hob gearbet oyf der fabrike,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1094">
				<ANNOTATION_VALUE>iz hot gearbet a sakh yidn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts1095" TIME_SLOT_REF2="ts1096">
				<ANNOTATION_VALUE>nu, mir flegn a mol redn oyf yidish, a mol flegn mir redn oyf goyish,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts1097" TIME_SLOT_REF2="ts1098">
				<ANNOTATION_VALUE>nor keyner fleg undz gornit zogn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts1099" TIME_SLOT_REF2="ts1100">
				<ANNOTATION_VALUE>nor ikh hob gearbet oyf der fabrike. azoy ikh bin geven a yidishke,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts1101" TIME_SLOT_REF2="ts1102">
				<ANNOTATION_VALUE>hot men zikh tsu mir OBRASHCHAet gut.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts1103" TIME_SLOT_REF2="ts1104">
				<ANNOTATION_VALUE>s'hot zikh gearbet dortn goyim.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts1105" TIME_SLOT_REF2="ts1106">
				<ANNOTATION_VALUE>iz a direktor a go- uh, geven Fishkes. er iz geven a yid.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts1107" TIME_SLOT_REF2="ts1108">
				<ANNOTATION_VALUE>nu, iz bin ikh farshlaft gevorn, iz bin ikh gelign in BOL'NITSe, fleg Fride kumen mit im un flegn mir sh- shikn PEREDACHes. m'hot zikh shtark gut OTNOSet tsu mir.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts1109" TIME_SLOT_REF2="ts1110">
				<ANNOTATION_VALUE>fun finef un draysik yor vos ikh hob opgearbet,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts1111" TIME_SLOT_REF2="ts1112">
				<ANNOTATION_VALUE>hob ikh zikh nit vos tsu OBIZHAen oyf der fabrike.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts1113" TIME_SLOT_REF2="ts1114">
				<ANNOTATION_VALUE>uh, yeder iz gegangen mir NAVSTRECHe.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts1115" TIME_SLOT_REF2="ts1116">
				<ANNOTATION_VALUE>dortn arbet a goy KAPLICHNYY,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts1117" TIME_SLOT_REF2="ts1118">
				<ANNOTATION_VALUE>iz, uh, mayne kinder hot er gegebn in PIONERSKe lager tsvey mol</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts1119" TIME_SLOT_REF2="ts1120">
				<ANNOTATION_VALUE>tsu BESPLATNe PUTЁVKes.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts1121" TIME_SLOT_REF2="ts1122">
				<ANNOTATION_VALUE>un mir fleg men gebn POMOSHCH'.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts1123" TIME_SLOT_REF2="ts1124">
				<ANNOTATION_VALUE>uh, me, m'hot shtark mikh ZHALEet.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts1125" TIME_SLOT_REF2="ts1126">
				<ANNOTATION_VALUE>zey hobn gevust az ikh mutshe zikh mit a mame a shlafe...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts1127" TIME_SLOT_REF2="ts1128">
				<ANNOTATION_VALUE>uh, di mame iz geven shlaf un zi hot zikh gemutshet mit mir... nor zey hobn mikh nit OBIZHAet</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts1129" TIME_SLOT_REF2="ts1130">
				<ANNOTATION_VALUE>oyf der fabrike.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts1131" TIME_SLOT_REF2="ts1132">
				<ANNOTATION_VALUE>vos ken ikh zogn? kh'hob opgearbet finef un draysik yor UNK BOL'SHINSTVO goyim,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts1133" TIME_SLOT_REF2="ts1134">
				<ANNOTATION_VALUE>nor zey hobn mikh nit OBIZHAet.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts1136" TIME_SLOT_REF2="ts1139">
				<ANNOTATION_VALUE>ETO KON- avade. avade.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts1140" TIME_SLOT_REF2="ts1143">
				<ANNOTATION_VALUE>ven ikh bin geku-...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts1144" TIME_SLOT_REF2="ts1147">
				<ANNOTATION_VALUE>a. ven ikh bin gekumen arbetn in, uh, MEBEL'Ne...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts1149" TIME_SLOT_REF2="ts1151">
				<ANNOTATION_VALUE>di fabrike?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts1152" TIME_SLOT_REF2="ts1154">
				<ANNOTATION_VALUE>NU, LYUDI, RABOTALI EVREI,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1132" TIME_SLOT_REF1="ts1155" TIME_SLOT_REF2="ts1156">
				<ANNOTATION_VALUE>un s'hot gearbet, uh, yidn un s'hot gearbet goyim.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1133" TIME_SLOT_REF1="ts1157" TIME_SLOT_REF2="ts1159">
				<ANNOTATION_VALUE>az ikh bin gekumen oyf der fabrike,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts1158" TIME_SLOT_REF2="ts1160">
				<ANNOTATION_VALUE>nu, bin ikh gekumen &lt;zikh, oykh&gt; geven a kind nokh.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1134" TIME_SLOT_REF1="ts1161" TIME_SLOT_REF2="ts1162">
				<ANNOTATION_VALUE>kh'hob opgearbet dortn akht yor un dernokh dem bin ikh gekumen oyf der fabrike. hot gearbet AVERBUKH DIREKTOROM.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts1163" TIME_SLOT_REF2="ts1164">
				<ANNOTATION_VALUE>zog ikh, "nu, ikh, uh," KHOTYA vos &lt;er iz&gt; geven a yid, bin ikh arayngegangen, zog ikh, "ikh vil geyn arbetn."</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts1165" TIME_SLOT_REF2="ts1166">
				<ANNOTATION_VALUE>zogt er tsu mir,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts1167" TIME_SLOT_REF2="ts1168">
				<ANNOTATION_VALUE>"vos du vest kenen arbetn iz dokh a shvere arbet."</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts1169" TIME_SLOT_REF2="ts1170">
				<ANNOTATION_VALUE>zog ikh, "nu, vu &lt;zhe vet ir&gt; mikh avekshteln?" zogt er, "kh'vel dikh avekshteln in droysn arbetn."</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts1171" TIME_SLOT_REF2="ts1172">
				<ANNOTATION_VALUE>zog ikh, "shtelt mikh avek in droysn oyf der SHTABELЁVKe." s'iz geven a SHTABELЁVKe, vos me SHTABELYUet di detaln.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts1173" TIME_SLOT_REF2="ts1174">
				<ANNOTATION_VALUE>hot er mikh avekgeshtelt oyf der SHTABELЁVKe un ikh hob gearbet oyf der SHTABELЁVKe dray yor, un s'iz geven vinter un s'iz geven &lt;k-&gt; zumer.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1135" TIME_SLOT_REF1="ts1175" TIME_SLOT_REF2="ts1176">
				<ANNOTATION_VALUE>vinter &lt;iz mir&gt; geven kalt, nor kh'hob zikh ongeton, un azoy hob ikh opgearbet.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts1177" TIME_SLOT_REF2="ts1178">
				<ANNOTATION_VALUE>dernokh dem bin ikh gekumen tsu im. zog ikh, "nu, &lt;s'iz, s'iz&gt; do oyf der SUSHARKe arbet, vel ikh geyn oyf mayn arbet."</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts1179" TIME_SLOT_REF2="ts1180">
				<ANNOTATION_VALUE>zogt er tsu mir, "neyn, du arbetst gut," zogt er, "vest shoyn iber&lt;layb-&gt; arbetn bay mir. gey in tsekh!"</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1136" TIME_SLOT_REF1="ts1181" TIME_SLOT_REF2="ts1182">
				<ANNOTATION_VALUE>bin ikh arayngegangen in tsekh un kh'hob gearbet in tsekh un, biz van&lt;UNK&gt; biz in der pensye.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts1184" TIME_SLOT_REF2="ts1186">
				<ANNOTATION_VALUE>az, az ikh bin avekgegangen &lt;tsu&gt; der pensye arbetn, uh, ikh hob avekgegangen fun der pensye, hot men mikh oykhet BLAGODARet un m'hot mir gegebn, uh, gelt,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts1187" TIME_SLOT_REF2="ts1188">
				<ANNOTATION_VALUE>un ikh veys, VSЁ.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts1190" TIME_SLOT_REF2="ts1192">
				<ANNOTATION_VALUE>I TAK PROSHLO, geven TRIDTSAT' PYAT' LET, yo, finef un draysik yor.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts1193" TIME_SLOT_REF2="ts1194">
				<ANNOTATION_VALUE>azoy vi ersht nit lang.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts1196" TIME_SLOT_REF2="ts1198">
				<ANNOTATION_VALUE>POZHALUYSTA.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
