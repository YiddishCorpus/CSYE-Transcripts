		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a43" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts125">
				<ANNOTATION_VALUE>iz di shvester, zi iz farshlaft gevorn, iz zi geshtorbn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts128">
				<ANNOTATION_VALUE>uh, DA, &lt;in, uh, dem&gt; GOLOD.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts130">
				<ANNOTATION_VALUE>un dernokh dem, di, di shvester vos zi voynt in IZRAILe,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
