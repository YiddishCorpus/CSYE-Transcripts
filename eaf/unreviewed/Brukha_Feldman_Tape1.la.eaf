		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
				<ANNOTATION_VALUE>iz zi avekgeforn in Tshernevits,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
