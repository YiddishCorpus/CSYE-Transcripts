		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a18" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
				<ANNOTATION_VALUE>zi iz gevorn blind, di mame, un ikh hob zikh gemutshet mit ir.</ANNOTATION_VALUE>
