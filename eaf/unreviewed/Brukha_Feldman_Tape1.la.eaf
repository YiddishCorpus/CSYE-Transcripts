			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a26" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts87">
				<ANNOTATION_VALUE>a. nu, OT, OT VOENN&lt;OGO&gt; VREMENI gedenk ikh</ANNOTATION_VALUE>
