		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1066" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
				<ANNOTATION_VALUE>&lt;CHTO,&gt; "kuk tsu Brukhen,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
