			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts1068" TIME_SLOT_REF2="ts1071">
				<ANNOTATION_VALUE>I MOI, &lt;hm,&gt; DA, VNUKI. NU, VNUKI, NE, VNUKI ETO MOI UZHE.</ANNOTATION_VALUE>
