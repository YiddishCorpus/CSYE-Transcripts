		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
				<ANNOTATION_VALUE>vayl zi hot &lt;ts-&gt; lib tsu loyfn oyfn veg."</ANNOTATION_VALUE>
