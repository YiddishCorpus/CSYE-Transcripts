			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1241" TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts530">
				<ANNOTATION_VALUE>mitn kop fun dem UNK, uh, komendant,</ANNOTATION_VALUE>
