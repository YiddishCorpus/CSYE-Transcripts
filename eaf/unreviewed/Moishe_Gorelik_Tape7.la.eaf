		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts264">
				<ANNOTATION_VALUE>un oyf der heykh flegn mir avekleygn, uh, dortn o di shteyner di fanandergeklapte</ANNOTATION_VALUE>
