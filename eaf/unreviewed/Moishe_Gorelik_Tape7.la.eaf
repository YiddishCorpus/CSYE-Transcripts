		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
				<ANNOTATION_VALUE>dos heyst, zey hobn gekhoyzekt; zey hobn im gemalt.</ANNOTATION_VALUE>
