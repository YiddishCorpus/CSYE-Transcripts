			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts374">
				<ANNOTATION_VALUE>a freyd. a shvere arbet:</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
