		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts266">
				<ANNOTATION_VALUE>un tsutrogn tsu der mashin velkhe klapt fanander oyf, uh, kleyne shteyndlekh.</ANNOTATION_VALUE>
