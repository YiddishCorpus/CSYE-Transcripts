		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts474">
				<ANNOTATION_VALUE>s'iz geven a zuntik, zuntik nokh mitog, un</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts476">
				<ANNOTATION_VALUE>ikh bin, ven di daytsher zenen arayngekumen, un eh ikh bin aheymgekumen hob ikh es fartseylt mayne eltern, zenen zeyer troyerik gevorn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
