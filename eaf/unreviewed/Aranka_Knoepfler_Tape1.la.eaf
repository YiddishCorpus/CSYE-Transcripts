		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts467" TIME_SLOT_REF2="ts468">
				<ANNOTATION_VALUE>a zikher hot men gevust, s'iz shreklekh geven.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
