			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts536" TIME_SLOT_REF2="ts539">
				<ANNOTATION_VALUE>ikh ikh meyn az nokh peysekh oder for peysekh, s- ikh gedenk nisht ekht genoy.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts538" TIME_SLOT_REF2="ts540">
