		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts472">
				<ANNOTATION_VALUE>un eh mayne eltern hobn nisht gevust keyn radyo, keyn gornisht eh.</ANNOTATION_VALUE>
