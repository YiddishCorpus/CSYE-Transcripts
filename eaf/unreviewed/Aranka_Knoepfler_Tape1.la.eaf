		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts470">
				<ANNOTATION_VALUE>ikh bin in Budapest geven un o s'shreklekh geven.</ANNOTATION_VALUE>
