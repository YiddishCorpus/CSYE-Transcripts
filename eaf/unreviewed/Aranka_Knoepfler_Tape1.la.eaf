		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts568">
				<ANNOTATION_VALUE>yo.</ANNOTATION_VALUE>
