		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts479">
				<ANNOTATION_VALUE>hob ikh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts482">
				<ANNOTATION_VALUE>yo zikher, ikh bin dort geven, ikh hob zey gezen ven di Firer's soldatn vi zey zenen gekumen.</ANNOTATION_VALUE>
