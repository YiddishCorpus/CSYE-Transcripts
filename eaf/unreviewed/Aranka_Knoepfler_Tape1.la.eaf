			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a915" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts388">
				<ANNOTATION_VALUE>ehm eh biz nayntsn fir un fertsik hot ir gekent normal lebn?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a916" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts393">
				<ANNOTATION_VALUE>vos iz geshen, ve- ir gedenkt ven di daytshn zenen arayngekumen nayntsn fir un fertsik?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a917" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts424">
				<ANNOTATION_VALUE>vos hot men gev -gevolt fun aykh vos ir zol im zogn?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a918" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts431">
				<ANNOTATION_VALUE>der iz ayngeshpart der mentsh? oder v- vo- vos iz?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a921" TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts441">
				<ANNOTATION_VALUE>un nokh dem zent ir gegangen keyn Budapest?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a923" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts453">
				<ANNOTATION_VALUE>mit vos a min solda-</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a924" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts457">
				<ANNOTATION_VALUE>ungarishe oder daytshe soldatn?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a925" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts466">
				<ANNOTATION_VALUE>ir hot gevust, eh tsvishn di yidn hot men gevust vos dos badoytet az di daytshn kumen?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a927" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts481">
				<ANNOTATION_VALUE>ir hot gehert in Budapest az di daytshn zenen arayngekumen?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a928" TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts484">
				<ANNOTATION_VALUE>un ven zey zenen arayngekumen bay aykh in dorf?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a929" TIME_SLOT_REF1="ts499" TIME_SLOT_REF2="ts501">
				<ANNOTATION_VALUE>ober, a moshl far far fir un fertsik, di yidn hobn gevust, di yidn in ayer dorf hobn shoyn gevust vos m'makht mit yidn? fun di deportatsyes hot men gehat gehert shoyn epes?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a930" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts519">
				<ANNOTATION_VALUE>azoy eh ven, ir veyst nokh in velkhn tog di daytshn zenen arayngekumen bay aykh in dorf, ikh meyn emesdik?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a931" TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts522">
				<ANNOTATION_VALUE>un vos iz geshen dan?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a934" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts529">
				<ANNOTATION_VALUE>eh ven hot men der, hot men gemakht nokh dem a geto in eh</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a935" TIME_SLOT_REF1="ts530" TIME_SLOT_REF2="ts532">
				<ANNOTATION_VALUE>ayer dorf?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a936" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts537">
				<ANNOTATION_VALUE>ven hot dos ongehoybn, veyst ir dos nokh?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a938" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts542">
				<ANNOTATION_VALUE>vi azoy hot men gemakht dem geto?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a939" TIME_SLOT_REF1="ts543" TIME_SLOT_REF2="ts544">
				<ANNOTATION_VALUE>ikh meyn v- vi hot men bashlosn vu der geto iz?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a941" TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts555">
				<ANNOTATION_VALUE>ayer hoyz iz nisht arayngefaln in der geto gegnt?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a942" TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts559">
				<ANNOTATION_VALUE>hot ir gemuzt aroysgeyn fun ayer hoyz.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a943" TIME_SLOT_REF1="ts561" TIME_SLOT_REF2="ts562">
				<ANNOTATION_VALUE>un dan vu hot ir gevoynt in geto?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a944" TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts567">
				<ANNOTATION_VALUE>s'geven merere mishpokhes tsuzamen, oder?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a945" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts572">
				<ANNOTATION_VALUE>vifl mentshn hot men gevoynt in eyn shtub?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a946" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts578">
				<ANNOTATION_VALUE>a shtub, dos heyst eyn tsimer?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a947" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts596">
				<ANNOTATION_VALUE>OK, e'mir makhn a kleyne pauze, vayl m'darf toyshn.</ANNOTATION_VALUE>
