		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts584">
				<ANNOTATION_VALUE>m'hot gekokht, eh keyn fleysh hot men nisht gehat.</ANNOTATION_VALUE>
