			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts576">
				<ANNOTATION_VALUE>dos iz nisht a sakh geven.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
