		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts555">
				<ANNOTATION_VALUE>nor di yidn zen-...</ANNOTATION_VALUE>
