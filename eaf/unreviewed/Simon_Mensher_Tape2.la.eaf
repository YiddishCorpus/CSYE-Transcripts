		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts444">
				<ANNOTATION_VALUE>nor er hot shtark, der foter fun, uh, mayn shvoger hot &lt;sh&gt;tark lib gehat mayn shvester.</ANNOTATION_VALUE>
