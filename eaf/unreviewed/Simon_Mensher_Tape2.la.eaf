		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts524">
				<ANNOTATION_VALUE>er hot gehat a shtarke hant.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
