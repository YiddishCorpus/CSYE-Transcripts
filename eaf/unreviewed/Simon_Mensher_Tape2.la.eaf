		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts525" TIME_SLOT_REF2="ts526">
				<ANNOTATION_VALUE>bikhlal iz er a mol geven a sotsyalist un hot aroysgegebn a sotsyalistishe tsaytung,</ANNOTATION_VALUE>
