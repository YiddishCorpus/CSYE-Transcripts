			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts540">
				<ANNOTATION_VALUE>hot er avekgevarfn, avekgevorfn di melukhe</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
