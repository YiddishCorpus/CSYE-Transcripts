		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts512">
				<ANNOTATION_VALUE>in poylisher armey, avade. in artilerye hob ikh gedint.</ANNOTATION_VALUE>
