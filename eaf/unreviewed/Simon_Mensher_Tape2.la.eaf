		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts452">
				<ANNOTATION_VALUE>un ho'mir bashlosn az me ken farkoyfn fir yokh feld,</ANNOTATION_VALUE>
