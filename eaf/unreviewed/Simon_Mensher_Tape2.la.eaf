			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts536">
				<ANNOTATION_VALUE>in nayntsn zeks un tsvontsik hot er frish gemakht a putsh.</ANNOTATION_VALUE>
