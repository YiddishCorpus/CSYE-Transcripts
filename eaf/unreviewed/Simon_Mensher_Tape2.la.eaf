			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts578">
				<ANNOTATION_VALUE>yidn flegn geyn akht, nayn monat far dem vos m'hot badarft geyn in der armey,</ANNOTATION_VALUE>
