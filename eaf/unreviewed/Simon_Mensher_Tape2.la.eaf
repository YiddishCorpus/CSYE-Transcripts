		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts530">
				<ANNOTATION_VALUE>a guter diktator. er hot ayngefirt a groyse distsiplin,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
