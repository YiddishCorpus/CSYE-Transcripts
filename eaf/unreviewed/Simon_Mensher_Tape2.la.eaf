			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts486">
				<ANNOTATION_VALUE>"azoy vi du host genemen undzer shvester on nadn, ho'mir dir gebrakht nadn."</ANNOTATION_VALUE>
