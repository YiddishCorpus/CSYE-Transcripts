		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts538">
				<ANNOTATION_VALUE>epes hobn ongehoybn di mentshn tsu tun azoy vi s'iz im gefeln,</ANNOTATION_VALUE>
