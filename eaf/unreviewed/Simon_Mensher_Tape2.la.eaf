			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts463" TIME_SLOT_REF2="ts464">
				<ANNOTATION_VALUE>gefirt bahaltn v&lt;u&gt; a f- a froy bahalt ot do o dos gelt,</ANNOTATION_VALUE>
