				<ANNOTATION_VALUE>vos m'hot mir gegebn in Moskve zi.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts903" TIME_SLOT_REF2="ts904">
				<ANNOTATION_VALUE>uh, mir k- hobn zikh gekent in Kosev in di yunge yorn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts905" TIME_SLOT_REF2="ts906">
				<ANNOTATION_VALUE>un mir hobn zikh zeyer shtark lib gehat, shoyn nokh dem ven ikh bin gekumen,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts907" TIME_SLOT_REF2="ts908">
				<ANNOTATION_VALUE>ikh hob shoyn gearbet un geforn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts910">
				<ANNOTATION_VALUE>ikh hob shtark lib gehat di kinder fun, i fun Dintsyen,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts912">
				<ANNOTATION_VALUE>i fun Rozen. ikh hob kimat zey ertsoygn mer vi mayn shvester.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts914">
				<ANNOTATION_VALUE>ikh hob zey shtark... az m'hot badarft geyn tsun a dokter, nor mit mir.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts915" TIME_SLOT_REF2="ts916">
				<ANNOTATION_VALUE>un ikh hob ir gezogt, "&lt;Rontsye&gt;, vart."</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts918">
				<ANNOTATION_VALUE>i- uh, bay undz iz gevezn azoy ongenemen,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts919" TIME_SLOT_REF2="ts920">
				<ANNOTATION_VALUE>az du host khasene,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts922">
				<ANNOTATION_VALUE>iz dayn froy dayn mishpokhe, un nisht merer.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts923" TIME_SLOT_REF2="ts924">
				<ANNOTATION_VALUE>un ikh fleg zikh mit ir trefn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts925" TIME_SLOT_REF2="ts926">
				<ANNOTATION_VALUE>un mir zenen geven zeyer, uh, heymish.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts928">
				<ANNOTATION_VALUE>az mir fleg'mir zikh geyn bodn, kedey</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts929" TIME_SLOT_REF2="ts930">
				<ANNOTATION_VALUE>ikh zol zi nisht brengen &lt;tsu ekstaz un&gt; zikh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts931" TIME_SLOT_REF2="ts932">
				<ANNOTATION_VALUE>&lt;kh'hob mikh&gt; oysgedreyt un ho'mir zikh gebodn tsuzamen.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1230" TIME_SLOT_REF1="ts933" TIME_SLOT_REF2="ts934">
				<ANNOTATION_VALUE>ober ikh hob nit erloybt dos vos kh'hob &lt;nit&gt; gekent erloybn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts936">
				<ANNOTATION_VALUE>un mi- undz ho'mir zikh beyde ts- uh, GEMEINSAM azoy lib gehat,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts937" TIME_SLOT_REF2="ts938">
				<ANNOTATION_VALUE>az mir iz geven genug tsu geyn mit ir shpatsirn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts939" TIME_SLOT_REF2="ts940">
				<ANNOTATION_VALUE>shmuesn mit ir. zi iz oykh geven in Hashomer Hatsair,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts941" TIME_SLOT_REF2="ts942">
				<ANNOTATION_VALUE>zeyer a balezene geven, un zi hot gearbet bay di zakhn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts943" TIME_SLOT_REF2="ts944">
				<ANNOTATION_VALUE>un ikh hob gehat azoy fil gelt,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts945" TIME_SLOT_REF2="ts946">
				<ANNOTATION_VALUE>az kh'hob gekent efenen tsen STOREn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts947" TIME_SLOT_REF2="ts948">
				<ANNOTATION_VALUE>un ikh hob alts gezogt mayn shvoger,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts949" TIME_SLOT_REF2="ts950">
				<ANNOTATION_VALUE>"nem mayne tshekn, tu alts dermit!</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts951" TIME_SLOT_REF2="ts952">
				<ANNOTATION_VALUE>ikh darf nisht keyn gelt."</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts953" TIME_SLOT_REF2="ts954">
				<ANNOTATION_VALUE>ikh bin geven azoy ertsoygn az, uh, kh'hob gehat alts vos me darf.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts955" TIME_SLOT_REF2="ts956">
				<ANNOTATION_VALUE>un der, uh, fabr- der, uh, uh, general,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1231" TIME_SLOT_REF1="ts957" TIME_SLOT_REF2="ts958">
				<ANNOTATION_VALUE>fun yeder nesie, a khoydesh tsayt fleg ikh kumen aheym,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1232" TIME_SLOT_REF1="ts959" TIME_SLOT_REF2="ts960">
				<ANNOTATION_VALUE>hot er gemakht a kostyum, a mantl a prezent.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts961" TIME_SLOT_REF2="ts962">
				<ANNOTATION_VALUE>fun yeder nesie!</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts963" TIME_SLOT_REF2="ts964">
				<ANNOTATION_VALUE>me fleg mikh ontun in a...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts965" TIME_SLOT_REF2="ts966">
				<ANNOTATION_VALUE>a khaluts tor dokh nisht geyn mit keyn kravat,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts967" TIME_SLOT_REF2="ts968">
				<ANNOTATION_VALUE>uh, mit a tseflokhtn hemd. fleg ikh, dortn fleg ikh take yo ontun,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts969" TIME_SLOT_REF2="ts970">
				<ANNOTATION_VALUE>ABER az ikh fleg kumen keyn Kosev in shtetl mit mayne khaveyrim,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts971" TIME_SLOT_REF2="ts972">
				<ANNOTATION_VALUE>bin ikh gegangen azoy vi zey.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts973" TIME_SLOT_REF2="ts974">
				<ANNOTATION_VALUE>un ikh fleg brengen farn sport-klub Makabi,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1233" TIME_SLOT_REF1="ts975" TIME_SLOT_REF2="ts976">
				<ANNOTATION_VALUE>uh, dortn, uh, elef por, uh, di sport-zakhn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts977" TIME_SLOT_REF2="ts978">
				<ANNOTATION_VALUE>hemdlekh mit di &lt;al-&gt;</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts979" TIME_SLOT_REF2="ts980">
				<ANNOTATION_VALUE>&lt;az s'&gt;zol, ikh bin a guter khaver.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts981" TIME_SLOT_REF2="ts982">
				<ANNOTATION_VALUE>ABER az kh'hob in, baym rebe in moyer in keler</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts983" TIME_SLOT_REF2="ts984">
				<ANNOTATION_VALUE>a groysn, uh, uh, ayzernem kastn mit, mit a sakh gelt</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts985" TIME_SLOT_REF2="ts986">
				<ANNOTATION_VALUE>hob ikh mikh geshemt afile tsu zogn emetsn, nor ir hob ikh gezogt.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a469" TIME_SLOT_REF1="ts987" TIME_SLOT_REF2="ts988">
				<ANNOTATION_VALUE>layder hot zikh ongehoybn di milkhome,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts989" TIME_SLOT_REF2="ts990">
				<ANNOTATION_VALUE>un zi iz nebekh gefaln</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a471" TIME_SLOT_REF1="ts991" TIME_SLOT_REF2="ts992">
				<ANNOTATION_VALUE>nisht visndik fun keyn familye-lebn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts993" TIME_SLOT_REF2="ts994">
				<ANNOTATION_VALUE>un ven s'hot zikh geendikt di milkhome bin ikh geforn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a473" TIME_SLOT_REF1="ts995" TIME_SLOT_REF2="ts996">
				<ANNOTATION_VALUE>fun, uh, &lt;L- uh,&gt; KRAKÓW</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts997" TIME_SLOT_REF2="ts998">
				<ANNOTATION_VALUE>gevor vern, ongefregt ver, vos, ven. layder iz keyner nisht geblibn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a476" TIME_SLOT_REF1="ts999" TIME_SLOT_REF2="ts1000">
				<ANNOTATION_VALUE>un, uh, mir hobn gehat</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts1001" TIME_SLOT_REF2="ts1002">
				<ANNOTATION_VALUE>azoy fil bakante Ukrayner in Kosev, in der gegnt,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts1003" TIME_SLOT_REF2="ts1004">
				<ANNOTATION_VALUE>UNK zenen geven azoy min bafrayndet mit mayn shvoger, mit mayn shvester,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts1005" TIME_SLOT_REF2="ts1006">
				<ANNOTATION_VALUE>mitn gevelb, mit mir,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts1007" TIME_SLOT_REF2="ts1008">
				<ANNOTATION_VALUE>un keyner hot nisht gekent, uh, nemen khotshbe a kind oyshaltn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts1009" TIME_SLOT_REF2="ts1010">
				<ANNOTATION_VALUE>m'hot nisht genemen.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts1011" TIME_SLOT_REF2="ts1012">
				<ANNOTATION_VALUE>layder veys nisht di gantse yidishe velt derfun,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts1013" TIME_SLOT_REF2="ts1014">
				<ANNOTATION_VALUE>az arum Kosev iz oykh gevezn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts1015" TIME_SLOT_REF2="ts1016">
				<ANNOTATION_VALUE>etlekhe un draysik derfer, biz tsu der grenets fun Tshekhoslovakay, Rumenyen,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts1017" TIME_SLOT_REF2="ts1018">
				<ANNOTATION_VALUE>un oykh in yedn dorf, vi in Kosmatsh, iz oykh geven fuftsik, zekhtsik mishpokhes.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts1019" TIME_SLOT_REF2="ts1021">
				<ANNOTATION_VALUE>eyn dorf iz geven greser fun ale derfer.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts1020" TIME_SLOT_REF2="ts1022">
				<ANNOTATION_VALUE>dos dorf hot geheysn Zhabye.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts1023" TIME_SLOT_REF2="ts1024">
				<ANNOTATION_VALUE>UNK vayt bay der grenets, groyse berg, toyznt akht hundert, tsvey toyznt meter di heykh.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts1025" TIME_SLOT_REF2="ts1026">
				<ANNOTATION_VALUE>dos dorf hot gehat a teritorye vi Vin,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts1027" TIME_SLOT_REF2="ts1028">
				<ANNOTATION_VALUE>di hoypt-shtot fun EstrayCH,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts1029" TIME_SLOT_REF2="ts1030">
				<ANNOTATION_VALUE>iz geven azoy groys vi di, dos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a494" TIME_SLOT_REF1="ts1031" TIME_SLOT_REF2="ts1032">
				<ANNOTATION_VALUE>akht hundert mishpokhes zenen geven in dem dorf,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts1033" TIME_SLOT_REF2="ts1034">
				<ANNOTATION_VALUE>un dort iz gevezn zeyer a inteligente yidishe,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1236" TIME_SLOT_REF1="ts1035" TIME_SLOT_REF2="ts1037">
				<ANNOTATION_VALUE>uh, yugnt, un di, un di, un di, bikhlal di yidn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts1036" TIME_SLOT_REF2="ts1038">
				<ANNOTATION_VALUE>s'iz geven a seminaryum a hebreisher, a gimnazyum iz geven dortn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts1039" TIME_SLOT_REF2="ts1040">
				<ANNOTATION_VALUE>mer vi in Kosev!</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1042">
				<ANNOTATION_VALUE>Kosev iz geven</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts1043" TIME_SLOT_REF2="ts1044">
				<ANNOTATION_VALUE>a shtetl, uhm, a rayon, &lt;a, azoy vi,&gt; mer hoypt,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts1045" TIME_SLOT_REF2="ts1046">
				<ANNOTATION_VALUE>un Zhabye hot gehat merer</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts1047" TIME_SLOT_REF2="ts1048">
				<ANNOTATION_VALUE>yidishe organizatsyes, azoy az mir flegn geyn &lt;ahin&gt;... s'iz vayt gevezn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts1049" TIME_SLOT_REF2="ts1050">
				<ANNOTATION_VALUE>fertsik kilometer fun Kosev,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts1051" TIME_SLOT_REF2="ts1052">
				<ANNOTATION_VALUE>nor mir flegn geyn tsu fus ahin</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts1053" TIME_SLOT_REF2="ts1054">
				<ANNOTATION_VALUE>zikh trefn mit yener yugnt, un me fleg undz haltn dortn dray, fir teg.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1237" TIME_SLOT_REF1="ts1055" TIME_SLOT_REF2="ts1056">
				<ANNOTATION_VALUE>di gegnt iz &lt;dokh&gt; geven azoy sheyn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts1057" TIME_SLOT_REF2="ts1058">
				<ANNOTATION_VALUE>az me &lt;k-&gt; s'iz gor shver tsu bashraybn, di sheyne gegnt,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts1059" TIME_SLOT_REF2="ts1060">
				<ANNOTATION_VALUE>vi azoy sheyn di yidn hobn farbrakht dortn di tsayt.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts1061" TIME_SLOT_REF2="ts1062">
				<ANNOTATION_VALUE>in, uh, Zhabye iz geven a guter dramatisher krayz.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts1063" TIME_SLOT_REF2="ts1064">
				<ANNOTATION_VALUE>s'iz geven a dramatisher krayz KEDEM,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts1065" TIME_SLOT_REF2="ts1066">
				<ANNOTATION_VALUE>un s'iz geven a yidisher dramatisher krayz Anski.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts1067" TIME_SLOT_REF2="ts1068">
				<ANNOTATION_VALUE>in Kosev iz geven a dramatisher krayz, hobn zey geshtelt "Dem Dibek",</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1070">
				<ANNOTATION_VALUE>"Dem Toybn" fun Dovid Bergelson</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts1071" TIME_SLOT_REF2="ts1072">
				<ANNOTATION_VALUE>beser vi a, an, a profesyonaler, uh, dramatisher krayz.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts1073" TIME_SLOT_REF2="ts1074">
				<ANNOTATION_VALUE>es iz geven in Kosev an advokat Frenkl,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts1075" TIME_SLOT_REF2="ts1076">
				<ANNOTATION_VALUE>hot er gehat tsvey tekhter un a zun.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts1077" TIME_SLOT_REF2="ts1078">
				<ANNOTATION_VALUE>Daniel Frenkl iz&lt;... er iz&gt; geshtorbn bay etlekhe un draysik yor, fun tshekhotke...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts1079" TIME_SLOT_REF2="ts1080">
				<ANNOTATION_VALUE>er hot gevolt inem dramatishn krayz fun yedn eynem vos er hot gornisht gekent zayn keyn artist,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1238" TIME_SLOT_REF1="ts1081" TIME_SLOT_REF2="ts1082">
				<ANNOTATION_VALUE>hot er fun im gevolt makhn an artist. un er iz krank gevorn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts1083" TIME_SLOT_REF2="ts1084">
				<ANNOTATION_VALUE>un az er iz geshtorbn iz &lt;men&gt; gegangen &lt;in&gt; ale derfer&lt;, in&gt; ale shtetlekh&lt;, zenen&gt; gekumen oyf der levaye.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts1085" TIME_SLOT_REF2="ts1086">
				<ANNOTATION_VALUE>er iz geven der onfirer funem dramatishn krayz.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts1087" TIME_SLOT_REF2="ts1088">
				<ANNOTATION_VALUE>un fun Stanisloy, fun dem g- gants groysn yidishn teater, Lebtselter</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts1089" TIME_SLOT_REF2="ts1090">
				<ANNOTATION_VALUE>fleg kumen &lt;zikh&gt; bavundern,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a523" TIME_SLOT_REF1="ts1091" TIME_SLOT_REF2="ts1092">
				<ANNOTATION_VALUE>az Kosev fleg aroysforn &lt;in&gt; andere shtet un vayzn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1094">
				<ANNOTATION_VALUE>yidishe pyeses,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts1095" TIME_SLOT_REF2="ts1096">
				<ANNOTATION_VALUE>meystn teyl Anski, uh, krayz.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts1097" TIME_SLOT_REF2="ts1098">
				<ANNOTATION_VALUE>un, uh, di Vilner trupe,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts1099" TIME_SLOT_REF2="ts1100">
				<ANNOTATION_VALUE>di Vilner trupe, vu s'iz gevezn DIANA Blumenfeld, JONAS TURKÓW,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts1101" TIME_SLOT_REF2="ts1102">
				<ANNOTATION_VALUE>Ide KAMIŃSKA, Maryem KAMIŃSKA, di ale artistn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts1103" TIME_SLOT_REF2="ts1104">
				<ANNOTATION_VALUE>flegn mir zey haltn oyf, bay der frisher luft in Kosev</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a531" TIME_SLOT_REF1="ts1105" TIME_SLOT_REF2="ts1106">
				<ANNOTATION_VALUE>a gantsn khoydesh, zey zoln zikh opruen,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1239" TIME_SLOT_REF1="ts1107" TIME_SLOT_REF2="ts1108">
				<ANNOTATION_VALUE>un zey flegn undz helfn dem dramatishn krayz</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1240" TIME_SLOT_REF1="ts1109" TIME_SLOT_REF2="ts1111">
				<ANNOTATION_VALUE>oyfshteln azelekhe pyeses,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts1110" TIME_SLOT_REF2="ts1112">
				<ANNOTATION_VALUE>&lt;az&gt; di gantse mentshn flegn kumen</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts1113" TIME_SLOT_REF2="ts1114">
				<ANNOTATION_VALUE>in teater, un me fleg unterhaltn, me fleg batsoln.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts1115" TIME_SLOT_REF2="ts1116">
				<ANNOTATION_VALUE>&lt;un der dra-&gt; iz geven a dramatisher krayz a Tsienistisher,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts1117" TIME_SLOT_REF2="ts1118">
				<ANNOTATION_VALUE>a Poyale-Tsienistisher,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts1119" TIME_SLOT_REF2="ts1120">
				<ANNOTATION_VALUE>un afile a Royter oykhet.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts1121" TIME_SLOT_REF2="ts1122">
				<ANNOTATION_VALUE>un &lt;iz&gt;, interesant iz dos vos, uh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts1123" TIME_SLOT_REF2="ts1124">
				<ANNOTATION_VALUE>der birger-mayster iz gevezn der eyntsiker in Poyln, dokter Gertner,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a539" TIME_SLOT_REF1="ts1125" TIME_SLOT_REF2="ts1126">
				<ANNOTATION_VALUE>a Stam Tsienist. er iz geven gut,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts1127" TIME_SLOT_REF2="ts1128">
				<ANNOTATION_VALUE>i far di polyakim, i far di yidn; far ale iz er geven zeyer gut.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a541" TIME_SLOT_REF1="ts1129" TIME_SLOT_REF2="ts1130">
				<ANNOTATION_VALUE>nor az s'iz gekumen nayntsn nayn un draysik di Sovyetn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts1131" TIME_SLOT_REF2="ts1132">
				<ANNOTATION_VALUE>un m'hot bald gezen az dos iz nisht keyn lebn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a543" TIME_SLOT_REF1="ts1133" TIME_SLOT_REF2="ts1134">
				<ANNOTATION_VALUE>dos iz nisht keyn virklekhkeyt,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts1135" TIME_SLOT_REF2="ts1136">
				<ANNOTATION_VALUE>dos iz nisht keyn reale zakh far mentshn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts1137" TIME_SLOT_REF2="ts1138">
				<ANNOTATION_VALUE>hot der dokter Gertner gezogt</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts1139" TIME_SLOT_REF2="ts1140">
				<ANNOTATION_VALUE>aza min zakh, az "do vet shoyn mistam zayn Ukrayn."</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts1141" TIME_SLOT_REF2="ts1142">
				<ANNOTATION_VALUE>vayl s'iz take dort, di hoypt-bafelkerung iz dokh Ukrayner, nisht polyakim.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts1143" TIME_SLOT_REF2="ts1144">
				<ANNOTATION_VALUE>derfar, tsk, ven in, in Mitl-Azyen iz geven di poylishe armye,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a550" TIME_SLOT_REF1="ts1145" TIME_SLOT_REF2="ts1146">
				<ANNOTATION_VALUE>vos Stalin hot gevolt SIKORSKI,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts1147" TIME_SLOT_REF2="ts1148">
				<ANNOTATION_VALUE>vos, un Anders,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts1149" TIME_SLOT_REF2="ts1150">
				<ANNOTATION_VALUE>vos Stalin hot gevolt, zey zoln geyn oyf dem front, uh, shlogn zikh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a553" TIME_SLOT_REF1="ts1151" TIME_SLOT_REF2="ts1152">
				<ANNOTATION_VALUE>hot men SIKORSKIn geharget...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts1153" TIME_SLOT_REF2="ts1154">
				<ANNOTATION_VALUE>me zogt, di polyakim aleyn...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts1155" TIME_SLOT_REF2="ts1156">
				<ANNOTATION_VALUE>un Anders iz avekgegangen keyn Iran, keyn P- keyn Persyen.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts1157" TIME_SLOT_REF2="ts1158">
				<ANNOTATION_VALUE>tsuzamen mit zey, a kapitan fun der poylisher armey iz geven dokter Gertner.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts1159" TIME_SLOT_REF2="ts1160">
				<ANNOTATION_VALUE>BEGIN iz oykh geven dort in yener tsayt. ikh bin oykh geven in der armey.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts1161" TIME_SLOT_REF2="ts1162">
				<ANNOTATION_VALUE>ABER mir hobn gezen, az s'iz tsugekumen a POLITSEYSKIY, zogt er, "o, Mentsher,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts1163" TIME_SLOT_REF2="ts1164">
				<ANNOTATION_VALUE>in Kosev iz er geven a linker. er vet nokh do, uh, makhn dem komunizm."</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a560" TIME_SLOT_REF1="ts1165" TIME_SLOT_REF2="ts1166">
				<ANNOTATION_VALUE>ho'mir farshtanen, nisht nor ikh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts1167" TIME_SLOT_REF2="ts1168">
				<ANNOTATION_VALUE>zeks hundert poylishe yidn zenen avek fun der armey</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts1169" TIME_SLOT_REF2="ts1170">
				<ANNOTATION_VALUE>tsu der rusisher makht &lt;un gezogt,&gt; "tut vos ir vilt,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a563" TIME_SLOT_REF1="ts1171" TIME_SLOT_REF2="ts1172">
				<ANNOTATION_VALUE>nor mir'n mit der armey nisht avekgeyn." mir hobn gekent efsher aribergeyn un kumen keyn Erets-Yisroel,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a564" TIME_SLOT_REF1="ts1173" TIME_SLOT_REF2="ts1174">
				<ANNOTATION_VALUE>ABER m'hot moyre gehat far zey. iz gekumen VANDA VASILEVSKAYA,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a565" TIME_SLOT_REF1="ts1175" TIME_SLOT_REF2="ts1176">
				<ANNOTATION_VALUE>a zhurnalistke fun Lemberik,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts1177" TIME_SLOT_REF2="ts1178">
				<ANNOTATION_VALUE>un hot undz avekgefirt keyn BUZULUKI.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		</TIER>
	<TIER LANG_REF="yid" LINGUISTIC_TYPE_REF="default-lt" TIER_ID="Phyllis Dreazen">
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1206" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts181">
				<ANNOTATION_VALUE>UNK</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1207" TIME_SLOT_REF1="ts246" TIME_SLOT_REF2="ts248">
				<ANNOTATION_VALUE>CARPET.</ANNOTATION_VALUE>
