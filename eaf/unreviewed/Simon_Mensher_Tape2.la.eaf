		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts580">
				<ANNOTATION_VALUE>gantse nekht arumgeyn, &lt;zenen&gt;, zey zoln vern distrofikes,</ANNOTATION_VALUE>
