		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts460">
				<ANNOTATION_VALUE>&lt;d-&gt; ikh gedenk nisht, oder tsvey toyznt DOLLAR, oder kimat azoy fil.</ANNOTATION_VALUE>
