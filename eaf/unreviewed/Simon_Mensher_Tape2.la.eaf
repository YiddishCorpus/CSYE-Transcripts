			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1214" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts476">
				<ANNOTATION_VALUE>un di sh- di Dintsye hot undz derzen, hot zi zikh shtark derfreyt,</ANNOTATION_VALUE>
