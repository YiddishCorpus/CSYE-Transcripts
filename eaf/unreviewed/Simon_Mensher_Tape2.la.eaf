			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts453" TIME_SLOT_REF2="ts454">
				<ANNOTATION_VALUE>vet zayn toyznt finef hundert DOLLAR.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
