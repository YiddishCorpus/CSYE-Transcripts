		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts446">
				<ANNOTATION_VALUE>nor er hot nisht gekent gebn; &lt;s'iz&gt; in a kleyn shtetl.</ANNOTATION_VALUE>
