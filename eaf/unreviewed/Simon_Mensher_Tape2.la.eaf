		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts520">
				<ANNOTATION_VALUE>uh, P- uh, neyn, Pilsudski iz shoyn nisht geven. densmolt iz shoyn gevezn...</ANNOTATION_VALUE>
