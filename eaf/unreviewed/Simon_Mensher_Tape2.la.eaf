		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts456">
				<ANNOTATION_VALUE>vos darf'mir... ho'mir gehat efsher akhtsik yokh feld. vos darf'mir azoy fil feld?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts457" TIME_SLOT_REF2="ts458">
				<ANNOTATION_VALUE>ho'mir farkoyft fir tsi finef yokh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
