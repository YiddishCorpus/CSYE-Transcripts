		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts442">
				<ANNOTATION_VALUE>un er hot gegebn zeyer veynik gelt oyf tsu lebn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
