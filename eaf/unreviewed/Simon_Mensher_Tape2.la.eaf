		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts448">
				<ANNOTATION_VALUE>hobn mir gemakht a, a, a, &lt;dos&gt;, a miting</ANNOTATION_VALUE>
