		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts542">
				<ANNOTATION_VALUE>un iz frish avekgegangen. dernokh iz shoyn gevezn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
