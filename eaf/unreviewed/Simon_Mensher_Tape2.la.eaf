		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts488">
				<ANNOTATION_VALUE>far dem gelt vos mir hobn gebrakht hot er geefnt zeyer a groysn STORE</ANNOTATION_VALUE>
