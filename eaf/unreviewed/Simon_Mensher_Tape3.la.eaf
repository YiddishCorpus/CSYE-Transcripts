		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts922">
				<ANNOTATION_VALUE>az UNK tsishn Rumenyen un Poyln</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
