		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts902" TIME_SLOT_REF2="ts904">
				<ANNOTATION_VALUE>bin arayngekumen, iz a geveyn, a UNK geveyn. &lt;er iz&gt; shir nisht meshuge gevorn un ikh oykh.</ANNOTATION_VALUE>
