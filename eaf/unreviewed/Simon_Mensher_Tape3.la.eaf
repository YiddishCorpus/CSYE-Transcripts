			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts931" TIME_SLOT_REF2="ts932">
				<ANNOTATION_VALUE>dray mol iz mayn kuzen geven in di hent fun di alte daytshn.</ANNOTATION_VALUE>
