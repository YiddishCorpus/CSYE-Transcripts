		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1138" TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts918">
				<ANNOTATION_VALUE>un m'hot im oykhet a bisl gehit. nor di Ukrayner hobn zikh tsu im batsoygn gut.</ANNOTATION_VALUE>
