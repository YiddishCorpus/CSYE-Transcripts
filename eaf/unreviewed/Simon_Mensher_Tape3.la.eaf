		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts936">
				<ANNOTATION_VALUE>geyen zey tsu, zogn zey, "ACH, DU ARMER JUDE, HAB KEIN FURCHT."</ANNOTATION_VALUE>
