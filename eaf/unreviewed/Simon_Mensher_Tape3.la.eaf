		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts600">
				<ANNOTATION_VALUE>der zibeter lager, iz geven dortn efsher fertsik toyznt</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
