		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1141" TIME_SLOT_REF1="ts971" TIME_SLOT_REF2="ts972">
				<ANNOTATION_VALUE>ot di TEPPICHer di daytshn, me zol blaybn lebn, un nokh, nokh UNK genemen frish un &lt;nokh&gt; frish.</ANNOTATION_VALUE>
