		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1144" TIME_SLOT_REF1="ts987" TIME_SLOT_REF2="ts989">
				<ANNOTATION_VALUE>fun, uh, Poyln lernen meditsin. er hot khasene gehat mit der tokhter</ANNOTATION_VALUE>
