			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts961" TIME_SLOT_REF2="ts962">
				<ANNOTATION_VALUE>iz shoyn in der gantser gegnt gevezn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
