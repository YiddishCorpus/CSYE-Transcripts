		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1114" TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts623">
				<ANNOTATION_VALUE>un dernokh hobn mir forsirt, iz geven dortn a sakh korbones</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts622" TIME_SLOT_REF2="ts624">
				<ANNOTATION_VALUE>fun undzer divizye.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts626">
				<ANNOTATION_VALUE>un dernokh ze'mir shoyn gegangen durkh, uh, VLODAVA, Lublin,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
