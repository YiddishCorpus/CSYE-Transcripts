		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts610">
				<ANNOTATION_VALUE>di Amerikaner hobn zikh nisht opgeshtelt keyn mol. di rusn flegn zikh opshteln.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
