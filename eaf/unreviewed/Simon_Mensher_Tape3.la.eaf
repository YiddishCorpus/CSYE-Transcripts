			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts899" TIME_SLOT_REF2="ts900">
				<ANNOTATION_VALUE>hot er gegebn a geshrey, "gevald!" un di iberike, "gevald!" &lt;zenen dokh&gt; geshlofn, ile oyfgeshtanen...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
