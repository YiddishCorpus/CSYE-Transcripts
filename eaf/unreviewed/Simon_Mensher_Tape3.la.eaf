		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts638">
				<ANNOTATION_VALUE>gebn zey a bisl gelt dortn, broyt, un azoy vayter, un azoy vayter.</ANNOTATION_VALUE>
