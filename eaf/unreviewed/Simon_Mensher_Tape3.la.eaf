		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts977" TIME_SLOT_REF2="ts978">
				<ANNOTATION_VALUE>un ikh kling ir yedes mol on, zog ikh, "SHTEFURAK,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
