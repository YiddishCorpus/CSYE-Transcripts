			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
				<ANNOTATION_VALUE>"az du vest nisht brengen di feslekh mit dem zeyf,</ANNOTATION_VALUE>
