		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts912">
				<ANNOTATION_VALUE>hobn geharget di rusn un di rusn hobn geharget zey.</ANNOTATION_VALUE>
