			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts174">
				<ANNOTATION_VALUE>ze'mir nor aribergekumen oyf der alter grenets, hot men undz ale nisht g- uh, getroyt keyn gever,</ANNOTATION_VALUE>
