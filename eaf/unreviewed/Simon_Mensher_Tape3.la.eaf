		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts188">
				<ANNOTATION_VALUE>un mir zenen gekumen ahin. di Ukrayner zenen geven durkhgetribn, mit di polyakim.</ANNOTATION_VALUE>
