		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts914">
				<ANNOTATION_VALUE>iz mayn kuzen hot gezogt di, di rusishe komunistn vu me ken ibershlofn yede nakht ergets andersh,</ANNOTATION_VALUE>
