		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts564">
				<ANNOTATION_VALUE>eh ibergekukt ale dokumentn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
