		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts126">
				<ANNOTATION_VALUE>zi iz geven zeyer an ongenemene in der shtot. zenen ale ORGANIZATION fleg zi nemen aynteyl</ANNOTATION_VALUE>
