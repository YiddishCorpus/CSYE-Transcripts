		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts566">
				<ANNOTATION_VALUE>eh vegn di yidn, farshteyt zikh</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
