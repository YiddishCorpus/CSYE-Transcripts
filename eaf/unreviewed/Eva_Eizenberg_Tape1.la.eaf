		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1100" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts614">
				<ANNOTATION_VALUE>zey zenen geven epes a yor tsayt, nisht mer.</ANNOTATION_VALUE>
