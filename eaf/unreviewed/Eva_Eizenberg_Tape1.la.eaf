		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts567" TIME_SLOT_REF2="ts568">
				<ANNOTATION_VALUE>un me zol visn ver zey zenen, vu zey zenen, fun vanen zenen gekumen.</ANNOTATION_VALUE>
