		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts136">
				<ANNOTATION_VALUE>un eh akhuts mit derinen iz &lt;zenen mir&gt; geven yidn.</ANNOTATION_VALUE>
