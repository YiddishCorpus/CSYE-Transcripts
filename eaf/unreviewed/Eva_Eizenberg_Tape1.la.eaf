		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts134">
				<ANNOTATION_VALUE>eh zi iz geven zeyer a tikhtike.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
