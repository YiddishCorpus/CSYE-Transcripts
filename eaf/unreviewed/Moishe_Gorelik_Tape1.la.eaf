		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts516">
				<ANNOTATION_VALUE>ver vil zol zikh durkhgeyn in shtot Babruysk.</ANNOTATION_VALUE>
