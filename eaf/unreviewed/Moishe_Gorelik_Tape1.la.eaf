		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts476">
				<ANNOTATION_VALUE>hobn zey mir nit gezen. dos iz shoyn geven akhtsn... nokh frier eyder fun draysik nayntn;</ANNOTATION_VALUE>
