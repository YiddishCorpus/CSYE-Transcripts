		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts512">
				<ANNOTATION_VALUE>hot men, uh, far nakht undz opgelozn. uh, s'iz geven shabes,</ANNOTATION_VALUE>
