		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts504">
				<ANNOTATION_VALUE>nor s'iz nit azoy vayt.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
