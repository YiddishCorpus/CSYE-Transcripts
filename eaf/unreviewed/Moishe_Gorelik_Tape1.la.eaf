		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts246">
				<ANNOTATION_VALUE>hot men gedavnt in der heym, mayn zeyde, mayn bobe,</ANNOTATION_VALUE>
