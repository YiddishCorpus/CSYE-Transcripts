		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts304">
				<ANNOTATION_VALUE>dernokh dem iz bay mir geven der klenster Yankele. er hot zikh gehat in toyznt nayn hundert draysik akhtn yor.</ANNOTATION_VALUE>
