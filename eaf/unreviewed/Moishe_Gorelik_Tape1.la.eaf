			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts626">
				<ANNOTATION_VALUE>a eynfakher, a eynfakher lebn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
