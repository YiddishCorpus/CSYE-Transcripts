		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts520">
				<ANNOTATION_VALUE>iz geven nit vayt fun dem lager vu mir hobn durkhgefirt undzere, hm, UCHENIE, undzer lere</ANNOTATION_VALUE>
