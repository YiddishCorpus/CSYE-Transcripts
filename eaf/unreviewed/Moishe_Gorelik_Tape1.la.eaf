		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts506">
				<ANNOTATION_VALUE>morgn in der fri,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
