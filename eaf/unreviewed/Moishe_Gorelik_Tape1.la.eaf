		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts466">
				<ANNOTATION_VALUE>mayn mame un mayn tate, zey hobn geredt mit mir in telefon.</ANNOTATION_VALUE>
