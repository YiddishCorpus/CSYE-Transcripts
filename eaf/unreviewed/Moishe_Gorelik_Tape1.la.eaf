			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts470">
				<ANNOTATION_VALUE>az mir iz gevorn fuftsn yor bin ikh geven avekgeforn fun der heym</ANNOTATION_VALUE>
