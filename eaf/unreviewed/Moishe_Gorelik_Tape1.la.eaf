		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts462">
				<ANNOTATION_VALUE>iz zi geven fun, uh, mayn lager, avuhin ikh bin gekumen tsu forn.</ANNOTATION_VALUE>
