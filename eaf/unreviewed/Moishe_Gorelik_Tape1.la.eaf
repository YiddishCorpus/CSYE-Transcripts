			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts622" TIME_SLOT_REF2="ts624">
				<ANNOTATION_VALUE>der, der lebn iz geven bay undz, vi me zogt dos, uhm,</ANNOTATION_VALUE>
