		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts491" TIME_SLOT_REF2="ts492">
				<ANNOTATION_VALUE>dan, gedenk ikh, fun, uh, Paritsh biz Babruysk iz geven</ANNOTATION_VALUE>
