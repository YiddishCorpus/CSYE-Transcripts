		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts475">
				<ANNOTATION_VALUE>hobn zey fun, uh, fuftsn yor, fun draysik nayntn yor</ANNOTATION_VALUE>
