			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts248">
				<ANNOTATION_VALUE>biz vanen, bizl afile, bizl der milkhome flegn zey ondrey- onton dem tales, der, hm, zeyde, oyf zikh,</ANNOTATION_VALUE>
