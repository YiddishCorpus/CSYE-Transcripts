		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts518">
				<ANNOTATION_VALUE>vorem di shtot Babruysk</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
