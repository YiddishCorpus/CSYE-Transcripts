		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts502">
				<ANNOTATION_VALUE>kh'veys nit vi firt men dos iber oyf eng- oyf english, kilometer,</ANNOTATION_VALUE>
