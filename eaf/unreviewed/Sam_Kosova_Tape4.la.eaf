		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
				<ANNOTATION_VALUE>ven ikh bin gekumen? gornisht. bin gezesn in a hotel.</ANNOTATION_VALUE>
