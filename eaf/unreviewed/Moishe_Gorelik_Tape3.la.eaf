		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts424">
				<ANNOTATION_VALUE>fun a mehalekh fun hundert meter.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
