		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts578">
				<ANNOTATION_VALUE>hobn mir tseklapt dray AVTO velkhe zaynen aropgegangen fun veg.</ANNOTATION_VALUE>
