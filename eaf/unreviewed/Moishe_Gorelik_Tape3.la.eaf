		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts354">
				<ANNOTATION_VALUE>s'iz dokh nit keyn doytshn.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
