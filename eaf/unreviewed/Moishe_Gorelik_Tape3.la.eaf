		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts591" TIME_SLOT_REF2="ts592">
				<ANNOTATION_VALUE>shoyn di SNARYADn iz bay undz kimat shoyn nito, nor hot shoyn keyn vert nit a SNARYAD far zey, far</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a1230" TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts594">
				<ANNOTATION_VALUE>yeder soldat&lt;, vest dokh nit sh-&gt; shisn mit ot dos,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
