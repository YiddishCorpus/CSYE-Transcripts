		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts306">
				<ANNOTATION_VALUE>&lt;KUYAKH&gt;es, uh, oyf, uh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
