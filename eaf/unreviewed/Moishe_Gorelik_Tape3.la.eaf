		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts652">
				<ANNOTATION_VALUE>un zol dos forn aleyn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
