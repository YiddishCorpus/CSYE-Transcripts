		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts601" TIME_SLOT_REF2="ts602">
				<ANNOTATION_VALUE>undzere pushkes, tsugetshepet,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
