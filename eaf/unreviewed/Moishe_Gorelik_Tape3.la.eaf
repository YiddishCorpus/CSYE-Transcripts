		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts334">
				<ANNOTATION_VALUE>un mir hobn zey azoy gepakt. a fuftsik man hobn mir azoy gepakt. eynike hobn ongehoybn shpringen oyf untn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
