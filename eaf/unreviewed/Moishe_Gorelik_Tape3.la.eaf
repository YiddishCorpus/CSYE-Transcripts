		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts421" TIME_SLOT_REF2="ts422">
				<ANNOTATION_VALUE>mir hobn ongehoybn in zey shisn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
