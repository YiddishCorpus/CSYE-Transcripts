		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts659" TIME_SLOT_REF2="ts660">
				<ANNOTATION_VALUE>un mir hobn ge- geforn oyf der PREDEL'Ner gikhkeyt.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
