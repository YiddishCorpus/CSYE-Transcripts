		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts616">
				<ANNOTATION_VALUE>un mir zaynen avekgeforn. durkhgeforn farbay a dorf,</ANNOTATION_VALUE>
