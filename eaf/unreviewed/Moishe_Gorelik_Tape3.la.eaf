		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts611" TIME_SLOT_REF2="ts612">
				<ANNOTATION_VALUE>iz veln zey farshteyn az mir hobn keyn SNARYADn nit,</ANNOTATION_VALUE>
