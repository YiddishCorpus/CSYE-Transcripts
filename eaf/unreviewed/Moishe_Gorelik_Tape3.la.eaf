		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts348">
				<ANNOTATION_VALUE>zey hobn gezukht mines mit di, ETO.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
