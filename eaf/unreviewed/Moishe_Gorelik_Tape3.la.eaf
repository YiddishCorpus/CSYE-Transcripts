		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts598">
				<ANNOTATION_VALUE>kitser, mir hobn zey opgeklapt. zaynen zey avekgepoyzet gevorn.</ANNOTATION_VALUE>
