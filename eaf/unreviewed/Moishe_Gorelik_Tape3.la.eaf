		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts290">
				<ANNOTATION_VALUE>ikh hob gegebn a &lt;k-&gt; a bafel az me zol zey tsulozn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
