		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts302">
				<ANNOTATION_VALUE>un oyf yenem zayt, iz fun eyn zayt hot gevoksn</ANNOTATION_VALUE>
