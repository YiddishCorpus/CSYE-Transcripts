		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts589" TIME_SLOT_REF2="ts590">
				<ANNOTATION_VALUE>di hobn zikh tseleygt, di soldatn &lt;vos hobn&gt; gehat gever.</ANNOTATION_VALUE>
