		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts356">
				<ANNOTATION_VALUE>ikh trakht nokh a rakhmones; a yid iz nit keyn,</ANNOTATION_VALUE>
