		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts582">
				<ANNOTATION_VALUE>hob ikh geheysn az mir hobn ot dos tseklapt un eyne, di ferte,</ANNOTATION_VALUE>
