		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts322">
				<ANNOTATION_VALUE>iz fun dem zayt vakst &lt;KUYAKH&gt;es, un d- fun dem zayt iz bay, geven kustes,</ANNOTATION_VALUE>
