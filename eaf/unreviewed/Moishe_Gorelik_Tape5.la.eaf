		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts260">
				<ANNOTATION_VALUE>mit groyse gefil.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
