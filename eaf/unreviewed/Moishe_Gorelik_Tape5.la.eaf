		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts220">
				<ANNOTATION_VALUE>aroysgegangen di ershte.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
