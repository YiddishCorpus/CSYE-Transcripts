		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts182">
				<ANNOTATION_VALUE>iz nemen zey tsu fun lager, me git im nokh a, a shtele avelkhe nit iz, a farretershe.</ANNOTATION_VALUE>
