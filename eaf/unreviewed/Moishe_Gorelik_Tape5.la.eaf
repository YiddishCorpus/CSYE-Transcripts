		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts192">
				<ANNOTATION_VALUE>di shtot iz geven, uh, CHENSTOKHOV. mir zeen, zi iz a gantse, nit keyn tseklapte, un epes a reyne, antkegn di,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
