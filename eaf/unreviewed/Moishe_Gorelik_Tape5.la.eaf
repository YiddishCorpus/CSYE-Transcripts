		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
				<ANNOTATION_VALUE>keyn flier hobn ir nit geklapt.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts198">
				<ANNOTATION_VALUE>&lt;ersht hot men&gt; glaykh gefregt&lt;, uh, d-&gt; gekumen in CHENSTOKHOV, iz zi geven tseteylt m- mit drot oyf tsvey helft,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
