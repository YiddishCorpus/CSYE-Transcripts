		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts256">
				<ANNOTATION_VALUE>&lt;i-&gt; trakht ikh vayter, geyn der ershter</ANNOTATION_VALUE>
