		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts254">
				<ANNOTATION_VALUE>farshteyst? klemt di harts.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
