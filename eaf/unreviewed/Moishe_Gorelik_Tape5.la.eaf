		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts258">
				<ANNOTATION_VALUE>iz tor men nit, vorem dem ersht- di ershte zukht men, uh,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
