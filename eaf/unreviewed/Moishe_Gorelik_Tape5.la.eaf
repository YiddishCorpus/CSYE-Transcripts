		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts200">
				<ANNOTATION_VALUE>oyf tsvey helft, tsvey b- tsvey blokn geven.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
