		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a886" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts211">
				<ANNOTATION_VALUE>er iz geven in d- vald, oysbahaltn zikh zekhtsn bokhurim.</ANNOTATION_VALUE>
