		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a588" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts318">
				<ANNOTATION_VALUE>un m'hot undz arayngezetst in a eshelon vu s'iz geforn</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
