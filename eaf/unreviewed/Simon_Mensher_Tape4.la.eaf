		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts212">
				<ANNOTATION_VALUE>zeyer a fayner bokher.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
