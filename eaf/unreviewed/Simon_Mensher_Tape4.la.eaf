		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts300">
				<ANNOTATION_VALUE>un s'iz shoyn geven di kalte milkhome a bisele.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
