		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts286">
				<ANNOTATION_VALUE>un zey zenen dokh geven yunge khevre, akhtsn-yerike, di KAGEBISTn,</ANNOTATION_VALUE>
