		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a799" TIME_SLOT_REF1="ts823" TIME_SLOT_REF2="ts824">
				<ANNOTATION_VALUE>un dos iz di froy, fun, uh, KOROSTYSHEV,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a800" TIME_SLOT_REF1="ts825" TIME_SLOT_REF2="ts826">
				<ANNOTATION_VALUE>Zhitomer OBLAST'. er hot mit ir khasene gehat.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
