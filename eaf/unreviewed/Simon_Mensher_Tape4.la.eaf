		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts276">
				<ANNOTATION_VALUE>vayl in poylishn K.G.B. zenen gegangen undzere mentshn spetsyel dinen,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
