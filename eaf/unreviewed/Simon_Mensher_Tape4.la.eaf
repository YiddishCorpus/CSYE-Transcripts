		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts304">
				<ANNOTATION_VALUE>iz er geforn, der yid, keyn Berlin un hot tsu visn gegebn vi m'hot undz arestirt,</ANNOTATION_VALUE>
