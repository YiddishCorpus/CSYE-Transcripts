		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts162">
				<ANNOTATION_VALUE>nor zi iz geven geshvangert shoyn UNK dem, dem andern tog hot zi geboyrn a kind</ANNOTATION_VALUE>
