		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a803" TIME_SLOT_REF1="ts829" TIME_SLOT_REF2="ts830">
				<ANNOTATION_VALUE>dos bild iz gemakht gevorn,</ANNOTATION_VALUE>
