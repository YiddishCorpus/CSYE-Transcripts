			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
				<ANNOTATION_VALUE>er voynt in Erets-Yisroel.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
