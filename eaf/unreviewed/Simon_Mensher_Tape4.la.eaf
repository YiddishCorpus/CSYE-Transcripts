		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts184">
				<ANNOTATION_VALUE>iz gekumen der M&lt;eshke&gt; Koyfman,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
