		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts170">
				<ANNOTATION_VALUE>vayl zey hobn geroybt; s'iz geven ale d- in der POLIZEI zenen gegangen ganovim.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
				<ANNOTATION_VALUE>hob ikh bavizn zikh tsu shlogn mit zey. ikh hob durkhgefirt zi, un er iz geblibn.</ANNOTATION_VALUE>
