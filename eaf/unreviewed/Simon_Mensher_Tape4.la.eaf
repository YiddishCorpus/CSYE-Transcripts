			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts272">
				<ANNOTATION_VALUE>s'iz nokh geven mit undz a rusisher yid. ho'mir gezogt, "du antloyf.</ANNOTATION_VALUE>
