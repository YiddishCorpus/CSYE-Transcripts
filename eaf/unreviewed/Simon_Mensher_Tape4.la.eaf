		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts302">
				<ANNOTATION_VALUE>s'iz gevezn nayntsn zeks un fertsik, dem eyn un draysikstn yul.</ANNOTATION_VALUE>
