			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts174">
				<ANNOTATION_VALUE>hot zi geveynt shtark. in Berlin bin ikh geforn di zelbe nakht tsurik</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
