			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts314">
				<ANNOTATION_VALUE>un m'hot geheysn untershraybn... m'hot undz gut geshlogn dort oykh...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts316">
				<ANNOTATION_VALUE>un mir hobn nisht untergeshribn. zogn zey, "me darf nisht."</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
