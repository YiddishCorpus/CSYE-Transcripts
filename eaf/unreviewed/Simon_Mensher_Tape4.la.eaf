		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a801" TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts828">
				<ANNOTATION_VALUE>er hot mir dos bild geshikt keyn, keyn Moskve. &lt;er...&gt;</ANNOTATION_VALUE>
