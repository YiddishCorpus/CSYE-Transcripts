		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts188">
				<ANNOTATION_VALUE>un es iz shoyn adurkhgegan a sakh yorn,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
