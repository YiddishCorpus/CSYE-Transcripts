		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a574" TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts288">
				<ANNOTATION_VALUE>iz biz zey hobn, uh, ver, vos, ven, s'iz gevezn bay nakht, nayn a zeyger,</ANNOTATION_VALUE>
