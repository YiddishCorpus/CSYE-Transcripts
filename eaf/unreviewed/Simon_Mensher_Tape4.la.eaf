		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a585" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts310">
				<ANNOTATION_VALUE>eynem hot men geshosn, a inzhener fun finef un fertsik yor,</ANNOTATION_VALUE>
