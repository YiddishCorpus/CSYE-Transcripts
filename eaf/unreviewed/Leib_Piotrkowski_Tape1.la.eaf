		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a33" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
				<ANNOTATION_VALUE>ikh bin gevezn an ORPHAN. a yosem.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
