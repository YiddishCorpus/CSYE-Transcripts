            xmin = 1524.44 
            xmax = 1530.912 
            text = "" 
        intervals [577]:
            xmin = 1530.912 
            xmax = 1534.444 
            text = "<NU, KH-> POCHEMU? zi ken mikh betn in GOSTI." 
        intervals [578]:
            xmin = 1534.444 
