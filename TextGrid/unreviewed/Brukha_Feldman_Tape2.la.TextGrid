            text = "" 
        intervals [606]:
            xmin = 1618.29 
            xmax = 1623.02 
            text = "A MUZHCHINY TOZHE MALO RABOTALI. MISHKA Trenker TAM, I," 
        intervals [607]:
            xmin = 1623.02 
            xmax = 1628.12 
            text = "uh, KTO ESHCHЁ, uh, RABOTAL TAM? EVREEV MALO RABOTAL." 
        intervals [608]:
            xmin = 1628.12 
            xmax = 1629.512 
            text = "" 
        intervals [609]:
            xmin = 1629.512 
            xmax = 1634.917 
            text = "yidn veynik. yidn veynik oyf der fabrike. gole goyim BOL'SHINSTVO. yidn veynik." 
        intervals [610]:
            xmin = 1634.917 
            xmax = 1636.73 
            text = "SCHITANNYE EVREI." 
        intervals [611]:
            xmin = 1636.73 
            xmax = 1637.528 
            text = "" 
        intervals [612]:
            xmin = 1637.528 
            xmax = 1641.859 
            text = "DAZHE NACHALO GODY, I POSLEDNIE. SKOL'KO YA RABOTALA, TAK yidn veynik." 
        intervals [613]:
            xmin = 1641.859 
            xmax = 1642.708 
            text = "" 
        intervals [614]:
            xmin = 1642.708 
            xmax = 1646.957 
            text = "uh, nu, Shkolnik hot gearbet, BORIS. BELLA Shkolnik." 
        intervals [615]:
            xmin = 1646.957 
            xmax = 1648.713 
            text = "hob ikh <far- nit> gedenkt zey." 
        intervals [616]:
            xmin = 1648.713 
            xmax = 1651.39 
            text = "<ONI ZHE TOZHE IZ BERSHA-...> ONI RABOTALI." 
        intervals [617]:
