            text = "" 
        intervals [72]:
            xmin = 222.93 
            xmax = 225.472 
            text = "<oyb ir hot gekent>, un fleg zi leyenen." 
        intervals [73]:
            xmin = 225.472 
            xmax = 225.613 
            text = "" 
        intervals [74]:
            xmin = 225.613 
            xmax = 229.049 
            text = "fleg ikh kumen un fleg hern kadesh nokh a foter," 
        intervals [75]:
