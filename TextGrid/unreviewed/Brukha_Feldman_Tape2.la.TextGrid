            xmax = 1674.894 
            text = "ale <in IZRAILe>. nu, un in kantor hot gearbet B- uh, BORIS Abramovitsh," 
        intervals [625]:
            xmin = 1674.894 
            xmax = 1681.514 
            text = "un s'hot gearbet, uh, dortn, uh, nokh UNK Kogon hot gearbet a mayse bay, bay mir." 
