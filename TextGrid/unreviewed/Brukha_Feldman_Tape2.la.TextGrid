            text = "" 
        intervals [8]:
            xmin = 43.498 
            xmax = 49.837 
            text = "az s'hot gelebt do di yidn, iz geven freylekh. ikh hob gevoynt PO PERVOMAYSKe gas oykhet." 
        intervals [9]:
            xmin = 49.837 
            xmax = 50.248 
            text = "" 
        intervals [10]:
            xmin = 50.248 
            xmax = 52.436 
            text = "nu, fleg ikh aroysgeyn oyf der nakht," 
        intervals [11]:
            xmin = 52.436 
            xmax = 52.678 
            text = "" 
        intervals [12]:
            xmin = 52.678 
            xmax = 59.422 
            text = "fleg aroysgeyn khevre, yidishe khevre, mit yidishe meydlekh. me fleg nemen a gitare, me fleg shpiln," 
        intervals [13]:
            xmin = 59.422 
            xmax = 59.513 
            text = "" 
        intervals [14]:
            xmin = 59.513 
            xmax = 64.091 
            text = "un me fleg zingen, un s'iz geven freylekh. s'iz geven a freylekhdike gas." 
        intervals [15]:
            xmin = 64.091 
            xmax = 65.75 
            text = "yidn zenen geven." 
        intervals [16]:
            xmin = 65.75 
            xmax = 65.942 
            text = "" 
        intervals [17]:
            xmin = 65.942 
            xmax = 70.52 
            text = "itstert o, kh'gey aroys oyf der nakht, hob ikh shoyn moyre. finef a, nayn a zeyger," 
        intervals [18]:
            xmin = 70.52 
            xmax = 72.857 
            text = "akht a zeyger, me zitst shoyn yeder in der heym," 
        intervals [19]:
            xmin = 72.857 
            xmax = 75.504 
            text = "me geyt shoyn keyner nit aroys; m'hot moyre." 
        intervals [20]:
            xmin = 75.504 
            xmax = 75.696 
            text = "" 
        intervals [21]:
            xmin = 75.696 
            xmax = 77.394 
            text = "far vemen hot men moyre?" 
        intervals [22]:
            xmin = 77.394 
            xmax = 77.569 
            text = "" 
        intervals [23]:
            xmin = 77.569 
            xmax = 83.233 
            text = "se geyt di ukrayntses: der geyt shiker, der geyt shiker, un m'hot moyre, me zol gebn a klop," 
        intervals [24]:
            xmin = 83.233 
            xmax = 83.239 
            text = "" 
        intervals [25]:
            xmin = 83.239 
            xmax = 84.397 
            text = "un VSЁ." 
