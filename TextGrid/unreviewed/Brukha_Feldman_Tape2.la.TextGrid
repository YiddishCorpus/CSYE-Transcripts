            xmin = 1692.247 
            xmax = 1692.574 
            text = "" 
        intervals [633]:
            xmin = 1692.574 
            xmax = 1697.7 
            text = "zi hot gemakht UKOLn, uh, az ikh hob ge- m'hot gedarft, <MARA>." 
