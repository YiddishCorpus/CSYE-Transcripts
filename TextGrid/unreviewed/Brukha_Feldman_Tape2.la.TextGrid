            xmin = 1433.672 
            xmax = 1433.813 
            text = "" 
        intervals [542]:
            xmin = 1433.813 
            xmax = 1436.135 
            text = "un ikh hob oyfgetsoygn di tsvey kinder." 
        intervals [543]:
            xmin = 1436.135 
            xmax = 1436.142 
            text = "" 
        intervals [544]:
            xmin = 1436.142 
            xmax = 1444.742 
            text = "nu, <azoy> s'iz gegangen di regns, <azoy s'iz> gefaln un aldings, di kinder zenen gevaksn bay mir sheyne tsvey tekhter. nu, vos zhe ken ikh nokhet zogn?" 
        intervals [545]:
            xmin = 1444.742 
            xmax = 1444.883 
            text = "" 
        intervals [546]:
            xmin = 1444.883 
            xmax = 1450.175 
            text = "NO ZHIZ<N',> dos lebn iz bay mir ibergegangen shtark shlekht." 
        intervals [547]:
            xmin = 1450.175 
            xmax = 1450.367 
            text = "" 
        intervals [548]:
            xmin = 1450.367 
            xmax = 1452.853 
            text = "ikh hob zikh ongemutshet azoy vayt," 
        intervals [549]:
            xmin = 1452.853 
            xmax = 1456.27 
            text = "nor itster leb ikh a bisl." 
        intervals [550]:
            xmin = 1456.27 
            xmax = 1459.839 
            text = "far vos zhe leb ikh a bisl? vayl m'hot mir gegebn a gute KOMNATe." 
        intervals [551]:
            xmin = 1459.839 
            xmax = 1463.051 
            text = "ikh voyn in a gute KOMNATe: heytsung darf ikh nit," 
        intervals [552]:
            xmin = 1463.051 
            xmax = 1463.125 
            text = "" 
        intervals [553]:
            xmin = 1463.125 
            xmax = 1465.956 
            text = "<uh,> dos darf ikh nit, keyn holts darf ikh nit," 
        intervals [554]:
            xmin = 1465.956 
            xmax = 1467.382 
            text = "s'iz mir varem," 
        intervals [555]:
            xmin = 1467.382 
            xmax = 1472.951 
            text = "un s'iz mir UYUTNe, eyn KOMNATe, un ikh hob, IZVINYAY<SYA>, a tualet vu arayntsugeyn." 
        intervals [556]:
            xmin = 1472.951 
            xmax = 1477.043 
            text = "ikh leb itster! dem<UNK>t hob ikh zikh gemutshet; itster leb ikh." 
        intervals [557]:
            xmin = 1477.043 
            xmax = 1482.137 
            text = "veys ikh nit vos tsu tun, tsi <mi- mir,> in IZRAILe vet mir zayn beser, tsi do iz beser. kh'veys aleyn nit vos." 
        intervals [558]:
            xmin = 1482.137 
            xmax = 1482.582 
            text = "" 
        intervals [559]:
            xmin = 1482.582 
            xmax = 1488.021 
            text = "s'iz aza zakh vos me ken nit, uh, me ken nit zogn un me ken nit visn." 
        intervals [560]:
            xmin = 1488.021 
            xmax = 1492.35 
            text = "zog ""for"", vet men zoln zayn shuldik. ""for nit"" iz oykh... <dos> veys men nit." 
        intervals [561]:
            xmin = 1492.35 
            xmax = 1492.403 
            text = "" 
        intervals [562]:
            xmin = 1492.403 
            xmax = 1494.619 
            text = "di shvester shraybt mir az s'iz ir gut." 
        intervals [563]:
            xmin = 1494.619 
            xmax = 1497.318 
            text = "zi hot fir KOMNATes un zi hot genemen UNK" 
        intervals [564]:
            xmin = 1497.318 
            xmax = 1499.079 
            text = "oyf akht un tsvontsik yor." 
        intervals [565]:
            xmin = 1499.079 
            xmax = 1499.22 
            text = "" 
        intervals [566]:
            xmin = 1499.22 
            xmax = 1504.445 
            text = "nu, hot zi a zun. der zun arbet un di tokhter, uh, arbet, un zi hot pensye, er hot pensye." 
        intervals [567]:
            xmin = 1504.445 
            xmax = 1504.485 
            text = "" 
        intervals [568]:
            xmin = 1504.485 
            xmax = 1508.92 
            text = "ikh veys? far ts- fir yor, dos ferde yor, hot zi mir shoyn geholfn tsvey mol," 
        intervals [569]:
            xmin = 1508.92 
            xmax = 1514.09 
            text = "zol zayn gezunt un shtark: eyn mol hundert dolars aroysgeshikt, dem andern <mol> hundert dolars aroysgeshikt." 
        intervals [570]:
            xmin = 1514.09 
            xmax = 1516.531 
            text = "hayntiks yor hot zi nit gekent aroysshikn mit Fanyen," 
        intervals [571]:
            xmin = 1516.531 
            xmax = 1520.67 
            text = "ibergebn, derfar vos der, uh, shvoger darf geyn oyf OPERATSIYA KATARAKT," 
