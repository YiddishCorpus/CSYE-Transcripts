            xmin = 1362.949 
            xmax = 1363.174 
            text = "" 
        intervals [511]:
            xmin = 1363.174 
            xmax = 1370.053 
            text = "NU, CHTO YA MOGU RASSKAZAT' O SEBE? ikh ken dertseyln fun zikh, az ikh hob zikh mit mayne tsvey kinder gut oykh ongemutshet." 
        intervals [512]:
            xmin = 1370.053 
            xmax = 1370.683 
            text = "" 
        intervals [513]:
            xmin = 1370.683 
            xmax = 1372.921 
            text = "ikh hob gevoynt, uh," 
