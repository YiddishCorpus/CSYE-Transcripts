        intervals [588]:
            xmin = 1555.988 
            xmax = 1560.386 
            text = "ober ahin, ober ater. hob ikh shoyn <a, hm, atin> mit a fus, ater vel ikh shoyn nit aroys, I VSЁ" 
        intervals [589]:
            xmin = 1560.386 
            xmax = 1561.998 
