            xmin = 1697.7 
            xmax = 1698.092 
            text = "" 
        intervals [635]:
            xmin = 1698.092 
            xmax = 1705.05 
            text = "zayn mame, ir mame hot mikh UVAZHAet. uh, zey hobn mikh UVAZHAet. ikh fleg arayngeyn I VSЁ. <ven er iz> avekgeforn in IZRAILe" 
        intervals [636]:
            xmin = 1705.05 
            xmax = 1707.334 
            text = "bin ikh geven oyf a PROVOZHANIE bay im." 
        intervals [637]:
            xmin = 1707.334 
            xmax = 1719.54 
            text = "" 
        intervals [638]:
            xmin = 1719.54 
            xmax = 1722.943 
            text = "nu, Vayserman, YA KONECHNO bin ikh nit geven." 
        intervals [639]:
            xmin = 1722.943 
            xmax = 1723.202 
            text = "" 
        intervals [640]:
            xmin = 1723.202 
            xmax = 1725.924 
            text = "NU, A MOZHET Vayserman NE SDELAL I VSЁ." 
        intervals [641]:
            xmin = 1725.924 
            xmax = 1729.119 
            text = "U KOGONA YA BYL I U SONI Trenker." 
