            xmin = 84.397 
            xmax = 84.471 
            text = "" 
        intervals [27]:
            xmin = 84.471 
            xmax = 87.058 
            text = "iz geven a, iz geven a freylekhdike" 
        intervals [28]:
            xmin = 87.058 
            xmax = 89.44 
            text = "yidishe shtot, Bershed," 
        intervals [29]:
            xmin = 89.44 
            xmax = 94.134 
            text = "vos ikh voyn, uh, <ikh bin dokh geb-> ikh bin geboyrn gevorn do, un ikh voyn do," 
        intervals [30]:
            xmin = 94.134 
            xmax = 94.309 
            text = "" 
        intervals [31]:
            xmin = 94.309 
            xmax = 99.52 
            text = "iz v- volt ikh nit POMENYAet <ergets> andersh, aza freylekhdike G- Bershed iz geven do." 
        intervals [32]:
            xmin = 99.52 
            xmax = 104.979 
            text = "yidishe khevre, s'iz geven, me fleg aroysgeyn, se fleg, lebn <KAZ><UNK> budke," 
        intervals [33]:
            xmin = 104.979 
            xmax = 108.278 
            text = "s'iz geven azoy freylekh <az PRYAM ikh veys nit>. itster o, UZHE VSЁ." 
        intervals [34]:
            xmin = 108.278 
            xmax = 114.502 
            text = "m'iz ale avekgeforn in IZRAIL' I VSЁ, di yidn. <s'iz dokh> nishto keyn yidn do itster I VSЁ, nor s'iz friert geven milyonen yidn," 
        intervals [35]:
            xmin = 114.502 
            xmax = 114.66 
            text = "" 
        intervals [36]:
            xmin = 114.66 
            xmax = 116.38 
            text = "TYSYACHA milyonen," 
        intervals [37]:
            xmin = 116.38 
            xmax = 121.947 
            text = "a, a gas mit, uh, yidn. me fleg aroysgeyn: der iz geven a yidishke, der iz geven a yidishke. <me> fleg zogn a gut-morgn, a gut-yor." 
        intervals [38]:
            xmin = 121.947 
            xmax = 125.218 
            text = "itster iz nishto vemen tsu zogn: tsigayners mit goyim, I VSЁ." 
        intervals [39]:
            xmin = 125.218 
            xmax = 129.139 
            text = "" 
        intervals [40]:
            xmin = 129.139 
            xmax = 133.436 
            text = "ЕTO PO ULITSE LENINA BYLO, PO PERVOMAYSKOY." 
        intervals [41]:
            xmin = 133.436 
            xmax = 133.645 
            text = "" 
        intervals [42]:
            xmin = 133.645 
            xmax = 137.081 
            text = "VOT ET<UNK>, OSOBENNO PO PERVOMAYSKOY ULITSE geven." 
        intervals [43]:
            xmin = 137.081 
            xmax = 139.905 
            text = "" 
        intervals [44]:
            xmin = 139.905 
            xmax = 142.737 
            text = "ETO ikh... voden? ikh farshtey nit? <ze nor.>" 
        intervals [45]:
            xmin = 142.737 
            xmax = 143.746 
            text = "<ikh bin geven...>" 
        intervals [46]:
            xmin = 143.746 
            xmax = 144.158 
            text = "" 
        intervals [47]:
            xmin = 144.158 
            xmax = 148.854 
            text = "KONECHNO, I MOEGO VOZRAST<UNK> KHLO- uh, KHLOPTSY I DEVCHATA," 
        intervals [48]:
            xmin = 148.854 
            xmax = 151.256 
            text = "un s'iz geven, uh, nit mayn VOZRAST." 
        intervals [49]:
            xmin = 151.256 
            xmax = 151.752 
            text = "" 
        intervals [50]:
            xmin = 151.752 
            xmax = 156.21 
            text = "me fleg aroysgeyn, <me> fleg geyn<, me> fleg zikh on<neme>n <garn,> me fleg geyn GULYAen, <me> fleg geyn" 
        intervals [51]:
            xmin = 156.21 
            xmax = 160.51 
            text = "in restoran, <me> fleg geyn in bar, un me fleg, <se fleg,> UNK freylekh iz geven." 
        intervals [52]:
            xmin = 160.51 
            xmax = 163.457 
            text = "itster shoyn freylekh? me kukt di televizors I VSЁ." 
        intervals [53]:
            xmin = 163.457 
            xmax = 167.125 
            text = "" 
        intervals [54]:
            xmin = 167.125 
            xmax = 172.164 
            text = "dem<UNK>t iz oykh geven televizors. voden? s'iz nit geven televizors? farshtey<t zikh, s'iz oykh geven>..." 
        intervals [55]:
            xmin = 172.164 
            xmax = 172.795 
            text = "" 
        intervals [56]:
            xmin = 172.795 
            xmax = 176.07 
            text = "<uh,> m'iz gegangen in kino. ikh fleg aleyn geyn in kino." 
        intervals [57]:
            xmin = 176.07 
            xmax = 177.36 
            text = "ikh fleg hobn lib kino," 
        intervals [58]:
            xmin = 177.36 
            xmax = 180.821 
            text = "fleg geyn nemen a bilet, fleg hobn lib kino, fleg hobn lib tantses," 
        intervals [59]:
            xmin = 180.821 
            xmax = 180.962 
            text = "" 
        intervals [60]:
            xmin = 180.962 
            xmax = 185.47 
            text = "fleg nemen tsvontsik kopekes, fleg geyn in park, iz a mol geven a garmoshke fleg shpiln." 
        intervals [61]:
            xmin = 185.47 
            xmax = 190.406 
            text = "s'iz geven a klub a alter un me fleg geyn. s<UNK> s'iz geven freylekh. itster iz shoyn gornit nit." 
        intervals [62]:
