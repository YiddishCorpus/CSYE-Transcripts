            text = "" 
        intervals [580]:
            xmin = 1536.413 
            xmax = 1538.64 
            text = "far vos tsu forn. far vos vel ikh forn?" 
        intervals [581]:
            xmin = 1538.64 
            xmax = 1544.017 
            text = "vos ikh POL- ikh POLUCHAe dem pensye, hob ikh POLUCHet far eyn khoydesh, VSЁ, <m'hot shoyn dem> dritn khoydesh, me git nit keyn pensye." 
        intervals [582]:
            xmin = 1544.017 
            xmax = 1544.412 
            text = "" 
        intervals [583]:
            xmin = 1544.412 
            xmax = 1545.941 
            text = "nu, far vos zhe zol ikh forn?" 
        intervals [584]:
            xmin = 1545.941 
            xmax = 1546.858 
            text = "" 
        intervals [585]:
            xmin = 1546.858 
            xmax = 1551.875 
            text = "un forn vel ikh forn, vel ikh zikh kumen in GOSTI, vel ikh zayn dortn tsvey vokhn UNK kumen, ikh zol zen, vos..." 
        intervals [586]:
            xmin = 1551.875 
