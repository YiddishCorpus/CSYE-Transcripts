            text = "" 
        intervals [592]:
            xmin = 1568.83 
            xmax = 1570.832 
            text = "DA, KAZHDOGO PO-SVOEMU." 
        intervals [593]:
            xmin = 1570.832 
            xmax = 1580.929 
            text = "" 
        intervals [594]:
            xmin = 1580.929 
            xmax = 1582.83 
            text = "KOGDA VY RABOTALI ESHCHЁ." 
        intervals [595]:
            xmin = 1582.83 
            xmax = 1593.619 
            text = "" 
        intervals [596]:
            xmin = 1593.619 
            xmax = 1599.564 
            text = "NU, EVREI, ZHENSHCHINY EVREYSKIE, ETO BYLO MALO. ETO BYLO," 
        intervals [597]:
            xmin = 1599.564 
            xmax = 1605.07 
            text = "uh, uh, SARA, MOYA POKOYNAYA<, ETO> MISHINA ZHENA PERVAYA, RABOTALA." 
        intervals [598]:
            xmin = 1605.07 
            xmax = 1609.171 
            text = "POTOM YA RABOTALA. POTOM SARA Trenker RABOTALA." 
