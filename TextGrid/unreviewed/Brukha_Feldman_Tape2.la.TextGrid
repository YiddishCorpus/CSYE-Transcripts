            xmin = 1420.323 
            xmax = 1420.667 
            text = "" 
        intervals [537]:
            xmin = 1420.667 
            xmax = 1424.2 
            text = "darf <men> zogn, uh, <iz, zi> hot mir geholfn." 
        intervals [538]:
            xmin = 1424.2 
            xmax = 1429.082 
            text = "oyf alе... kh'hob POLUCHet KAK MAT'-ODINOCHKA oyf tsvey kinder," 
        intervals [539]:
            xmin = 1429.082 
