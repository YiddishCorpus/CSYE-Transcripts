            xmin = 1372.921 
            xmax = 1372.962 
            text = "" 
        intervals [515]:
            xmin = 1372.962 
            xmax = 1375.656 
            text = "ah, PO ULITSE OKTYABR'SK<e>." 
        intervals [516]:
            xmin = 1375.656 
            xmax = 1375.813 
            text = "" 
        intervals [517]:
            xmin = 1375.813 
            xmax = 1378.169 
            text = "s'iz geven a tsebrokhene shtub." 
        intervals [518]:
            xmin = 1378.169 
            xmax = 1378.412 
            text = "" 
        intervals [519]:
            xmin = 1378.412 
            xmax = 1380.366 
            text = "ikh hob geRODet eyn kind." 
        intervals [520]:
            xmin = 1380.366 
            xmax = 1381.984 
            text = "di mame iz nokh geven." 
        intervals [521]:
            xmin = 1381.984 
            xmax = 1382.023 
            text = "" 
        intervals [522]:
            xmin = 1382.023 
            xmax = 1384.93 
            text = "un dos kind hot gehat VOSPALENIE LЁGK<e>." 
        intervals [523]:
            xmin = 1384.93 
            xmax = 1389.622 
            text = "dernokh hob ikh geRODet dos tsveyte kind, un s'iz gekumen di mame, un mir hobn gevoynt shtark orem." 
        intervals [524]:
            xmin = 1389.622 
            xmax = 1390.837 
            text = "hot zi gezogt," 
        intervals [525]:
            xmin = 1390.837 
            xmax = 1392.921 
            text = """vos darfstu hobn tsvey kinder?" 
        intervals [526]:
            xmin = 1392.921 
            xmax = 1395.107 
            text = "host eyn kind MAECHke, <hob>," 
        intervals [527]:
            xmin = 1395.107 
            xmax = 1397.762 
            text = "un ANECHKen vest iberlozn in BOL'NITSe.""" 
        intervals [528]:
            xmin = 1397.762 
            xmax = 1397.818 
            text = "" 
        intervals [529]:
            xmin = 1397.818 
            xmax = 1399.215 
            text = "hob ikh gezogt," 
        intervals [530]:
            xmin = 1399.215 
            xmax = 1402.557 
            text = """vos zhe zikh onmutshen nayn khadoshim" 
        intervals [531]:
            xmin = 1402.557 
            xmax = 1406.464 
            text = "un hobn a, a kind, un avekgebn dos kind?"" zog ikh, ""neyn, mame." 
        intervals [532]:
            xmin = 1406.464 
            xmax = 1407.94 
            text = "<azoy> ikh vel zikh mutshen," 
        intervals [533]:
            xmin = 1407.94 
            xmax = 1409.585 
            text = "ikh nem dos kind aheym.""" 
        intervals [534]:
            xmin = 1409.585 
            xmax = 1415.88 
            text = "nu, hob ikh genemen dos kind aheym un mir hobn zikh gemutshet. kh'hob zikh gemutshet, ober kh'hob gearbet, kh'hob zey VOSPITYVet, I VSЁ." 
        intervals [535]:
            xmin = 1415.88 
            xmax = 1420.323 
            text = "nor, uh, zogt men, azoy zogt men, uh, BLAGODARYA di melukhe," 
