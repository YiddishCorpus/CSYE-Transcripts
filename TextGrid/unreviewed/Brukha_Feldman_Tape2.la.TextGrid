            text = "" 
        intervals [80]:
            xmin = 239.923 
            xmax = 245.868 
            text = "hob ikh ongenemen, uh... nu, bin ikh geven oykh a kind, fertsn yor, bin ikh oykh geven a kind, CHETYRNADTSAT' LET..." 
        intervals [81]:
            xmin = 245.868 
            xmax = 250.02 
            text = "hob ikh ongenemen a keshene mit PRYANIK<ses>, mit konfetn." 
        intervals [82]:
