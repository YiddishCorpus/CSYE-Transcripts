            xmax = 202.849 
            text = "" 
        intervals [63]:
            xmin = 202.849 
            xmax = 205.461 
            text = "avade! ve<y-> avade veys ikh." 
        intervals [64]:
            xmin = 205.461 
            xmax = 209.39 
            text = "ikh bin aleyn gegangen. ikh hob ongehoybn tsu fastn fun fertsn yor." 
        intervals [65]:
            xmin = 209.39 
            xmax = 209.886 
            text = "" 
        intervals [66]:
            xmin = 209.886 
            xmax = 211.325 
            text = "fun fertsn yor." 
        intervals [67]:
            xmin = 211.325 
            xmax = 215.679 
            text = "gedenk ikh az mayn mame hot gefastn, un mayn mame iz gegangen oykh in shil arayn." 
        intervals [68]:
            xmin = 215.679 
            xmax = 220.68 
            text = "un mayn mame iz gezesn oyvn, un untn gezesn di MUZHCHINes, un oyvn gezesn di ZHENSHCHINes." 
        intervals [69]:
            xmin = 220.68 
            xmax = 220.804 
