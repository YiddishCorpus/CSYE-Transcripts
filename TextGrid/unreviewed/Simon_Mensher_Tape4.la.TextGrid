            xmin = 414.59 
            xmax = 414.748 
            text = "" 
        intervals [184]:
            xmin = 414.748 
            xmax = 418.086 
            text = "ABER, uh, der iz avekgegangen, der rusisher ofitsir..." 
        intervals [185]:
            xmin = 418.086 
            xmax = 419.791 
            text = "im volt men zikher geharget..." 
        intervals [186]:
            xmin = 419.791 
            xmax = 423.09 
            text = "un zey hobn nisht gehert, vayl mir hobn z<ikh> bashosn mit di pistoletn," 
        intervals [187]:
            xmin = 423.09 
            xmax = 427.128 
            text = "un zey zenen dokh geven yunge khevre, akhtsn-yerike, di KAGEBISTn," 
        intervals [188]:
            xmin = 427.128 
            xmax = 427.135 
            text = "" 
        intervals [189]:
            xmin = 427.135 
            xmax = 432.051 
            text = "iz biz zey hobn, uh, ver, vos, ven, s'iz gevezn bay nakht, nayn a zeyger," 
