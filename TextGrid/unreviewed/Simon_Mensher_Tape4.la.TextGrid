            text = "s'iz gevezn nayntsn zeks un fertsik, dem eyn un draysikstn yul." 
        intervals [199]:
            xmin = 451.482 
            xmax = 455.987 
            text = "iz er geforn, der yid, keyn Berlin un hot tsu visn gegebn vi m'hot undz arestirt," 
        intervals [200]:
            xmin = 455.987 
