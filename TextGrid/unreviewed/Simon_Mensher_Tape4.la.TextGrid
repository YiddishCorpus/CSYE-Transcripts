            xmax = 396.723 
            text = "zenen undz ibergefaln" 
        intervals [177]:
            xmin = 396.723 
            xmax = 400.21 
            text = "dray mashinen, fuftsn KAGEBISTn" 
        intervals [178]:
            xmin = 400.21 
            xmax = 402.35 
            text = "mit AVTOMATn. vos ho'mir gekent tun?" 
        intervals [179]:
            xmin = 402.35 
            xmax = 405.506 
            text = "s'iz nokh geven mit undz a rusisher yid. ho'mir gezogt, ""du antloyf." 
        intervals [180]:
            xmin = 405.506 
            xmax = 408.509 
            text = "mir zenen poylishe yidn, uh, muzn zey undz opshikn keyn Poyln.""" 
        intervals [181]:
            xmin = 408.509 
            xmax = 412.585 
            text = "vayl in poylishn K.G.B. zenen gegangen undzere mentshn spetsyel dinen," 
