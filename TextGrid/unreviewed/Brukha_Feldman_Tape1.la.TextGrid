            text = "" 
        intervals [44]:
            xmin = 232.212 
            xmax = 239.07 
            text = "uh, BRUNYA, VO VREMYA VOYNY, U V- S VAMI ZHILI, S MAMOY, S VAMI, ZHILI ESHCHЁ VASHI BRAT'YA I SЁSTRY," 
        intervals [45]:
            xmin = 239.07 
