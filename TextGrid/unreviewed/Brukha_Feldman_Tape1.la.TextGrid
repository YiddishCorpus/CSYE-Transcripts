            text = "" 
        intervals [34]:
            xmin = 130.287 
            xmax = 133.605 
            text = "SKAZHITE, POZHALUYSTA, VY RODILIS', uh, V EVREYSKOY SEM'E?" 
        intervals [35]:
            xmin = 133.605 
            xmax = 135.012 
            text = "" 
        intervals [36]:
            xmin = 135.012 
            xmax = 137.469 
            text = "VY MOZHETE RASSKAZAT' NAM O SVOEY SEM'E?" 
