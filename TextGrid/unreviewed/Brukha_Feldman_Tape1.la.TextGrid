            xmin = 264.774 
            xmax = 274.062 
            text = "" 
        intervals [51]:
            xmin = 274.062 
            xmax = 282.34 
            text = "uh, BRUNYA, RASSKAZHITE, POZHALUYSTA, KAK VY, uh, VSPOMINAETE, MOZHET BYT' UNK IZ RASSKAZOV VASHEY MATERI," 
        intervals [52]:
            xmin = 282.34 
            xmax = 286.251 
            text = "KAK VAM DOBILOS', K- KAK MATERI VASHEY DOBILOS' VO VREMYA VOYNY," 
