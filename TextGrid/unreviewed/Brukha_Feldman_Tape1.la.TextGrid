            text = "" 
        intervals [28]:
            xmin = 111.184 
            xmax = 116.882 
            text = "NAZOVITE, POZHALUYSTA, CHLENORAZDEL'NO I MEDLENNO SVOЁ POLNOE IMYA I FAMILIYU." 
