        intervals [63]:
            xmin = 329.189 
            xmax = 336.137 
            text = "uh, NE TOL'KO IZ RASSKAZOV MATERI, A SAMA PONY- PONYALA SAMA, CHTO BYLA V GETTO, BYLA V KONTSLAGERE," 
