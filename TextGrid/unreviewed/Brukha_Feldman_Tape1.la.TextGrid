            xmax = 1133.546 
            text = "uh, TO, CHTO VOZNIKLA VOZMOZHNOST' UEZZHAT', uh, V IZRAIL', UEZZHAT' V EVREYSKOE GOSUDARSTVO, ZHIT' TAM," 
