        intervals [40]:
            xmin = 176.592 
            xmax = 178.546 
            text = "uh, BRUNYA," 
        intervals [41]:
            xmin = 178.546 
            xmax = 187.04 
            text = "uh, YA POPROSHU VAS SEYCHAS, uh, RASSKAZAT' TO, CHTO VY POMNITE OT VOENNOGO VREMENI, uh, TO, CHTO VAM RASSKAZYVALA MAMA." 
        intervals [42]:
            xmin = 187.04 
