            xmax = 430.729 
            text = "" 
        intervals [172]:
            xmin = 430.729 
            xmax = 434.334 
            text = "mit a <geheysn> ikh gedenk nisht yetst dem, dem nomen." 
        intervals [173]:
            xmin = 434.334 
            xmax = 435.868 
            text = "" 
        intervals [174]:
            xmin = 435.868 
            xmax = 439.548 
            text = "ROZA UNK, VE Yankl der klorer" 
        intervals [175]:
            xmin = 439.548 
            xmax = 439.707 
            text = "" 
        intervals [176]:
            xmin = 439.707 
            xmax = 443.112 
            text = "vos iz oykh gevezn in eh komitet fun" 
        intervals [177]:
            xmin = 443.112 
            xmax = 445.725 
            text = "fun eh fun rat fun der shtot." 
        intervals [178]:
            xmin = 445.725 
            xmax = 445.815 
            text = "" 
        intervals [179]:
            xmin = 445.815 
            xmax = 451.917 
            text = "di yidn zenen geven der hoypt un der premyer iz gevezn a goy, vayl eh andersh hot men nisht gekent." 
        intervals [180]:
            xmin = 451.917 
            xmax = 452.278 
            text = "" 
        intervals [181]:
            xmin = 452.278 
            xmax = 455.63 
            text = "dos iz gevezn di kindheyt, iz geven a gute," 
        intervals [182]:
            xmin = 455.63 
            xmax = 455.704 
            text = "" 
        intervals [183]:
            xmin = 455.704 
            xmax = 459.877 
            text = "nor mayn tate iz geven a bisl komunistish geshtimt" 
        intervals [184]:
            xmin = 459.877 
            xmax = 462.206 
            text = "un im iz nisht gefeln gevorn" 
        intervals [185]:
            xmin = 462.206 
            xmax = 465.741 
            text = "vi azoy di Polyakn batsien zikh tsu di yidn," 
        intervals [186]:
            xmin = 465.741 
            xmax = 470.244 
            text = "vi me kumt un me gloybt dir nisht, un me nemt tsu podatkes." 
        intervals [187]:
            xmin = 470.244 
            xmax = 470.284 
            text = "" 
        intervals [188]:
            xmin = 470.284 
            xmax = 474.854 
            text = "un er hot nor getseyln vi avektsuforn ergets nokh Urugvay," 
        intervals [189]:
            xmin = 474.854 
            xmax = 482.681 
            text = "nokh Amerike. un er iz avekgeforn demolt in zeks un tsvantsikstn, in zibn un tsvantsikstn yor nokh Kuba." 
        intervals [190]:
            xmin = 482.681 
            xmax = 483.025 
            text = "" 
        intervals [191]:
            xmin = 483.025 
            xmax = 488.858 
            text = "dray yor iz mayn tate geven in Kuba un zayner a bruder iz gekumen helfn." 
        intervals [192]:
            xmin = 488.858 
            xmax = 489.032 
            text = "" 
        intervals [193]:
            xmin = 489.032 
            xmax = 492.682 
            text = "biz mir veln, bi- di kinder veln hobn vos tsu esn un er vet" 
