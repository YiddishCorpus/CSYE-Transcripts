            xmax = 343.249 
            text = "" 
        intervals [128]:
            xmin = 343.249 
            xmax = 347.968 
            text = "di shtub. di mame iz gevezn zeyer a heyse bundistke" 
        intervals [129]:
            xmin = 347.968 
            xmax = 348.615 
            text = "" 
        intervals [130]:
            xmin = 348.615 
            xmax = 354.481 
            text = "oyf azoy vayt az s'iz geven di folks-tsaytung vos iz aroys oyfn Bund fun Varshe" 
        intervals [131]:
            xmin = 354.481 
            xmax = 354.69 
            text = "" 
        intervals [132]:
            xmin = 354.69 
            xmax = 358.096 
            text = "hot eyner a sh- m- spetsyeler mentsh" 
        intervals [133]:
            xmin = 358.096 
            xmax = 359.764 
            text = "tsetrogn di tsaytung," 
        intervals [134]:
            xmin = 359.764 
