            xmin = 365.551 
            xmax = 365.575 
            text = "" 
        intervals [140]:
            xmin = 365.575 
            xmax = 368.949 
            text = "gedarft trogn di tsaytung kedey tsu nemen dos gelt" 
        intervals [141]:
            xmin = 368.949 
            xmax = 370.858 
            text = "un <dekn> dem di hoypt" 
        intervals [142]:
            xmin = 370.858 
            xmax = 374.76 
            text = "iz mayn mame gegangen mit der tsaytung ober zi iz dokh geven a froy" 
        intervals [143]:
            xmin = 374.76 
            xmax = 375.882 
            text = "vos arbet," 
        intervals [144]:
            xmin = 375.882 
            xmax = 379.949 
            text = "hot zi mir geshikt un ikh bin geven demolt akht oder nayn yor" 
        intervals [145]:
            xmin = 379.949 
            xmax = 382.258 
            text = "un ikh hob zikh zeyer geshemt." 
        intervals [146]:
            xmin = 382.258 
            xmax = 382.635 
            text = "" 
        intervals [147]:
            xmin = 382.635 
            xmax = 385.261 
            text = "<nu ikh> zog ""mame, tsulib vos tustu dos?""" 
        intervals [148]:
            xmin = 385.261 
            xmax = 385.437 
            text = "" 
        intervals [149]:
            xmin = 385.437 
            xmax = 387.07 
            text = "hot zi gezogt ""mayn kind," 
        intervals [150]:
            xmin = 387.07 
            xmax = 389.042 
            text = "az me gehert tsu a partey," 
        intervals [151]:
            xmin = 389.042 
            xmax = 389.25 
            text = "" 
        intervals [152]:
            xmin = 389.25 
            xmax = 393.328 
            text = "darf men ton alts az di partey zol nisht zayn bankrot""." 
        intervals [153]:
            xmin = 393.328 
            xmax = 394.043 
            text = "" 
        intervals [154]:
            xmin = 394.043 
            xmax = 398.171 
            text = "un dos iz gevezn dem, vos zi hot undz arayngegebn aza gayst." 
        intervals [155]:
            xmin = 398.171 
            xmax = 398.211 
            text = "" 
        intervals [156]:
            xmin = 398.211 
            xmax = 400.533 
            text = "shpeter az me iz avek in shule," 
        intervals [157]:
            xmin = 400.533 
            xmax = 400.833 
            text = "" 
        intervals [158]:
            xmin = 400.833 
            xmax = 405.326 
            text = "shtub iz gevezn a atmosfer vos ver s'iz gekumen fun Varshe," 
        intervals [159]:
            xmin = 405.326 
