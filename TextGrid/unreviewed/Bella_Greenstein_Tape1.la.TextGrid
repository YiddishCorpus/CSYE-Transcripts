            text = "" 
        intervals [79]:
            xmin = 229.579 
            xmax = 232.357 
            text = "bloyz yidn mit a groysn mark" 
        intervals [80]:
            xmin = 232.357 
            xmax = 232.65 
            text = "" 
        intervals [81]:
            xmin = 232.65 
            xmax = 236.306 
            text = "a handl-shtetl un der iker a fabrik-shtot" 
        intervals [82]:
            xmin = 236.306 
            xmax = 236.464 
            text = "" 
        intervals [83]:
            xmin = 236.464 
            xmax = 241.757 
            text = "m'hot oysgearbet leder, leder UNK un leder UNK" 
        intervals [84]:
            xmin = 241.757 
            xmax = 241.763 
            text = "" 
        intervals [85]:
            xmin = 241.763 
            xmax = 245.014 
            text = "der leder UNK un spn dos iz gegangen <nokh> Rusland." 
        intervals [86]:
            xmin = 245.014 
            xmax = 245.155 
            text = "" 
        intervals [87]:
            xmin = 245.155 
            xmax = 247.303 
            text = "s'iz geven i a handl-shtot," 
        intervals [88]:
            xmin = 247.303 
            xmax = 249.648 
            text = "i a fabrik-shtetl <kleyne>." 
        intervals [89]:
            xmin = 249.648 
            xmax = 252.534 
            text = "di shtetl iz shoyn fun nayntsn finef" 
        intervals [90]:
            xmin = 252.534 
            xmax = 255.206 
            text = "iz di gantse leder gegangen nokh Rusland." 
        intervals [91]:
            xmin = 255.206 
            xmax = 255.583 
            text = "" 
        intervals [92]:
            xmin = 255.583 
            xmax = 258.162 
            text = "ale hobn gekent KRYNKI" 
        intervals [93]:
            xmin = 258.162 
            xmax = 259.695 
