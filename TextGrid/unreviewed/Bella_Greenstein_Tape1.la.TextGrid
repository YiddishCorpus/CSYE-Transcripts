            text = "khaveyrim un khavertes, Pinkas Erlekh," 
        intervals [161]:
            xmin = 408.999 
            xmax = 414.017 
            text = "un Yankev Pat, ver s'iz gekumen hot gefunen bay undz in shtub a MOKEM-MIKLAT." 
        intervals [162]:
