        intervals [135]:
            xmin = 359.77 
            xmax = 362.087 
            text = "shpeter hot er tsugeganvet di gelt," 
        intervals [136]:
            xmin = 362.087 
            xmax = 363.966 
            text = "hot yeder bundist" 
        intervals [137]:
            xmin = 363.966 
