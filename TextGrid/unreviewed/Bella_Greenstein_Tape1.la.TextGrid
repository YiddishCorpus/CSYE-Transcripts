            xmax = 414.445 
            text = "" 
        intervals [163]:
            xmin = 414.445 
            xmax = 416.447 
            text = "gegesn un getrunken," 
        intervals [164]:
            xmin = 416.447 
            xmax = 416.453 
            text = "" 
        intervals [165]:
            xmin = 416.453 
            xmax = 419.31 
            text = "alts iz gevezn bay undz in shtub" 
        intervals [166]:
            xmin = 419.31 
            xmax = 422.567 
            text = "un tsu dem, iz geven Dovid GOTTLIEB vos iz geven" 
        intervals [167]:
            xmin = 422.567 
            xmax = 425.053 
            text = "der birger-mayster fun der shtetl a yid," 
        intervals [168]:
            xmin = 425.053 
            xmax = 425.413 
            text = "" 
        intervals [169]:
            xmin = 425.413 
            xmax = 427.967 
            text = "un s'iz gevezn <er, in der>" 
        intervals [170]:
            xmin = 427.967 
