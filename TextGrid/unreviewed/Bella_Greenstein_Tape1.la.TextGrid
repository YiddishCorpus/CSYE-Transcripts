        intervals [95]:
            xmin = 259.819 
            xmax = 261.123 
            text = "di yugnt" 
        intervals [96]:
            xmin = 261.123 
            xmax = 263.57 
            text = "fun tsvelef, draytsn yor" 
        intervals [97]:
            xmin = 263.57 
            xmax = 265.82 
            text = "hobn shoyn gearbet in di fabrikn." 
        intervals [98]:
            xmin = 265.82 
            xmax = 266.991 
            text = "" 
        intervals [99]:
            xmin = 266.991 
            xmax = 271.473 
            text = "dos iz geven a UNK yidishe shtetl" 
        intervals [100]:
            xmin = 271.473 
            xmax = 271.885 
            text = "" 
        intervals [101]:
            xmin = 271.885 
            xmax = 277.262 
            text = "a kemfndike, ale merstn teyl komunistn un bundistn." 
        intervals [102]:
            xmin = 277.262 
            xmax = 278.01 
            text = "" 
        intervals [103]:
            xmin = 278.01 
            xmax = 284.006 
            text = "di bundistn zenen gegangen oyf demonstratsyes un in toyznt nayn hundert finftn yor" 
        intervals [104]:
            xmin = 284.006 
            xmax = 286.85 
            text = "iz tsvey vokhn geven di shtetl" 
        intervals [105]:
            xmin = 286.85 
            xmax = 290.222 
            text = "a komunistishe shtetl on politsey, on gornisht." 
        intervals [106]:
            xmin = 290.222 
            xmax = 290.751 
            text = "" 
        intervals [107]:
            xmin = 290.751 
            xmax = 294.553 
            text = "un nakher hobn di ale mentshn antlofn nokh Amerike," 
        intervals [108]:
            xmin = 294.553 
            xmax = 297.089 
            text = "ven s'iz ongekumen fun Varshe di politsey." 
        intervals [109]:
            xmin = 297.089 
            xmax = 300.403 
            text = "" 
        intervals [110]:
            xmin = 300.403 
            xmax = 305.628 
            text = "eh zey hobn gehitst di, yo, zey hobn gehitst di bafelkerung" 
        intervals [111]:
            xmin = 305.628 
            xmax = 305.719 
            text = "" 
        intervals [112]:
            xmin = 305.719 
            xmax = 311.045 
            text = "un dos hot <gevizn> az zey zenen komunistn un komunistn hot men demolt arestirt." 
        intervals [113]:
            xmin = 311.045 
            xmax = 311.507 
            text = "" 
        intervals [114]:
            xmin = 311.507 
            xmax = 319.77 
            text = "un <LUI Sheyn> iz gevezn eyner fun zey, un Shmuel <ZUTS> vos er iz blind gevorn aher in tfise." 
        intervals [115]:
            xmin = 319.77 
            xmax = 319.877 
            text = "" 
        intervals [116]:
            xmin = 319.877 
            xmax = 323.921 
            text = "dos iz gevezn a shtetl mit martirer-firer." 
        intervals [117]:
            xmin = 323.921 
            xmax = 324.18 
            text = "" 
        intervals [118]:
            xmin = 324.18 
            xmax = 328.663 
            text = "un di ale, finef zenen antlofn," 
        intervals [119]:
            xmin = 328.663 
            xmax = 328.753 
            text = "" 
        intervals [120]:
            xmin = 328.753 
            xmax = 332.966 
