        intervals [2]:
            xmin = 26.843 
            xmax = 33.722 
            text = "dray un tsvontsikster merts nayntsn hundert akht un nayntsik. intervyu mit madam Aranka Knopfler Gold," 
        intervals [3]:
            xmin = 33.722 
            xmax = 34.2 
            text = "" 
        intervals [4]:
            xmin = 34.2 
            xmax = 38.767 
            text = "Evi Frukhter in Antverpn, BELGIUM, in yidish." 
        intervals [5]:
            xmin = 38.767 
            xmax = 40.562 
            text = "" 
        intervals [6]:
            xmin = 40.562 
            xmax = 46.985 
            text = "mayn nomen iz Evi Frukhter. undz ze'mir haynt montik dem dray un tsvontsikstn merts nayntsn hundert akht un nayntsik." 
        intervals [7]:
            xmin = 46.985 
            xmax = 46.992 
            text = "" 
        intervals [8]:
            xmin = 46.992 
            xmax = 52.689 
            text = "ikh halt an intervyu mit madam Aranka Knopfler eh in Antverpn Belgyen." 
        intervals [9]:
            xmin = 52.689 
            xmax = 56.104 
            text = "" 
        intervals [10]:
            xmin = 56.104 
            xmax = 58.68 
            text = "madam, ir vilt bite nokh a mol zogn ayer nomen?" 
        intervals [11]:
            xmin = 58.68 
            xmax = 72.135 
            text = "" 
        intervals [12]:
            xmin = 72.135 
            xmax = 74.643 
            text = "ir kent bukhshtabirn Pishpeklodan?" 
