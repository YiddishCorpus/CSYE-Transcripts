            xmax = 124.296 
            text = "" 
        intervals [60]:
            xmin = 124.296 
            xmax = 127.735 
            text = "un dem sof, vi azoy ikh bin, kh'hob oyfgehert mit im," 
        intervals [61]:
            xmin = 127.735 
            xmax = 129.73 
            text = "veys ikh... dos iz geven akht un draysik," 
        intervals [62]:
            xmin = 129.73 
