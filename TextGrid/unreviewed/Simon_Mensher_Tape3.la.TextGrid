        intervals [2]:
            xmin = 0.249 
            xmax = 5.726 
            text = "uh, ikh, ikh antshuldik zikh. ikh, hm, ikh muz zogn vegn eyn epizod," 
        intervals [3]:
            xmin = 5.726 
            xmax = 5.8 
            text = "" 
        intervals [4]:
            xmin = 5.8 
            xmax = 8.139 
            text = "az nayntsn akht un draysik" 
        intervals [5]:
            xmin = 8.139 
            xmax = 8.23 
            text = "" 
        intervals [6]:
            xmin = 8.23 
            xmax = 10.82 
            text = "iz mir gevo- ze'mir gevor gevorn in KRAKOW" 
        intervals [7]:
            xmin = 10.82 
            xmax = 13.337 
            text = "az se kumt a eshelon fun Daytshland," 
        intervals [8]:
            xmin = 13.337 
            xmax = 13.427 
            text = "" 
        intervals [9]:
            xmin = 13.427 
            xmax = 16.644 
            text = "vos eltere mentshn, froyen un mener," 
        intervals [10]:
            xmin = 16.644 
            xmax = 16.853 
            text = "" 
        intervals [11]:
            xmin = 16.853 
            xmax = 21.583 
            text = "uh, UNK brengt, brengt, brengt men zey tsu der poylisher grenets." 
        intervals [12]:
            xmin = 21.583 
            xmax = 24.12 
            text = "fun KRAKOW keyn Katevits," 
        intervals [13]:
            xmin = 24.12 
            xmax = 24.227 
            text = "" 
        intervals [14]:
            xmin = 24.227 
            xmax = 27.354 
            text = "in KRÓLEWSKA HUTA, Katevits, Shlezyen," 
        intervals [15]:
            xmin = 27.354 
            xmax = 31.94 
            text = "iz a mehalekh mistam fun tsvey hundert kilometer. ze'mir gekumen tsu forn ahin a sakh yidn," 
        intervals [16]:
            xmin = 31.94 
            xmax = 34.534 
            text = "un oykhet in di shtet hobn gevoynt zeyer a sakh yidn." 
        intervals [17]:
            xmin = 34.534 
            xmax = 36.602 
            text = "iz ongekumen take a eshelon" 
        intervals [18]:
            xmin = 36.602 
            xmax = 39.555 
            text = "bay der grenets un yunge daytshn..." 
        intervals [19]:
            xmin = 39.555 
            xmax = 42.525 
            text = "a sakh zenen zey geven brunetn, enlekh tsu yidn..." 
        intervals [20]:
            xmin = 42.525 
            xmax = 45.469 
            text = "yunge akhtsn-yerike Hitler-yugnt mit shtekenes:" 
        intervals [21]:
            xmin = 45.469 
            xmax = 47.322 
            text = """RAUS, JUDEN! RAUS, JUDEN!""" 
        intervals [22]:
            xmin = 47.322 
            xmax = 47.363 
            text = "" 
        intervals [23]:
            xmin = 47.363 
            xmax = 52.92 
            text = "un m'hot aroysgetribn bay di zeks hundert yidn, oysgetun biz der helft naket," 
        intervals [24]:
            xmin = 52.92 
            xmax = 55.811 
            text = "un oyf der pleytse oysgeshnitn a haknkreyts." 
        intervals [25]:
            xmin = 55.811 
            xmax = 55.902 
            text = "" 
        intervals [26]:
            xmin = 55.902 
            xmax = 58.933 
            text = "di mentshn zenen geven faryomert mit geveyn," 
        intervals [27]:
            xmin = 58.933 
            xmax = 59.023 
            text = "" 
        intervals [28]:
            xmin = 59.023 
            xmax = 61.796 
            text = "on shikh, in eyn shukh un UNK shukh." 
        intervals [29]:
            xmin = 61.796 
            xmax = 63.911 
            text = "yeder hot genemen a mentsh." 
        intervals [30]:
            xmin = 63.911 
            xmax = 64.643 
            text = "" 
        intervals [31]:
            xmin = 64.643 
            xmax = 69.986 
            text = "polyakim afile zenen geshtanen... dort iz geven a shtarke komunistishe PARTEI, nayntsn akht un draysik..." 
        intervals [32]:
            xmin = 69.986 
            xmax = 70.11 
            text = "" 
        intervals [33]:
            xmin = 70.11 
            xmax = 73.45 
            text = "un yidn m<it> <UNK>s. m'hot tsuzamengenemen gelt," 
        intervals [34]:
            xmin = 73.45 
            xmax = 76.975 
            text = "un yeder hot genemen di yidn epes helfn, aheymnemen zey." 
        intervals [35]:
            xmin = 76.975 
            xmax = 80.314 
            text = "ikh hob genemen a hoykhn yid, hot er geheysn <SELINGER>." 
        intervals [36]:
            xmin = 80.314 
            xmax = 80.674 
            text = "" 
        intervals [37]:
            xmin = 80.674 
            xmax = 83.992 
            text = "er hot ibergelozt a fabrik. er hot keynem nisht gehat: eyner aleyn." 
        intervals [38]:
            xmin = 83.992 
            xmax = 83.998 
            text = "" 
        intervals [39]:
            xmin = 83.998 
            xmax = 87.218 
            text = "hob ikh im gebrakht tsu firn keyn KRAKOW tsu der baleboste." 
        intervals [40]:
            xmin = 87.218 
            xmax = 89.547 
            text = "ikh bin dokh fun Kosev, dos iz Galitsyen," 
        intervals [41]:
            xmin = 89.547 
            xmax = 91.181 
            text = "un KRAKOW iz vayt," 
        intervals [42]:
            xmin = 91.181 
            xmax = 91.204 
            text = "" 
        intervals [43]:
            xmin = 91.204 
            xmax = 93.459 
            text = "nor ikh fleg forn ahin mit di TEPPICHer." 
        intervals [44]:
            xmin = 93.459 
            xmax = 93.668 
            text = "" 
        intervals [45]:
            xmin = 93.668 
            xmax = 97.09 
            text = "iz bay der baleboste vu ikh hob gegesn kosher" 
        intervals [46]:
            xmin = 97.09 
            xmax = 97.279 
            text = "" 
        intervals [47]:
            xmin = 97.279 
            xmax = 99.174 
            text = "un ikh hob gehat a dire," 
        intervals [48]:
            xmin = 99.174 
            xmax = 103.384 
            text = "hob ikh im gebrakht ahin un <ikh hob> gezogt der baleboste, ""na dir gelt""... kh'hob gehat, ikh bin geven," 
        intervals [49]:
            xmin = 103.384 
            xmax = 106.909 
            text = "ikh hob gekent alts tun. <ikh hob gehat> a sakh, a sakh gelt gehat..." 
        intervals [50]:
            xmin = 106.909 
            xmax = 107.202 
            text = "" 
        intervals [51]:
            xmin = 107.202 
            xmax = 110.691 
            text = "un <m- az zi> zol im koyfn ontsutun, zol im koyfn vesh," 
        intervals [52]:
            xmin = 110.691 
            xmax = 114.165 
            text = "un zol im gebn zeks khadoshim tsu esn, un shpeter vel ikh vayter tsushikn." 
        intervals [53]:
            xmin = 114.165 
            xmax = 114.525 
            text = "" 
        intervals [54]:
            xmin = 114.525 
            xmax = 118.94 
            text = "hot er mir gezogt, ""MEIN UNK SOHN, ICH HABE BIS JETZT NICHT GEWUSST DAS ICH JUDE BIN.""" 
        intervals [55]:
