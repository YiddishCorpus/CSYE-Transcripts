            text = "di beste demokratye iz geven dortn." 
        intervals [73]:
            xmin = 156.9 
            xmax = 160.54 
            text = "m'hot koydem geboyt shtiber far di arbetorer, un d- un dernokh di fabrik." 
        intervals [74]:
            xmin = 160.54 
            xmax = 164.058 
            text = "zenen di polyakim g<UNK> hobn genemen dray rayonen: Bogumin," 
        intervals [75]:
            xmin = 164.058 
            xmax = 168.79 
            text = "<Tsheshine> UNK... Bogumin, <Tsheshine>... dem dritn gedenk ikh nisht." 
        intervals [76]:
            xmin = 168.79 
            xmax = 170.71 
            text = "ikh bin geven oykh mobilizirt." 
        intervals [77]:
            xmin = 170.71 
            xmax = 173.98 
            text = "mir zenen gegangen... di tshekh<n> hobn nisht gegebn keyn eyn shos." 
        intervals [78]:
            xmin = 173.98 
            xmax = 177.322 
            text = "zey hobn gekent undz gut gebn petsh; zey zenen geven beser" 
        intervals [79]:
            xmin = 177.322 
