            text = "dos iz nokh Varshe an ort..." 
        intervals [96]:
            xmin = 203.748 
            xmax = 207.939 
            text = "ikh bin a artilerist, nor keyn artilerye iz shoyn nisht gevezn. m'hot undz gegebn biksn." 
        intervals [97]:
