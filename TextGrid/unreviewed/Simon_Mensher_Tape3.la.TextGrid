            xmin = 149.98 
            xmax = 150.047 
            text = "" 
        intervals [71]:
            xmin = 150.047 
            xmax = 154.71 
            text = "a folk vos zenen geven di b- di beste antviklte industryal," 
        intervals [72]:
            xmin = 154.71 
