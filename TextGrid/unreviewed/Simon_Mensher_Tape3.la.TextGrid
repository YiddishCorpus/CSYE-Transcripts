            xmax = 119.2 
            text = "" 
        intervals [56]:
            xmin = 119.2 
            xmax = 121.894 
            text = """mayn zun, ikh hob biz aher nisht gevust az ikh bin a yid.""" 
        intervals [57]:
            xmin = 121.894 
