            xmax = 146.807 
            text = "" 
        intervals [23]:
            xmin = 146.807 
            xmax = 154.29 
            text = "VY KOGDA-NIBUD' INTERESOVALIS', VOT, uh, PYTALIS' UZNAT', GDE IMENNO POGIB VASH OTETS?" 
