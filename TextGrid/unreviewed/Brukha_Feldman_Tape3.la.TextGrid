            text = "" 
        intervals [4]:
            xmin = 5.412 
            xmax = 6.924 
            text = "U FEL'DMAN BRUKHI." 
        intervals [5]:
            xmin = 6.924 
            xmax = 7.504 
            text = "" 
        intervals [6]:
            xmin = 7.504 
            xmax = 12.088 
            text = "INTERV'YU BERЁT LEONID SAPOZHNIKOV. MY NAKHODIMSYA V GORODE BERSHAD' V UKRAINE." 
        intervals [7]:
            xmin = 12.088 
            xmax = 12.499 
            text = "" 
        intervals [8]:
            xmin = 12.499 
            xmax = 16.526 
            text = "YAZYK INTERV'YU: IDISH I RUSSKIY. KASSETA NOMER TRI." 
        intervals [9]:
            xmin = 16.526 
            xmax = 19.873 
            text = "" 
        intervals [10]:
            xmin = 19.873 
            xmax = 22.837 
            text = "BRUNYA, VOT KAK VY SCHITAETE," 
        intervals [11]:
            xmin = 22.837 
            xmax = 22.86 
            text = "" 
        intervals [12]:
            xmin = 22.86 
            xmax = 25.841 
            text = "uh, KONECHNO ETO BYLO DETSTVO VASHE," 
