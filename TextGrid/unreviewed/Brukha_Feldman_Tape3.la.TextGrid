        intervals [137]:
            xmin = 872.061 
            xmax = 880.73 
            text = "PROYDЁT MNOGO VREMENI I MOZHET BYT' KAKOY-TO UCHЁNYY ILI ISTORIK ILI SLEDOVATEL' ZAKHOCHET, uh, UVIDET' LYUBUYU KASSETU I POPADЁT NA VASHU," 
