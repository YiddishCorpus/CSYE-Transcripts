            text = "" 
        intervals [27]:
            xmin = 192.083 
            xmax = 194.982 
            text = "VY KAK BY, VASHA SEM'YA KAK BY PROZHILA" 
        intervals [28]:
            xmin = 194.982 
            xmax = 196.391 
            text = "DVE ZHIZNI:" 
        intervals [29]:
            xmin = 196.391 
            xmax = 199.151 
            text = "ODNU MALEN'KUYU, KOGDA BYL OTETS," 
        intervals [30]:
            xmin = 199.151 
            xmax = 207.197 
            text = "KOGDA BYL OTETS, I ODNU BOL'SHUYU, KOTORAYA NACHALAS' S VOYNOY I, MOZHNO SKAZAT', PRODOLZHAETSYA PO SEGODNYASHNIY DEN', uh, ETA ZHIZN'." 
