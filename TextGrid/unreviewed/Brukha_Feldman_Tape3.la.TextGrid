            xmin = 25.841 
            xmax = 26.05 
            text = "" 
        intervals [14]:
            xmin = 26.05 
            xmax = 27.394 
            text = "VREMYA GETTO," 
        intervals [15]:
            xmin = 27.394 
            xmax = 27.535 
            text = "" 
        intervals [16]:
            xmin = 27.535 
            xmax = 34.52 
            text = "NO ONO SYGRALO KAKUYU-TO ROL'<, uh, V,> OTRITSATEL'NUYU V VASHEY DAL'NEYSHEY ZHIZNI?" 
        intervals [17]:
            xmin = 34.52 
            xmax = 39.51 
            text = "VED' GODY GETTO POLOMALI, uh, ZHIZN' SEM'I: OTETS POGIB." 
        intervals [18]:
            xmin = 39.51 
            xmax = 44.842 
            text = "ESLI BY NE BYLO VOYNY, ESLI BY KAK-TO PO-DRUGOMU SLOZHILAS' ISTORIYA, MOGLO BYT' PO-DRUGOMU U VAS?" 
        intervals [19]:
            xmin = 44.842 
            xmax = 87.711 
            text = "" 
        intervals [20]:
            xmin = 87.711 
            xmax = 89.29 
            text = "SKAZHITE, VASHA MAMA," 
