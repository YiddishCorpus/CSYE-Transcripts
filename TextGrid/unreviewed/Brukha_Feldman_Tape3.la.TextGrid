        intervals [2]:
            xmin = 0.619 
            xmax = 5.38 
            text = "<-ODNYA> VTOROE NOYABRYA TYSYACHA DEVYAT'SOT DEVYANOSTO SED'MOGO GODA. MY BERЁМ INTERV'YU" 
