        intervals [129]:
            xmin = 837.028 
            xmax = 843.32 
            text = "BRUNYA, PONIMAETE, uh, DELO V TOM, CHTO MY S VAMI VSTRETILIS' DLYA TOGO, CHTOBY VY RASSKAZALI O SVOEY ZHIZNI," 
        intervals [130]:
