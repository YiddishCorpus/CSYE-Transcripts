            xmax = 896.855 
            text = "MOGLI SKAZAT' VOT LYUDYAM, KOTORYE KOGDA-NIBUD' CHEREZ DVADTSAT', TRIDTSAT', SOROK LET, MOZHET BYT' BOL'SHE," 
