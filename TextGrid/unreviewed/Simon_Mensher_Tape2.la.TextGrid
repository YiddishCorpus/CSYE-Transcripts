            text = "di beheymes un ale, un dortn makhn puter un brindze" 
        intervals [39]:
            xmin = 74.46 
            xmax = 77.287 
            text = "un kez, <un m-> firn es mit di ferd farkoyfn," 
        intervals [40]:
            xmin = 77.287 
            xmax = 78.814 
            text = "un undz fleg men tsoln derfar." 
        intervals [41]:
            xmin = 78.814 
            xmax = 82.777 
            text = "ABER trots dem hobn mir bashlosn tsu forn ahin vu der tate iz geboyrn gevorn." 
        intervals [42]:
