            xmin = 104.647 
            xmax = 104.67 
            text = "" 
        intervals [54]:
            xmin = 104.67 
            xmax = 108.472 
            text = "di tsvey hundert fuftsik kilometer, farshidene stantsyes," 
        intervals [55]:
            xmin = 108.472 
            xmax = 112.894 
            text = "iz di letste stantsye fun dem shtetele Milnits IVANE-PUSTE." 
        intervals [56]:
            xmin = 112.894 
            xmax = 115.448 
            text = "dos iz dray kilometer fun dem shtetl." 
        intervals [57]:
            xmin = 115.448 
            xmax = 115.588 
            text = "" 
        intervals [58]:
            xmin = 115.588 
            xmax = 119.598 
            text = "hot men mir g- genemen, ale beheymes tsuzamengebunen mit a shtrik," 
        intervals [59]:
            xmin = 119.598 
            xmax = 119.638 
            text = "" 
        intervals [60]:
            xmin = 119.638 
            xmax = 122.87 
            text = "un m'hot gezogt mir... ikh bin shoyn a yingl fun akht yor..." 
        intervals [61]:
            xmin = 122.87 
