            xmax = 82.986 
            text = "" 
        intervals [43]:
            xmin = 82.986 
            xmax = 86.931 
            text = "vi azoy m'hot getribn di beheymes keyn Kolomey tsu der stantsye" 
        intervals [44]:
            xmin = 86.931 
            xmax = 88.768 
            text = "gedenk ikh nisht; kh'bin geven a kind." 
        intervals [45]:
            xmin = 88.768 
            xmax = 88.808 
            text = "" 
        intervals [46]:
            xmin = 88.808 
            xmax = 92.902 
            text = "ABER m'hot genemen a groysn vagon, a PUL'MAN fun zekhtsik ton," 
        intervals [47]:
            xmin = 92.902 
            xmax = 92.959 
            text = "" 
        intervals [48]:
            xmin = 92.959 
            xmax = 96.49 
            text = "di groyse, di, uh, vos me firt, uh, beheymes," 
        intervals [49]:
            xmin = 96.49 
            xmax = 99.047 
            text = "un mir zenen arayngegangen oykhet ahin" 
        intervals [50]:
            xmin = 99.047 
            xmax = 102.672 
            text = "mit di finef beheymes. dos iz gevezn undzer farmegn fun dortn." 
        intervals [51]:
            xmin = 102.672 
            xmax = 102.814 
            text = "" 
        intervals [52]:
            xmin = 102.814 
            xmax = 104.647 
            text = "az ze'mir gekumen tsu geyn" 
