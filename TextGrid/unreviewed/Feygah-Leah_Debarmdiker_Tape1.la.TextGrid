            text = "" 
        intervals [137]:
            xmin = 478.958 
            xmax = 481.027 
            text = "ikh hob es geshribn in yidish-daytsh." 
        intervals [138]:
            xmin = 481.027 
            xmax = 481.27 
            text = "" 
        intervals [139]:
            xmin = 481.27 
            xmax = 486.832 
            text = "nisht oyf rumenish nisht, gor veynik oyf rumenish. daytsh iz geven di shprakh un s'geblibn fun Estraykh." 
        intervals [140]:
            xmin = 486.832 
            xmax = 486.889 
            text = "" 
        intervals [141]:
            xmin = 486.889 
            xmax = 488.582 
            text = "s'hot geheysn a vokabl-heft" 
        intervals [142]:
            xmin = 488.582 
            xmax = 493.987 
            text = "un fun dem ho'mir in der heym gelernt un nokh fleg di lererin undz farhern tsi undz ho'mir farshtanen dem," 
        intervals [143]:
            xmin = 493.987 
            xmax = 494.297 
            text = "" 
        intervals [144]:
            xmin = 494.297 
            xmax = 500.183 
            text = "nokh hot zi undz dertseylt biblishe geshikhte. zi iz geven fun Vin, zi hot shtudirt in Vin," 
        intervals [145]:
            xmin = 500.183 
            xmax = 503.943 
            text = "ire lerer iz geven dort Dokter Doytshlender, m'hot avade fun im gehert." 
