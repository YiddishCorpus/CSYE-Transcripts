        intervals [404]:
            xmin = 1320.058 
            xmax = 1326.383 
            text = "bokherim, mayn man iz geven a bokher fun zibetsn yor ven hot er gelernt in Vizhnits." 
        intervals [405]:
            xmin = 1326.383 
            xmax = 1336.455 
            text = "mayne brider zenen geven zeks zibn yerike kinder, hot men nokh nisht UNK. di andere iz nor, oder iz ver s'geven raykh un er iz geven a guter kop, hot men untershtitst tsu forn keyn Poyln, keyn Lublin." 
        intervals [406]:
            xmin = 1336.455 
