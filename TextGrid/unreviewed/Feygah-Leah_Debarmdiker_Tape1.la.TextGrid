        intervals [460]:
            xmin = 1480.641 
            xmax = 1486.839 
            text = "eh shinen azoy vi UNK, dos hot men geleygt di breter un fun dem roykh iz tsaytvayz opgerunen, dos iz geshtanen dos hot men genutst a gants" 
        intervals [461]:
            xmin = 1486.839 
            xmax = 1491.03 
            text = "a gantsn vinter, fun di gendz, vayl m'hot dokh gemuzt mit a mol, s'zol zayn." 
