        intervals [466]:
            xmin = 1498.343 
            xmax = 1506.167 
            text = "ikh veys epes azolkhe min khumres, ikh veys nisht, do erloybt men zikh azoy fil. s'do zakhn vos ikh hob nokh gehaltn bi- biz ikh hob gekent, ober dernokh," 
