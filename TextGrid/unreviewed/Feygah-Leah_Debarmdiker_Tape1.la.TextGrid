        intervals [2]:
            xmin = 91.221 
            xmax = 96.786 
            text = "koydem kol vil ikh UNK danken dem Eybershtn az ikh hob derlebt, ikh bin aroys fun dem fun dem" 
        intervals [3]:
            xmin = 96.786 
            xmax = 98.758 
            text = "gey-tsalmoves, vi azoy m'zogt." 
        intervals [4]:
            xmin = 98.758 
            xmax = 98.933 
            text = "" 
        intervals [5]:
            xmin = 98.933 
            xmax = 102.251 
            text = "tsu redn iber dem iz zeyer zeyer shver." 
        intervals [6]:
            xmin = 102.251 
            xmax = 102.375 
            text = "" 
        intervals [7]:
            xmin = 102.375 
            xmax = 106.284 
            text = "vayl dos iz, di SHOAH iz geven a ibernatirlekhe zakh," 
        intervals [8]:
            xmin = 106.284 
            xmax = 106.493 
            text = "" 
        intervals [9]:
            xmin = 106.493 
            xmax = 109.181 
            text = "vos <hitsert> muz men nisht farshteyn a mol, undz ze'mir," 
        intervals [10]:
            xmin = 109.181 
            xmax = 115.464 
            text = "undz klern, gleybn mit pashtes, s'rirt zikh nisht a bletele, a GARGIR zamd on on a khezhbm." 
        intervals [11]:
            xmin = 115.464 
            xmax = 115.673 
            text = "" 
        intervals [12]:
            xmin = 115.673 
            xmax = 120.378 
            text = "UNK ikh hob mikh nisht gevolt lozn MERAYEN zayn, ober azoy vi ikh hob bakumen dem briv fun di rabonim," 
        intervals [13]:
            xmin = 120.378 
            xmax = 125.268 
            text = "az undz darf'mir gedenken vos Amolek hot undz getun, hob ikh maskem geven." 
        intervals [14]:
            xmin = 125.268 
            xmax = 125.562 
            text = "" 
        intervals [15]:
            xmin = 125.562 
            xmax = 131.664 
            text = "ikh shtam fun der Bukovine. dos iz eh geven a mol Estraykh." 
        intervals [16]:
            xmin = 131.664 
            xmax = 131.974 
            text = "" 
        intervals [17]:
            xmin = 131.974 
            xmax = 135.225 
            text = "di shtot hot geheysn Radoz, dos iz lebn Tshernovits." 
        intervals [18]:
            xmin = 135.225 
            xmax = 136.8 
            text = "" 
        intervals [19]:
            xmin = 136.8 
            xmax = 139.831 
            text = "Radauts, Redevits in yidish." 
        intervals [20]:
            xmin = 139.831 
            xmax = 141.458 
            text = "" 
        intervals [21]:
            xmin = 141.458 
            xmax = 147.004 
            text = "a shtetl, a yidish shtetl, ikh meyn mit eh yidishe balebatim." 
        intervals [22]:
            xmin = 147.004 
            xmax = 147.904 
            text = "" 
        intervals [23]:
            xmin = 147.904 
            xmax = 155.323 
            text = "geven eh balbatim vos hobn geshikt afile di kinder keyn Lublin in in di yeshives. undz aleyn iz iz nisht geven keyn yeshives in" 
        intervals [24]:
            xmin = 155.323 
            xmax = 155.65 
            text = "" 
        intervals [25]:
            xmin = 155.65 
            xmax = 161.364 
            text = "in shtot, SO un den di eyntsike yeshive vos hot ekzistirt iz geven Vizhnits un dortn zenen" 
        intervals [26]:
            xmin = 161.364 
            xmax = 161.505 
            text = "" 
        intervals [27]:
            xmin = 161.505 
            xmax = 171.624 
            text = "hobn gelernt di ale UNK mayn man un di a- ale UNK, der vos hot gevolt shikn a kind tsu der yeshive hobn geshikt in der Vizhnitser yeshive. dos iz geven nisht vayt fun undz, dos hot nokh gehert tsu der Bukovine." 
        intervals [28]:
            xmin = 171.624 
            xmax = 172.98 
            text = "" 
        intervals [29]:
            xmin = 172.98 
            xmax = 176.551 
            text = "ikh bin geboyrn in JAHRE eyn toyznt nayn hundert finef un tsvontsik." 
        intervals [30]:
            xmin = 176.551 
            xmax = 176.828 
            text = "" 
        intervals [31]:
            xmin = 176.828 
            xmax = 181.057 
            text = "biz tsvelef yor hob ikh gehat borekh-hashem zeyer a sheyne yugnt." 
        intervals [32]:
            xmin = 181.057 
            xmax = 181.249 
            text = "" 
        intervals [33]:
            xmin = 181.249 
            xmax = 186.137 
            text = "sheyne yidishe shtub, a balbate yidishe shtub, undz ze'mir nisht geven keyn milyonern," 
        intervals [34]:
            xmin = 186.137 
            xmax = 186.21 
            text = "" 
        intervals [35]:
            xmin = 186.21 
            xmax = 192.33 
            text = "mayn tate hot gehat a kleyn BETRIEB, vi azoy m'ruft es do, a kleyn BEIT CHAROSHET zog'mir." 
        intervals [36]:
            xmin = 192.33 
            xmax = 193.534 
            text = "" 
        intervals [37]:
            xmin = 193.534 
            xmax = 196.835 
            text = "un m'hot gehat borekh-hashem parnose beshefe." 
        intervals [38]:
            xmin = 196.835 
            xmax = 197.382 
            text = "" 
        intervals [39]:
            xmin = 197.382 
            xmax = 202.742 
            text = "anfang, als yung kind, iz nokh nisht geven keyn Beys-Yankev shul, hot iz geven a melamed in shtub." 
        intervals [40]:
            xmin = 202.742 
            xmax = 203.254 
            text = "" 
        intervals [41]:
            xmin = 203.254 
            xmax = 206.454 
            text = "iz dos rov hot er gelernt mit mayne kleyne brider," 
        intervals [42]:
            xmin = 206.454 
            xmax = 206.865 
            text = "" 
        intervals [43]:
            xmin = 206.865 
            xmax = 209.981 
            text = "un tsum alef-beys hot er iz oykh undz gelernt." 
        intervals [44]:
            xmin = 209.981 
            xmax = 210.021 
            text = "" 
        intervals [45]:
            xmin = 210.021 
            xmax = 213.424 
            text = "s'geven a kertse tsayt biz s'hot zikh erefnt di Beys-Yankev shul." 
        intervals [46]:
            xmin = 213.424 
            xmax = 213.987 
            text = "" 
        intervals [47]:
            xmin = 213.987 
            xmax = 219.448 
            text = "ze'mir, ober vos iz geven di BAYA? m'hot gemuzt, s'a flikht geven tsu geyn in di rumenishe folkshuln." 
        intervals [48]:
            xmin = 219.448 
            xmax = 220.551 
            text = "" 
        intervals [49]:
            xmin = 220.551 
            xmax = 224.426 
            text = "ober s'nokh geven a demokratish land, Rumenyen iz demolts nokh geven," 
        intervals [50]:
            xmin = 224.426 
            xmax = 224.668 
            text = "" 
        intervals [51]:
            xmin = 224.668 
            xmax = 228.003 
            text = "m'hot nisht getsvungen tsu gornisht, undz ho'mir nisht gehat keyn shverikeytn." 
        intervals [52]:
            xmin = 228.003 
            xmax = 228.043 
            text = "" 
        intervals [53]:
            xmin = 228.043 
            xmax = 231.159 
            text = "gekent eh gemuzt afile shabes geyn in shul." 
        intervals [54]:
            xmin = 231.159 
            xmax = 232.937 
            text = "" 
        intervals [55]:
            xmin = 232.937 
            xmax = 238.077 
            text = "s'geven a sakh shuln, a Vizhnitser shul, a Byaler shul," 
        intervals [56]:
            xmin = 238.077 
            xmax = 238.084 
            text = "" 
        intervals [57]:
            xmin = 238.084 
            xmax = 242.448 
            text = "un m'hot gehat etlekhe rabonim fun farshidene krayzn." 
        intervals [58]:
            xmin = 242.448 
            xmax = 243.045 
            text = "" 
        intervals [59]:
            xmin = 243.045 
            xmax = 251.631 
            text = "s'geven oykh eh mer moderne int- eh institutn, tsum bayshpil zeyer sheyne yidishe gebayde un a sheyne yidishe kultur's gemeyn-" 
        intervals [60]:
            xmin = 251.631 
            xmax = 253.603 
            text = "kultur's gemeynde, heyst eh," 
        intervals [61]:
            xmin = 253.603 
            xmax = 256.326 
            text = "" 
        intervals [62]:
            xmin = 256.326 
            xmax = 262.406 
            text = "der rosh-akool iz dort gezesn, mit di mit di di firer fun der shtot, zog mir. dos vos hot geheysn di kultur's gemeynde." 
        intervals [63]:
            xmin = 262.406 
            xmax = 264.167 
            text = "dort hot men zikh gelernt in a," 
        intervals [64]:
            xmin = 264.167 
            xmax = 264.966 
            text = "" 
        intervals [65]:
            xmin = 264.966 
            xmax = 269.769 
            text = "biz biz JAHRE nayn un draysik hobn ongehoybn di umruen." 
        intervals [66]:
            xmin = 269.769 
            xmax = 269.775 
            text = "" 
        intervals [67]:
            xmin = 269.775 
            xmax = 270.562 
            text = "vos," 
        intervals [68]:
            xmin = 270.562 
            xmax = 282.263 
            text = "" 
        intervals [69]:
            xmin = 282.263 
            xmax = 287.01 
            text = "nomen fun rabonim nisht, ober dem grinder fun der Beys-Yankev shul yo." 
        intervals [70]:
            xmin = 287.01 
            xmax = 290.93 
            text = "er hot geheysn reb Dovid Yosef Hekht zikhroyne-livrokhe." 
        intervals [71]:
            xmin = 290.93 
            xmax = 291.055 
            text = "" 
        intervals [72]:
            xmin = 291.055 
            xmax = 296.882 
            text = "er iz geven a groyser oysher un a kinderlozer mentsh. er hot gebay- er hot geboyt di Beys-Yankev shul" 
        intervals [73]:
            xmin = 296.882 
            xmax = 303.249 
            text = "un a shul in zelbn hoyf, un er hot dos zeyer untershtitst. er hot gebrakht a lererin fun Vin," 
        intervals [74]:
            xmin = 303.249 
            xmax = 303.88 
            text = "" 
        intervals [75]:
            xmin = 303.88 
            xmax = 308.008 
            text = "un un azoy s'geven di aynfal eh, yo." 
        intervals [76]:
            xmin = 308.008 
            xmax = 308.098 
            text = "" 
        intervals [77]:
            xmin = 308.098 
            xmax = 310.015 
            text = "fun vi azoy s'hot zikh gegrindet." 
        intervals [78]:
            xmin = 310.015 
            xmax = 310.258 
            text = "" 
        intervals [79]:
            xmin = 310.258 
            xmax = 318.701 
            text = "ober vos iz geven, s'geven tsvishn take tsvishn undzer oylem iz geven fil UNK, m'hot moyre gehat far yeder nayer zakh hot men moyre gehat." 
        intervals [80]:
            xmin = 318.701 
            xmax = 322.641 
            text = "ober vos, mayn tate olev-asholem flegt er farshteyn az di kinder darfn hobn," 
        intervals [81]:
            xmin = 322.641 
            xmax = 324.861 
            text = "iz er geven tsvishn di ershte fun undz ze'mir gegangen," 
        intervals [82]:
            xmin = 324.861 
            xmax = 328.241 
            text = "nokh vos der tate arayn in komite, komite heyst vaad." 
        intervals [83]:
            xmin = 328.241 
            xmax = 328.315 
            text = "" 
        intervals [84]:
            xmin = 328.315 
            xmax = 331.245 
            text = "iz geven zeyer tetik az di shul zol" 
        intervals [85]:
            xmin = 331.245 
            xmax = 331.555 
            text = "" 
        intervals [86]:
            xmin = 331.555 
            xmax = 335.323 
            text = "zol bashteyn, un take borekh-hashem s'hot zikh gemert un gemert." 
        intervals [87]:
            xmin = 335.323 
            xmax = 341.702 
            text = "iz ale yidishe kinder fun ale krayzn, s'geven iz geven a draysik fertsik kinder." 
        intervals [88]:
            xmin = 341.702 
            xmax = 345.841 
            text = "un dos iz azoy geven. far eh far mitog ze'mir gegangen in der folkshul in der rumenisher," 
        intervals [89]:
            xmin = 345.841 
            xmax = 346.017 
            text = "" 
        intervals [90]:
            xmin = 346.017 
            xmax = 350.983 
            text = "nokh mitog iz geven eyn lererin far ale KITOT, hot yeder gelernt a sho andert halbn." 
        intervals [91]:
            xmin = 350.983 
            xmax = 355.224 
            text = "undz ho'mir geheysn tsvishn di groyse, ikh bin alt geven demolts draytsn fertsn yor." 
        intervals [92]:
            xmin = 355.224 
            xmax = 355.855 
            text = "" 
        intervals [93]:
            xmin = 355.855 
            xmax = 359.412 
            text = "undz yen- kleyne kinder hot men getsvungen tsu lernen." 
        intervals [94]:
            xmin = 359.412 
            xmax = 363.673 
            text = "undz ho'mir gevolt lernen. undz fleg'mir di lererin biz vu zi hot gevoynt," 
        intervals [95]:
            xmin = 363.673 
            xmax = 366.888 
            text = "un dermit zol undz alts dertseyln, vos Sore Shnirer, v-" 
        intervals [96]:
