            text = "" 
        intervals [421]:
            xmin = 1375.037 
            xmax = 1379.447 
            text = "m'fleg kashern di mil, dos iz geven dem tog fun moln veyts. nokh hot men bahandlt dos UNK." 
        intervals [422]:
            xmin = 1379.447 
