            text = "" 
        intervals [401]:
            xmin = 1311.553 
            xmax = 1317.785 
            text = "a groys, s'geven, neyn. yeshives nisht geven, nor khadorim, talmed-toyres, iz geven etlekhe." 
        intervals [402]:
            xmin = 1317.785 
