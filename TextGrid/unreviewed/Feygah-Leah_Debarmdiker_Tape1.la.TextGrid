        intervals [424]:
            xmin = 1382.192 
            xmax = 1387.906 
            text = "bay mayn mume, bay der zol zikh mien. zi hot groyse tsimern, flegn zikh tsunoyfnemen etlekhe balebatim oyf etlekhe erter," 
        intervals [425]:
            xmin = 1387.906 
