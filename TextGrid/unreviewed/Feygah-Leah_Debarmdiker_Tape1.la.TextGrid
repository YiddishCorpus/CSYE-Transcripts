            xmax = 370.496 
            text = "ze'mir geven zeyer zeyer vayt, undz ho'mir fun gornisht gevust." 
        intervals [97]:
            xmin = 370.496 
            xmax = 370.84 
            text = "" 
        intervals [98]:
            xmin = 370.84 
            xmax = 375.863 
            text = "zi hot dertseylt di gantse antshtelung fun Beys-Yankev shul, vi azoy s'gevorn, vos Sore Shnirer." 
        intervals [99]:
            xmin = 375.863 
            xmax = 376.577 
