        intervals [398]:
            xmin = 1304.938 
            xmax = 1308.234 
            text = "a groys s'iz nisht tseshtert, s'shoyn geven mentshn dortn oyf keyver-oves." 
        intervals [399]:
            xmin = 1308.234 
