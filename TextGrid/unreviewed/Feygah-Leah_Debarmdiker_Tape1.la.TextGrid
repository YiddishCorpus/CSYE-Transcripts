            text = "" 
        intervals [409]:
            xmin = 1339.752 
            xmax = 1340.347 
            text = "yo." 
        intervals [410]:
            xmin = 1340.347 
            xmax = 1341.908 
            text = "di vos hobn gehat gresere kinder." 
        intervals [411]:
            xmin = 1341.908 
            xmax = 1345.331 
            text = "bay undz iz dos nokh nisht geven vayl m'hot undz avekgeshikt keyn Kresnist." 
        intervals [412]:
            xmin = 1345.331 
            xmax = 1348.054 
            text = "" 
        intervals [413]:
            xmin = 1348.054 
            xmax = 1355.434 
            text = "purim, peysekh in shtot, iber bakn matses ken ikh dertseyln un dertseyln." 
        intervals [414]:
            xmin = 1355.434 
            xmax = 1358.766 
            text = "dos iz geven mamesh avoydas hakoydesh. hot zikh ongehoybn fun zumer." 
        intervals [415]:
            xmin = 1358.766 
            xmax = 1365.682 
            text = "fleg men geyn azoy vi do sh- v- veyts, trikenen veyts, in di felder, nor dos iz geven normale tsayt." 
        intervals [416]:
            xmin = 1365.682 
            xmax = 1365.688 
            text = "" 
        intervals [417]:
            xmin = 1365.688 
            xmax = 1370.677 
            text = "nokh fleg men geyn far peysekh kashern di mil, dos iz geven oyser di shtot, a groyse mil." 
        intervals [418]:
            xmin = 1370.677 
            xmax = 1371.021 
            text = "" 
        intervals [419]:
            xmin = 1371.021 
            xmax = 1375.031 
            text = "flegn zikh tsunoyfnemen ale yidishe yidn fun ale, un geyn mitn rov." 
