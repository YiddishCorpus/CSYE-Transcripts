            text = "" 
        intervals [160]:
            xmin = 550.845 
            xmax = 556.306 
            text = "zi hot nisht gekent gebn dos vos zi hot undz gegebn far a kind vos hot gedarft lernen alef-beys. undz ho'mir gelernt shpeter oyf UNK." 
        intervals [161]:
            xmin = 556.306 
            xmax = 557.292 
            text = "" 
        intervals [162]:
            xmin = 557.292 
            xmax = 559.564 
            text = "un dan iz geven a bisl DIKDUK." 
        intervals [163]:
            xmin = 559.564 
            xmax = 560.987 
            text = "" 
        intervals [164]:
            xmin = 560.987 
            xmax = 568.777 
            text = "vos nokh ho'mir gehat, yo, s'flegt kumen a yontev iz geven eh di dinim fun yontev," 
        intervals [165]:
            xmin = 568.777 
            xmax = 568.952 
            text = "" 
        intervals [166]:
            xmin = 568.952 
            xmax = 573.84 
            text = "un eh farshidene farshidene, far vos der yontev iz un far vos alts." 
        intervals [167]:
            xmin = 573.84 
            xmax = 573.947 
            text = "" 
        intervals [168]:
            xmin = 573.947 
            xmax = 579.597 
            text = "un tfile, oyf dem hot zi oyf, dos davenen. dos hot zi geleygt zeyer in DAGESH. undz zol'mir" 
        intervals [169]:
            xmin = 579.597 
            xmax = 585.461 
            text = "visn di iberzetsung fun a shmoyne-esre, vort bay, undz zol'mir visn vos undz zog'mir." 
        intervals [170]:
            xmin = 585.461 
            xmax = 587.992 
            text = "oyf dem hot zi zeyer gegebn der kleyne tsayt" 
        intervals [171]:
            xmin = 587.992 
            xmax = 592.031 
            text = "hot undz gevolt gebn di TAMTZIOT vos a yidishe tokhter visn." 
        intervals [172]:
            xmin = 592.031 
            xmax = 592.813 
            text = "" 
        intervals [173]:
            xmin = 592.813 
            xmax = 595.996 
            text = "khuts mize ho'mir zi zeyer zeyer lib gehat." 
        intervals [174]:
            xmin = 595.996 
            xmax = 596.087 
            text = "" 
        intervals [175]:
            xmin = 596.087 
            xmax = 599.928 
            text = "zi hot gehat zeyer a zeyer tsugenglekhe shprakh." 
        intervals [176]:
            xmin = 599.928 
            xmax = 599.968 
            text = "" 
        intervals [177]:
            xmin = 599.968 
            xmax = 610.56 
            text = "undz hobn gezogt di mame yedes vort vos zi hot undz gezogt, fleg'mir, vi m'zogt, klingen azoy vi vaser. un dos iz dos iz geven undzer fundament, mit dem bisl vos dortn geblibn bin ikh geblibn." 
        intervals [178]:
            xmin = 610.56 
            xmax = 610.92 
            text = "" 
        intervals [179]:
            xmin = 610.92 
            xmax = 613.718 
            text = "dos letste hob ikh gelernt fun mayne kinder do in Erets-Yisroel." 
        intervals [180]:
            xmin = 613.718 
            xmax = 616.466 
            text = "ikh fleg oyshern vi zey flegn makhn SHIURIM, mit UNK." 
        intervals [181]:
            xmin = 616.466 
            xmax = 616.54 
            text = "" 
        intervals [182]:
            xmin = 616.54 
            xmax = 620.62 
            text = "dos iz geven undzer fundament. un s'geven ober azoy min shtark." 
        intervals [183]:
            xmin = 620.62 
            xmax = 622.007 
            text = "" 
        intervals [184]:
            xmin = 622.007 
            xmax = 626.405 
            text = "khuts mize az bay undz geven di emune pshute zeyer groys." 
        intervals [185]:
            xmin = 626.405 
            xmax = 626.597 
            text = "" 
        intervals [186]:
            xmin = 626.597 
            xmax = 631.231 
            text = "m'hot gehaltn shabes mit ale DIKDUKIM. bay undz iz geven zeyer shtarke keltn." 
        intervals [187]:
            xmin = 631.231 
            xmax = 631.643 
            text = "" 
        intervals [188]:
            xmin = 631.643 
            xmax = 632.306 
            text = "un s-" 
        intervals [189]:
            xmin = 632.306 
            xmax = 636.604 
            text = "" 
        intervals [190]:
            xmin = 636.604 
            xmax = 641.106 
            text = "shabes, koydem hot men geshlosn di verkshtat" 
        intervals [191]:
            xmin = 641.106 
            xmax = 645.373 
            text = "a halbn tog farn, fraytik tsu mitog hot men geshlosn di verkshtat." 
        intervals [192]:
            xmin = 645.373 
            xmax = 646.003 
            text = "" 
        intervals [193]:
            xmin = 646.003 
            xmax = 649.797 
            text = "hot men tsu ordenen gemakht in hoyf s'zol zikh nisht derkenen az s'iz avek geshlosn oyf" 
        intervals [194]:
            xmin = 649.797 
            xmax = 653.894 
            text = "toyer un shlisl. s'nor geblibn di shtub, di sheyne gortn, di sheyne hoyf," 
        intervals [195]:
            xmin = 653.894 
            xmax = 654.036 
            text = "" 
        intervals [196]:
            xmin = 654.036 
            xmax = 658.614 
            text = "un m'hot zikh m'iz gegangen in mikve, m'hot gehat a sheyn bod a sheynem." 
        intervals [197]:
            xmin = 658.614 
            xmax = 665.235 
            text = "yi- di yidn hobn dos geboyt. s'geven a shtats-bod ober di yidn hobn es geboyt. far vos, vayl zey hobn gedarft hobn di andere rituele vayl yo." 
        intervals [198]:
            xmin = 665.235 
            xmax = 666.439 
            text = "" 
        intervals [199]:
            xmin = 666.439 
            xmax = 670.258 
            text = "der tate flegt nemen di yinglekh in mikve, m'hot zikh ongetun shabesdik." 
        intervals [200]:
            xmin = 670.258 
            xmax = 675.596 
            text = "nokh iz er genumen tsvey brider UNK zenen geven kleyne kinder, zey genumen mitgenumen in shul," 
        intervals [201]:
            xmin = 675.596 
            xmax = 675.602 
            text = "" 
        intervals [202]:
            xmin = 675.602 
            xmax = 678.802 
            text = "mit di peyekelekh, mit di sheyne dray-fertl hoyzn." 
        intervals [203]:
            xmin = 678.802 
            xmax = 679.112 
            text = "" 
        intervals [204]:
            xmin = 679.112 
            xmax = 682.835 
            text = "un a mame azoy vi a yidish- di shtub hot geblishet." 
        intervals [205]:
            xmin = 682.835 
            xmax = 682.875 
            text = "" 
        intervals [206]:
            xmin = 682.875 
            xmax = 687.926 
            text = "dos vayse tishtekh un di sheyne vayse bahenger, tsum bayshpil," 
        intervals [207]:
            xmin = 687.926 
            xmax = 692.457 
            text = "bay undz iz geven a sakh hant-arbet. m'hot basheftikt di yidishe tokhter in shtub mit hant-arbet." 
        intervals [208]:
            xmin = 692.457 
            xmax = 694.884 
            text = "on a shir, di bayshpil alts iz geven bahongen," 
        intervals [209]:
            xmin = 694.884 
            xmax = 694.975 
            text = "" 
        intervals [210]:
            xmin = 694.975 
            xmax = 698.866 
            text = "tsum bayshpil eyn iz geven aza eh" 
        intervals [211]:
            xmin = 698.866 
            xmax = 699.413 
            text = "" 
        intervals [212]:
            xmin = 699.413 
            xmax = 704.827 
            text = "azoy vi a tishte- dos iz geven azoy vi a mats- a a khale-tishtekhl, oyfgehongen bay di vant," 
        intervals [213]:
            xmin = 704.827 
            xmax = 706.264 
            text = "" 
        intervals [214]:
            xmin = 706.264 
            xmax = 711.441 
            text = "milkhiks f- vos iz geven iber di shafkele vu s'geven shoyn. UNK s'nokh geven andere mine shafkelekh." 
        intervals [215]:
            xmin = 711.441 
            xmax = 716.872 
            text = "milkhiks fun fleyshik vet men sheydn, vet aykh der Eybershter hitn fun tsores un laydn." 
        intervals [216]:
            xmin = 716.872 
            xmax = 717.402 
            text = "" 
        intervals [217]:
            xmin = 717.402 
            xmax = 721.395 
            text = "dos iz geven ibern shafke un dos iz geven hant-arbet vunder sheyn oysgeneyt." 
        intervals [218]:
            xmin = 721.395 
            xmax = 722.228 
            text = "" 
        intervals [219]:
            xmin = 722.228 
            xmax = 729.903 
            text = "nokh s'geven a mineg az fun vi lang fun yungvayz on hot men dos kind gelernt <oysshtey>. m'flegt koyfn layvnt" 
        intervals [220]:
            xmin = 729.903 
            xmax = 734.687 
            text = "zikh shtikn aleyn hemder mit mit un vos s'geven. vunder-sheyne arbetn." 
        intervals [221]:
            xmin = 734.687 
            xmax = 737.73 
            text = "UNK. haynt haynt al- makht men alts mit mashin." 
        intervals [222]:
            xmin = 737.73 
            xmax = 738.31 
            text = "" 
        intervals [223]:
            xmin = 738.31 
            xmax = 744.75 
            text = "un eh eh di shabesdike tish vos ken keyner nisht fargesn." 
        intervals [224]:
            xmin = 744.75 
            xmax = 744.992 
            text = "" 
        intervals [225]:
            xmin = 744.992 
            xmax = 748.111 
            text = "vel ikh aykh dertseyln an interesante sakh, dos darfn doyres visn." 
        intervals [226]:
            xmin = 748.111 
            xmax = 756.41 
            text = "bay undz in shtetl fleg men az der tate fleg kumen fun shul fleg er tomed mitbrengen gest. mame iz tomed geven gerokhtn vayl s'flegn kumen farshidene" 
        intervals [227]:
            xmin = 756.41 
            xmax = 756.417 
            text = "" 
        intervals [228]:
            xmin = 756.417 
            xmax = 759.144 
            text = "flegn farshi- s'geven a sakh pleytim vos hobn" 
        intervals [229]:
            xmin = 759.144 
            xmax = 759.319 
            text = "" 
        intervals [230]:
            xmin = 759.319 
            xmax = 764.387 
            text = "zenen antlofn funem militer bahaltene, s'mentshn vos hobn nisht gehat keyn MAKOM vu tsu zayn." 
        intervals [231]:
            xmin = 764.387 
            xmax = 768.749 
            text = "khuts mize iz dos kashres geven shver. s'geven UNK hobn gezukht a yidishe shtub." 
        intervals [232]:
            xmin = 768.749 
            xmax = 772.644 
            text = "fleg men kumen in shul in yeder yid hot mitgenumen an oyrekh." 
        intervals [233]:
            xmin = 772.644 
            xmax = 772.752 
            text = "" 
        intervals [234]:
            xmin = 772.752 
            xmax = 775.457 
            text = "khuts mize iz bay undz geven a bitere zakh." 
        intervals [235]:
            xmin = 775.457 
            xmax = 779.934 
            text = "s'geven a, azoy heyst UNK nor vi azoy zogt men, a kazarme," 
        intervals [236]:
            xmin = 779.934 
            xmax = 780.109 
            text = "" 
        intervals [237]:
            xmin = 780.109 
            xmax = 782.704 
            text = "vi heyst a kazarm? MACHANE TZVAI." 
        intervals [238]:
            xmin = 782.704 
            xmax = 785.506 
            text = "oyser di shtot. a groyse MACHANE TZVAI funem gants land," 
        intervals [239]:
            xmin = 785.506 
            xmax = 789.8 
            text = "dort hot men genumen di rekrutn, dos heyst di vos geyen nor vos in militer." 
        intervals [240]:
            xmin = 789.8 
            xmax = 792.877 
            text = "demolts hot men genumen yidn oykh, s'geven demokratish." 
        intervals [241]:
            xmin = 792.877 
            xmax = 792.9 
            text = "" 
        intervals [242]:
            xmin = 792.9 
            xmax = 797.546 
            text = "vifl zey hobn zikh gekent oyskoyfn, antloyfn un bahaltn UNK, ober s'geven azolkhe" 
        intervals [243]:
            xmin = 797.546 
            xmax = 802.125 
            text = "bokherim fun di yeshive shtarke fun farshidene fun der gantser umgegung." 
        intervals [244]:
            xmin = 802.125 
            xmax = 802.182 
            text = "" 
        intervals [245]:
            xmin = 802.182 
            xmax = 807.035 
            text = "bay undz iz geven der tsenterum, s'geven a groys feld un mir flegn makhn IMUNIM." 
        intervals [246]:
            xmin = 807.035 
            xmax = 807.868 
            text = "" 
        intervals [247]:
            xmin = 807.868 
            xmax = 813.819 
            text = "di soldatn, vifl zey hobn gekent flegn zey araynkumen in shul, vifl nisht fleg der tate olev-asholem, di zkhus UNK," 
        intervals [248]:
            xmin = 813.819 
            xmax = 814.129 
            text = "" 
        intervals [249]:
            xmin = 814.129 
            xmax = 817.65 
            text = "MESHACHED zayn ofitsirn, ofitsirn vi azoy heyst dos, KATZINIM," 
        intervals [250]:
            xmin = 817.65 
            xmax = 817.69 
            text = "" 
        intervals [251]:
            xmin = 817.69 
            xmax = 820.164 
            text = "zoln aroyslozn di yidn oyf shabes." 
        intervals [252]:
            xmin = 820.164 
            xmax = 820.626 
            text = "" 
        intervals [253]:
            xmin = 820.626 
            xmax = 829.634 
            text = "fleg der tate aheymkumen mit CHAYALIM. s'geven azoy min MUZAR, nor s'nisht geven keyn brey- breyre. flegn kumen yidn mit eh berd oykhet gest farshidene." 
        intervals [254]:
            xmin = 829.634 
            xmax = 831.268 
            text = "un flegn kumen CHAYALIM." 
        intervals [255]:
            xmin = 831.268 
            xmax = 832.59 
            text = "" 
        intervals [256]:
            xmin = 832.59 
            xmax = 839.48 
            text = "un di CHAYALIM, eyner iz gek- dos ershte vi lang s'nokh geven UNK tsu lozn di peyes, nor dernokh fleg men mit gevald tsu opshern di peyes." 
        intervals [257]:
            xmin = 839.48 
            xmax = 843.817 
            text = "iz eyner iz gekumen nokh dem un m'hot im opgeshoyrn di peyes. ikh vel dos in lebn nisht fargesn." 
        intervals [258]:
            xmin = 843.817 
            xmax = 847.783 
            text = "der bokher hot gegosn fun mit trern, er iz geven fun Kluzh," 
        intervals [259]:
            xmin = 847.783 
            xmax = 851.377 
            text = "fun a raykher a shtub, nor vos, er iz geven zeyer a fester, a hoykher." 
        intervals [260]:
            xmin = 851.377 
            xmax = 853.661 
            text = "vorshaynlekh zey hobn zikh nisht gekent oyskoyfn." 
        intervals [261]:
            xmin = 853.661 
            xmax = 853.92 
            text = "" 
        intervals [262]:
            xmin = 853.92 
            xmax = 858.909 
            text = "hot er gegosn mit trern, er hot zikh nisht gekent far far veytik vos m'hot im opgeshnitn di peyes." 
        intervals [263]:
            xmin = 858.909 
            xmax = 859.185 
            text = "" 
        intervals [264]:
            xmin = 859.185 
            xmax = 865.713 
            text = "azoy az bay undz iz geven a shtub shabes mamesh az groyse sheyn tish mit gest un," 
        intervals [265]:
            xmin = 865.713 
            xmax = 870.958 
            text = "mame ole-hasholem hot zeyer gearbet un undz ho'mir nisht vayl zi hot nisht gelozt az mir zol'mir nisht oysknetn di khale." 
        intervals [266]:
            xmin = 870.958 
            xmax = 870.981 
            text = "" 
        intervals [267]:
            xmin = 870.981 
            xmax = 874.842 
            text = "un azolkhe zakhn bay di kekh hot zi nisht gevolt, zi hot zi gemuzt ales aleyn." 
        intervals [268]:
            xmin = 874.842 
            xmax = 879.142 
            text = "nokh iz geven a mineg, ikh hob im shoyn etlekhe mol dertseylt, nor ikh vil im vayter dertseyln." 
        intervals [269]:
            xmin = 879.142 
            xmax = 879.553 
            text = "" 
        intervals [270]:
            xmin = 879.553 
            xmax = 885.723 
            text = "bay undz fleg men bakn aleyn broyt un khale un ales, mir ho'mir gornisht gekoyft. ales mishum kashres." 
        intervals [271]:
            xmin = 885.723 
            xmax = 886.557 
            text = "" 
        intervals [272]:
            xmin = 886.557 
            xmax = 891.093 
            text = "un az di mame ole- dos vel ikh keyn mol nisht fargesn, m'hot gebakn khale un broyt un" 
        intervals [273]:
            xmin = 891.093 
            xmax = 895.691 
            text = "kukhn eh farshidene. bay undz iz geven kukurits mel iz geven di" 
        intervals [274]:
            xmin = 895.691 
            xmax = 901.024 
            text = "OCHEL fun di fun AMAMI, nor di yidn flegn es oykh nitsn, nor di yidn flegn es makhn mit tsuker, mit ayer." 
        intervals [275]:
            xmin = 901.024 
            xmax = 902.902 
            text = "undz flegn gebn afile tsum kidesh." 
        intervals [276]:
            xmin = 902.902 
            xmax = 903.381 
            text = "" 
        intervals [277]:
            xmin = 903.381 
            xmax = 906.423 
            text = "s'geven a groyse tish un di mame hot genumen khale." 
        intervals [278]:
            xmin = 906.423 
            xmax = 909.503 
            text = "un ikh vel dos keyn mol nisht fargesn dos bild. di mame zi hot genumen khale," 
        intervals [279]:
            xmin = 909.503 
            xmax = 913.469 
            text = "koydem hot men gezen m'hot avekgeshikt di dinst, zi zol nisht in shtub demolts." 
        intervals [280]:
            xmin = 913.469 
            xmax = 920.025 
            text = "hot zi geleygt oyf dem iz geven a sheyn vays tish, m'hot geleygt ale UNK, azoy oyfn tish," 
        intervals [281]:
            xmin = 920.025 
            xmax = 921.704 
            text = "a sheyn vays tishtekh deroyf," 
        intervals [282]:
            xmin = 921.704 
            xmax = 925.937 
            text = "mame hot zikh ongetun dos shirtsele fun khale-lekht-tsindn un dos vayse tikhele," 
        intervals [283]:
            xmin = 925.937 
            xmax = 926.078 
            text = "" 
        intervals [284]:
            xmin = 926.078 
            xmax = 932.94 
            text = "un m'hot genumen khale.  ikh zog aykh, ven s'do a mayle un m'tseylt dos bild vi azoy, mamesh a a avoyde." 
        intervals [285]:
            xmin = 932.94 
            xmax = 933.891 
            text = "" 
        intervals [286]:
            xmin = 933.891 
            xmax = 939.319 
            text = "m'hot genumen, bay undz fleg men zogn, genumen a shtikl fun yedn khale un gezogt 'borekh hu uborekh shmoy', bay aykh hot dos oykh bakant?" 
        intervals [287]:
            xmin = 939.319 
            xmax = 939.375 
            text = "" 
        intervals [288]:
            xmin = 939.375 
            xmax = 942.992 
            text = "iber ale, untern tishtekh, 'borekh hu uborekh shmoy'," 
        intervals [289]:
            xmin = 942.992 
            xmax = 944.972 
            text = "un dernokh 'lehafrish khale'." 
        intervals [290]:
            xmin = 944.972 
            xmax = 944.995 
            text = "" 
        intervals [291]:
            xmin = 944.995 
            xmax = 952.628 
            text = "un dernokh tkhines, gebetn far di kinder, zoln vaksn, zoln zayn talmide-khakhomim, gegosn trern." 
        intervals [292]:
            xmin = 952.628 
            xmax = 956.143 
            text = "un der Eybershter zol hitn fun tsores, vayl s'hot shoyn ongehoybn di unruen." 
        intervals [293]:
            xmin = 956.143 
            xmax = 956.301 
            text = "" 
        intervals [294]:
            xmin = 956.301 
            xmax = 961.006 
            text = "un undz kinderlekh fleg'mir bay shteyn arum der mame, vayl dernokh baym knetn" 
        intervals [295]:
            xmin = 961.006 
            xmax = 968.279 
            text = "az undz ze'mir geven voyl, undz ze'mir yunge meydelekh, hot zi ongetun s'zol kholile nisht araynfaln a hor in teyg, ontun tikhelekh, gut farbindn dos hor," 
        intervals [296]:
            xmin = 968.279 
            xmax = 970.487 
            text = "un undz gebn yedn a shtikele teyg." 
        intervals [297]:
            xmin = 970.487 
            xmax = 970.948 
            text = "" 
        intervals [298]:
            xmin = 970.948 
            xmax = 975.088 
            text = "az undz zol'mir, ven zi hot ibergemakht di khales zol'mir mitmakhn." 
        intervals [299]:
            xmin = 975.088 
            xmax = 982.772 
            text = "iz vos iz geven? dem tate olev-asho- s'geven aza aza mineg bay undz, er iz nisht geven keyn rebe, nor m'hot gemakht a yud-beys khale, a sheyne yud-veys khale, UNK." 
        intervals [300]:
            xmin = 982.772 
            xmax = 982.812 
            text = "" 
        intervals [301]:
            xmin = 982.812 
            xmax = 985.517 
            text = "un far di brider iz geven kleyne bekelekh," 
        intervals [302]:
            xmin = 985.517 
            xmax = 990.281 
            text = "iz di meydelekh hobn gemakht far di brider yud-beys khales azelkhe kleyne, dos iz geven undzer arbet." 
        intervals [303]:
            xmin = 990.281 
            xmax = 990.456 
            text = "" 
        intervals [304]:
            xmin = 990.456 
            xmax = 994.938 
            text = "azoy hot men langzam hot men tsugetsoygn di yugnt az m'zol lib hobn di mitsve." 
        intervals [305]:
            xmin = 994.938 
            xmax = 995.097 
            text = "" 
        intervals [306]:
            xmin = 995.097 
            xmax = 999.388 
            text = "di eh di libshaft tsu di mitsve. dos iz geven ayngepreglt in di beyner." 
        intervals [307]:
            xmin = 999.388 
            xmax = 1003.159 
            text = "ad hayom, azoy ikh gey nisht khale-nemen on on lekht-tsindn shirtsl." 
        intervals [308]:
            xmin = 1003.159 
            xmax = 1011.184 
            text = "ikh veys eh eh ven s'zet mikh emetser, ikh tu es bederkh klal ven s- nisht un f- un afile ven yo, ikh hob mikh nisht vos tsu shemen, nor" 
        intervals [309]:
            xmin = 1011.184 
            xmax = 1015.796 
            text = "gelernt ikh hob es als kind, do hob ikh es nisht gezen. ikh ken mikh derfun nisht opgevoynen." 
        intervals [310]:
            xmin = 1015.796 
            xmax = 1016.663 
            text = "" 
        intervals [311]:
            xmin = 1016.663 
            xmax = 1022.616 
            text = "ober vos iz geven derfun? azoy hot ayngelernt di ayngepreglt dos yidishkeyt in di kinder." 
        intervals [312]:
            xmin = 1022.616 
            xmax = 1027.541 
            text = "tsum bayshpil, bay undz hot men kosher gemakht fleysh, undz hobn genutst nor oyfn fleysh, undz ho'mir nisht genutst keyn rindern fleysh" 
        intervals [313]:
            xmin = 1027.541 
            xmax = 1027.598 
            text = "" 
        intervals [314]:
            xmin = 1027.598 
            xmax = 1030.834 
            text = "ale yorn vos undz hobn gelebt in di Bukovine, far vos?" 
        intervals [315]:
            xmin = 1030.834 
            xmax = 1035.019 
            text = "vayl dos iz hot men gemuzt shekhtn oyser di shtot in in eh" 
        intervals [316]:
            xmin = 1035.019 
            xmax = 1042.239 
            text = "fun di IRYA vi azoy m'zogt iz geven a groys shekht-hoyz. hot men geshokhtn far di gantse shtot. dort flegn shekhtn ehm shokhtim." 
        intervals [317]:
            xmin = 1042.239 
            xmax = 1042.482 
            text = "" 
        intervals [318]:
            xmin = 1042.482 
            xmax = 1048.992 
            text = "ober s'iz zeyer zeyer shver geven di bdikes m'zol oysfirn azoy vi m'hot gevolt hobn mehadrin lemehadrin s'zol zayn kosher iz es geven shver," 
        intervals [319]:
            xmin = 1048.992 
            xmax = 1053.582 
            text = "ho'mir tsvontsik yor iber iber tsvontsik ho'mir gelebt in di Bukovine undz ho'mir nisht gegesn keyn rindern fleysh, nor of." 
        intervals [320]:
            xmin = 1053.582 
            xmax = 1060.045 
            text = "hitst iz azoy. a of hot men gekoyft in in SHUK un m'iz gegangen tsum shoykhet, oykhet geven shokh- fir shokhtim." 
        intervals [321]:
            xmin = 1060.045 
            xmax = 1061.682 
            text = "hot men nisht geshokhtn bay yedn." 
        intervals [322]:
            xmin = 1061.682 
            xmax = 1066.162 
            text = "eyner hot, shtelt zikh for vi azoy m'hot medakdek geven. eyner hot gehat a zun" 
        intervals [323]:
            xmin = 1066.162 
            xmax = 1072.547 
            text = "vos er iz geforn als CHALUTZ fun in dakht zikh mir a bisl a frayheyt partey keyn Erets-Yisroel, hot men shoyn bay im nisht geshokhtn." 
        intervals [324]:
            xmin = 1072.547 
            xmax = 1073.582 
            text = "" 
        intervals [325]:
            xmin = 1073.582 
            xmax = 1075.972 
            text = "ad kedey kakh iz geven di DIKDUK." 
        intervals [326]:
            xmin = 1075.972 
            xmax = 1076.265 
            text = "" 
        intervals [327]:
            xmin = 1076.265 
            xmax = 1080.022 
            text = "yetst az di mame hot kosher gemakht, fleg'mir oykh zitsn arings un arum," 
        intervals [328]:
            xmin = 1080.022 
            xmax = 1080.923 
            text = "" 
        intervals [329]:
            xmin = 1080.923 
            xmax = 1083.493 
            text = "hot zi genumen dos kosher-bretl," 
        intervals [330]:
            xmin = 1083.493 
            xmax = 1087.295 
            text = "bay undz hot men afile dos kepele genutst, vayl s'zeyer shver tsu bakumen a," 
        intervals [331]:
            xmin = 1087.295 
            xmax = 1087.605 
            text = "" 
        intervals [332]:
            xmin = 1087.605 
            xmax = 1092.031 
            text = "vi azoy m'makht kosher an of, hob ikh shoyn geven a kind, m'hot nisht gelozt kosher makhn." 
        intervals [333]:
            xmin = 1092.031 
            xmax = 1094.453 
            text = "fleg mir shteyn UNK hot gezogt azoy m'heybt on azoy." 
        intervals [334]:
            xmin = 1094.453 
            xmax = 1097.741 
            text = "m'shnaydt op di fiselekh, di shpits fun di negl darf men opshnaydn." 
        intervals [335]:
            xmin = 1097.741 
            xmax = 1097.798 
            text = "" 
        intervals [336]:
            xmin = 1097.798 
            xmax = 1102.418 
            text = "nokh leygt men es oyf azoy, un m'efnt es un m'nemt glaykhtntsam aroys ales." 
        intervals [337]:
            xmin = 1102.418 
            xmax = 1107.866 
            text = "un m'bakukt koydem tsi s'nishto tsvey leberlekh oder tsvey," 
        intervals [338]:
            xmin = 1107.866 
            xmax = 1107.906 
            text = "" 
        intervals [339]:
            xmin = 1107.906 
            xmax = 1112.358 
            text = "dinim gelernt, vos ikh hob zey gelernt fun di mame azoy fun a Shulkhn-Orekh." 
        intervals [340]:
            xmin = 1112.358 
            xmax = 1115.707 
            text = "nokh iz bay undz geven a groyse zakh, zeyer oyfes zenen geven fray," 
        intervals [341]:
            xmin = 1115.707 
            xmax = 1123.729 
            text = "flegn zey eh kloybn vos s'hot zikh gelozt un az s'geven a mol dos vaser iz nisht geven gut, flegn zey bakumen pokn oyf di kishkes." 
        intervals [342]:
            xmin = 1123.729 
            xmax = 1123.819 
            text = "" 
        intervals [343]:
            xmin = 1123.819 
            xmax = 1126.428 
            text = "fleg undz di mame UNK dos iz a pok," 
        intervals [344]:
            xmin = 1126.428 
            xmax = 1126.89 
            text = "" 
        intervals [345]:
            xmin = 1126.89 
            xmax = 1131.491 
            text = "un nokh hot men geefnt dem dem dem KURKUVAN, vi azoy heyst dos, dos pupikl," 
        intervals [346]:
            xmin = 1131.491 
            xmax = 1131.7 
            text = "" 
        intervals [347]:
            xmin = 1131.7 
            xmax = 1136.16 
            text = "dos iz geven a gantse BAYA, ven m'hot es geefnt, UNK geven bay dos efenen," 
        intervals [348]:
            xmin = 1136.16 
            xmax = 1139.574 
            text = "un dernokh ken men haltn azoy, zen tsi s'nishto a shteyndele" 
        intervals [349]:
            xmin = 1139.574 
            xmax = 1139.58 
            text = "" 
        intervals [350]:
            xmin = 1139.58 
            xmax = 1145.615 
            text = "oder a nodele, vayl zey flegn ales oyfkloybn. bay undz iz geven a verkshtat, undz hobn gehat di hiner oykh fun fun tomer iz nisht geven tsu koyfn." 
        intervals [351]:
            xmin = 1145.615 
            xmax = 1146.28 
            text = "" 
        intervals [352]:
            xmin = 1146.28 
            xmax = 1150.594 
            text = "tomer iz geven a shayle hot men ge- shoyn als kind hob ikh gevust, mame dos iz a shayle." 
        intervals [353]:
            xmin = 1150.594 
            xmax = 1150.903 
            text = "" 
        intervals [354]:
            xmin = 1150.903 
            xmax = 1156.283 
            text = "dos hob ikh shoyn gevust afile, tomer iz der nodl vos zi hot ayngeshlungen nisht derkhgeshtokhn derkh un derkh vet es zayn kosher." 
        intervals [355]:
            xmin = 1156.283 
            xmax = 1159.351 
            text = "nor aleyn hot men nisht gepasket, m'iz gegangen tsum rov." 
        intervals [356]:
            xmin = 1159.351 
            xmax = 1159.898 
            text = "" 
        intervals [357]:
            xmin = 1159.898 
            xmax = 1163.216 
            text = "nokh iz geven ir hert, ir veyst nisht vos dos heyst, do varft men avek" 
        intervals [358]:
            xmin = 1163.216 
            xmax = 1163.256 
            text = "" 
        intervals [359]:
            xmin = 1163.256 
            xmax = 1168.298 
            text = "dos kepl un dos kepl iz geven a gantser yikhes, vayl s'hot gemakht gut di tam fun di zupe." 
        intervals [360]:
            xmin = 1168.298 
            xmax = 1172.129 
            text = "kosher makhn a kepl iz mamesh darf men zayn a groyser fakhman." 
        intervals [361]:
            xmin = 1172.129 
            xmax = 1176.812 
            text = "s'iz nisht di tsayt ikh zol dertseyln. un undz m'hot dos ales gelernt, tsurikkukndik," 
        intervals [362]:
            xmin = 1176.812 
            xmax = 1182.557 
            text = "bay der mame ven zi zi hot dos oyfn tish iz geven a bretl kosher tsu makhn," 
        intervals [363]:
            xmin = 1182.557 
            xmax = 1190.556 
            text = "un azoy eh redndik stam hot zi undz oytomatish ho'mir gelernt kosher tsu makhn an of un vi azoy tsu zaltsn." 
        intervals [364]:
            xmin = 1190.556 
            xmax = 1195.481 
            text = "ven zi hot ven ikh bin geven far di khasene hob ikh shoyn gedarft aleyn zal- neyn, shoyn als meydl fleg zi mikh lozn." 
        intervals [365]:
            xmin = 1195.481 
            xmax = 1195.875 
            text = "" 
        intervals [366]:
            xmin = 1195.875 
            xmax = 1201.533 
            text = "hot zi koydem dermit, bay undz fleg men nisht zaltsn azoy vi do azoy fil, vayl s'hot gedarft zayn azoy vi shney, oyf yedn UNK glaykh." 
        intervals [367]:
            xmin = 1201.533 
            xmax = 1205.862 
            text = "hot zi mir gegebn a shtikl papir, un mir gegebn a bisl zalts in di hent," 
        intervals [368]:
            xmin = 1205.862 
            xmax = 1215.295 
            text = "un hot mikh gelernt vi azoy ikh zol umgeyn mitn zalts az s'zol oyskumen yede zayt glaykh. fun vu onheybn, un vu oyfheybn. vu veyst men dos haynt? m'veyst dos andersh." 
        intervals [369]:
            xmin = 1215.295 
            xmax = 1219.716 
            text = "shoyn, azoy hot zikh undz ayngepreglt dos yidishkeyt fun kindvayz oys," 
        intervals [370]:
            xmin = 1219.716 
            xmax = 1222.937 
            text = "azoy hot di mame getun, azoy ho'mir zikh gefirt." 
        intervals [371]:
            xmin = 1222.937 
            xmax = 1223.196 
            text = "" 
        intervals [372]:
            xmin = 1223.196 
            xmax = 1227.02 
            text = "un eh tsum bayshpil iz geven, vos m'ken nisht azoy azoy," 
        intervals [373]:
            xmin = 1227.02 
            xmax = 1227.415 
            text = "" 
        intervals [374]:
            xmin = 1227.415 
            xmax = 1235.545 
            text = "bay undz iz geven eh tsum bayshpil di MISRA- di verkshtat iz geven fornt in shtub, flegn kumen di sokhrim zikh opforn, oprekhenen," 
        intervals [375]:
            xmin = 1235.545 
            xmax = 1241.786 
            text = "s'geven ekstere shtub, un undz kinder, a mol gresere meydelekh, zogt di mame, ""kinder, az s'do mentshn in shtub" 
        intervals [376]:
            xmin = 1241.786 
            xmax = 1241.961 
            text = "" 
        intervals [377]:
            xmin = 1241.961 
            xmax = 1245.852 
            text = "lakht men nisht azoy hoykh, vos iz dos? shtil, m'tor dokh nisht hern dos kol!""" 
        intervals [378]:
            xmin = 1245.852 
            xmax = 1245.994 
            text = "" 
        intervals [379]:
            xmin = 1245.994 
            xmax = 1251.422 
            text = "fun anfang hot men undz oysgelernt, vos iz azoy m- azoy la- l- la- la- la- lakht a yidishe tokhter?" 
        intervals [380]:
            xmin = 1251.422 
