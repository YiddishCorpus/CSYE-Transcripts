            text = "" 
        intervals [428]:
            xmin = 1391.608 
            xmax = 1396.293 
            text = "mayn olev-asholem iz geven a kintsler baym shibn di matses. yeder hot gehat zayn TAFKID." 
        intervals [429]:
            xmin = 1396.293 
            xmax = 1396.468 
            text = "" 
        intervals [430]:
            xmin = 1396.468 
            xmax = 1403.105 
            text = "ober vos iz geven, s'geven a groyse matses fabrik oykhet far di shtot, unter azoy zeyer a groyse hashgokhe." 
        intervals [431]:
            xmin = 1403.105 
            xmax = 1406.894 
            text = "nor undz ho'mir dos nisht genutst. nokh peysekh hot men genutst far di kinder." 
        intervals [432]:
            xmin = 1406.894 
            xmax = 1410.384 
            text = "iz geven a groyse matse fabrik, vayl Redevits iz normale tsaytn geven" 
        intervals [433]:
            xmin = 1410.384 
