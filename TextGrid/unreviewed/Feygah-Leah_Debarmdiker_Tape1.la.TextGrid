        intervals [103]:
            xmin = 379.035 
            xmax = 380.745 
            text = "" 
        intervals [104]:
            xmin = 380.745 
            xmax = 382.286 
            text = "vos m'hot gelernt? koydem," 
        intervals [105]:
            xmin = 382.286 
            xmax = 383.85 
            text = "" 
        intervals [106]:
            xmin = 383.85 
            xmax = 391.556 
            text = "yo, koydem di ivre vifl der melamed hot tsu undz gelernt hob ikh nor gekent dem alef-beys, vayl ikh bin gevorn a greser meydele hot shoyn der melamed nisht gekent mit undz lernen." 
        intervals [107]:
            xmin = 391.556 
            xmax = 391.562 
            text = "" 
        intervals [108]:
            xmin = 391.562 
            xmax = 394.765 
            text = "alef-beys hot er undz gelernt. nokh hot er shoyn gelernt di Beys-Yankev shul." 
        intervals [109]:
            xmin = 394.765 
            xmax = 396.394 
            text = "hot men ongehoybn tsu lernen ivre," 
        intervals [110]:
            xmin = 396.394 
            xmax = 402.913 
            text = "un a shtunde iz geven iberzetsung. undz ho'mir gezogt moyde-ani mit ales un brokhes ho'mir gekent vayl di mame hot undz gelernt." 
        intervals [111]:
            xmin = 402.913 
            xmax = 403.071 
            text = "" 
        intervals [112]:
            xmin = 403.071 
            xmax = 407.165 
            text = "m'hot nisht gegesn umgebentshn un opgisn di hent iz geven azoy pinktlekh." 
        intervals [113]:
            xmin = 407.165 
            xmax = 407.34 
            text = "" 
        intervals [114]:
            xmin = 407.34 
            xmax = 413.291 
            text = "borekh-hashem iz geven shtark a sheyne yidishe shtub UNK, itst hob ikh nokh farshidene zakhn vos s'ligt mir fun kindheyt" 
        intervals [115]:
            xmin = 413.291 
            xmax = 413.415 
            text = "" 
        intervals [116]:
            xmin = 413.415 
            xmax = 418.505 
            text = "vos hot zikh in zikh azoy fil khumres un ikh veys nisht fun vu s'hot zikh genumen. ikh freg mayn man, zo- di mame hot azoy gelernt." 
        intervals [117]:
            xmin = 418.505 
            xmax = 418.512 
            text = "" 
        intervals [118]:
            xmin = 418.512 
            xmax = 423.484 
            text = "bay undz nisht geven keyn shayle far vos, di mame hot azoy gezogt, di mame hot azoy gelernt." 
        intervals [119]:
            xmin = 423.484 
            xmax = 424.148 
            text = "" 
        intervals [120]:
            xmin = 424.148 
            xmax = 428.27 
            text = "yo. undz ho'mir gehat a goyishe dinst, tsu molt hot di mame gehat a UNK." 
        intervals [121]:
            xmin = 428.27 
            xmax = 433.49 
            text = "flegt zi geyn farklogn di mames, eh di un di hot zikh nokh nisht opgegosn di hent. ad kedey kakh iz es geven." 
        intervals [122]:
            xmin = 433.49 
            xmax = 435.049 
            text = "" 
        intervals [123]:
            xmin = 435.049 
            xmax = 438.755 
            text = "oy, antshuldikts, vos hot ir mikh gefregt? ikh gedenk shoyn nisht di frage." 
        intervals [124]:
            xmin = 438.755 
            xmax = 444.904 
            text = "" 
        intervals [125]:
            xmin = 444.904 
            xmax = 449.871 
            text = "nokh hot men undz gelernt iberzetsn dos bentshn. iz geven a shtunde fun iberzetsung." 
        intervals [126]:
            xmin = 449.871 
            xmax = 454.25 
            text = "farshtey- ikh hob gezogt 'borekh ato hashem hazon es hakoyl'. ikh hob nisht gevust vos heyst 'hazon'." 
        intervals [127]:
            xmin = 454.25 
            xmax = 457.554 
            text = "iz geven a shtunde vos hot geheysn a shtunde fun iberzetsung." 
        intervals [128]:
            xmin = 457.554 
            xmax = 457.56 
            text = "" 
        intervals [129]:
            xmin = 457.56 
            xmax = 461.337 
            text = "ho'mir azoy, iz yedes vort, tsum bayshpil 'borekh' hob ikh gevust heyst eh geloybt." 
        intervals [130]:
            xmin = 461.337 
            xmax = 467.51 
            text = "ober 'hazon' oder nokh tsum bayshpil UNK ho'mir gehat aza vokabl-heft hot es geheysn, undz ho'mir zikh geshribn" 
        intervals [131]:
            xmin = 467.51 
            xmax = 467.55 
            text = "" 
        intervals [132]:
            xmin = 467.55 
            xmax = 471.419 
            text = "un geshribn di iberzetsung az bay di tsveyte shtunde zol men shoyn," 
        intervals [133]:
            xmin = 471.419 
            xmax = 475.796 
            text = "hot undz di lererin farhert tsi undz ken'mir iberzetsn di ershte KETA fun birkas hamozn." 
        intervals [134]:
            xmin = 475.796 
            xmax = 475.954 
            text = "" 
        intervals [135]:
            xmin = 475.954 
            xmax = 478.412 
            text = "azoy langzam langzam," 
        intervals [136]:
