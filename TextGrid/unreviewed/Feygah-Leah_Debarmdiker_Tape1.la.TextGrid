            text = "" 
        intervals [153]:
            xmin = 526.157 
            xmax = 532.313 
            text = "hot zi ongehoybn tsu dertseyln, poshet undz zol'mir oyshern. fun Avrom Ovinu un Yitskhok vi azoy hobn gehat UNK." 
        intervals [154]:
            xmin = 532.313 
            xmax = 538.279 
            text = "s'iz nisht gloybbar haynt far hayntike kinder az mir hot men gedarft dertseyln, a meydl fun tsvelef draytsn yor," 
        intervals [155]:
