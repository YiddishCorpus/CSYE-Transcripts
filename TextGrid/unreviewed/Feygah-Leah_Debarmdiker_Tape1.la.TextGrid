            text = "" 
        intervals [434]:
            xmin = 1410.508 
            xmax = 1414.319 
            text = "a sakh yidishe bafelkerung un zey flegn araynkumen di yidn fun di derfer." 
        intervals [435]:
            xmin = 1414.319 
