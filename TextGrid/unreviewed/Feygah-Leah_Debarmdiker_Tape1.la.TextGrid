            xmax = 504.338 
            text = "" 
        intervals [147]:
            xmin = 504.338 
            xmax = 512.401 
            text = "un eh di Sara Shnirer hot zi gezen oyf di eltere yorn, hot zi gebrakht keyn keyn Vin, hot zi zey koym gezen." 
        intervals [148]:
            xmin = 512.401 
            xmax = 517.775 
            text = "ober di gantse ir gants lernen iz geven oyf daytsh. in daytsher shprakh un iberzetsn." 
        intervals [149]:
            xmin = 517.775 
            xmax = 523.332 
            text = "a sakh fun di shriftn fun harav Hirsh flegt zi undz iberzetsn, s'nokh geven in gontsish a shvere shprakh." 
