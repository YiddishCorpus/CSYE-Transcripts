        intervals [386]:
            xmin = 1275.036 
            xmax = 1279.67 
            text = "tsaytungen fleg mir bakumen fun Tshernovits, Tshernovits iz geven di hoypt-shtot fun di Bukovine." 
        intervals [387]:
            xmin = 1279.67 
            xmax = 1280.065 
            text = "" 
        intervals [388]:
            xmin = 1280.065 
            xmax = 1284.632 
            text = "un dort fleg mir bakumen Tagblat, dakht zikh mir az Taglat hot es geheysn dos yidishe tsaytung, yo." 
        intervals [389]:
            xmin = 1284.632 
            xmax = 1284.688 
            text = "" 
        intervals [390]:
            xmin = 1284.688 
            xmax = 1289.204 
            text = "undz ho'mir nokh nisht gekent azoy gut leyenen, di mame fleg undz forleyenen vi lang undz ze'mir kleyn geven." 
        intervals [391]:
            xmin = 1289.204 
            xmax = 1289.515 
            text = "" 
        intervals [392]:
            xmin = 1289.515 
            xmax = 1293.947 
            text = "un dernokh fleg gegan- fleg bakumen eyn tsaytung fleg es gebn fun eyn shtub in der anderer." 
        intervals [393]:
            xmin = 1293.947 
