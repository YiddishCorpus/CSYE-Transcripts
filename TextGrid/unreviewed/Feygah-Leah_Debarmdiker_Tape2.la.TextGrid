            text = "in eh in ikh veys in tsveytn z- tsveytn zumer geven." 
        intervals [463]:
            xmin = 1266.174 
            xmax = 1271.852 
            text = "ye ts- di rebetsn, di Nadverner rebetsn, vos ikh hob aykh dertseylt vos zi iz geven mit undz in lager." 
        intervals [464]:
            xmin = 1271.852 
            xmax = 1278.674 
            text = "di itstike alte rebetsn zi zol mayrekh-yomim-veshonim zayn. zi iz di mame fun dem Nadverner rebe in Bney Brak." 
        intervals [465]:
