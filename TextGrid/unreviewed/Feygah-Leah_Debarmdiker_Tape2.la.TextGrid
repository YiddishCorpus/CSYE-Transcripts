        intervals [2]:
            xmin = 0.602 
            xmax = 2.337 
            text = "tsvishn di yidn?" 
        intervals [3]:
            xmin = 2.337 
            xmax = 5.996 
            text = "in eh vu ir hot, in di plats, in di shtetl vu ir hot gevoynt," 
        intervals [4]:
            xmin = 5.996 
            xmax = 6.07 
            text = "" 
        intervals [5]:
            xmin = 6.07 
            xmax = 8.983 
            text = "hot ir gehat oykh farbindung mit di goyim dortn?" 
        intervals [6]:
            xmin = 8.983 
            xmax = 11.892 
            text = "" 
        intervals [7]:
            xmin = 11.892 
            xmax = 13.641 
            text = "ir farshteyt nisht vos ikh freg?" 
        intervals [8]:
            xmin = 13.641 
            xmax = 14.203 
            text = "" 
        intervals [9]:
            xmin = 14.203 
            xmax = 18.874 
            text = "ir f- neyn, ikh hob gezogt az ir hot dertseylt" 
        intervals [10]:
            xmin = 18.874 
            xmax = 32.81 
            text = "az mit di yidn hot men hot men gehat shtar- eh shtark in kontakt. m'hot geholfn m'hot ge- a mentsh vos hot nisht gehat oyf shabes, hot ir, dos hot ir getsolt. yo. vos far a farbindung hot ir gehat mit di goyim in di shtetl?" 
        intervals [11]:
            xmin = 32.81 
            xmax = 39.516 
            text = "" 
        intervals [12]:
            xmin = 39.516 
            xmax = 40.421 
            text = "yo." 
        intervals [13]:
            xmin = 40.421 
            xmax = 222.34 
            text = "" 
        intervals [14]:
            xmin = 222.34 
            xmax = 226.468 
            text = "ven hot ir gezen az s- s'kumt a shlekhte tsayt yetst?" 
        intervals [15]:
            xmin = 226.468 
            xmax = 228.415 
            text = "" 
        intervals [16]:
            xmin = 228.415 
            xmax = 230.468 
            text = "biz damolts niks?" 
        intervals [17]:
            xmin = 230.468 
            xmax = 232.06 
            text = "" 
        intervals [18]:
            xmin = 232.06 
            xmax = 234.855 
            text = "vi hot ir dos gefilt, vi hot ir dos gehert?" 
        intervals [19]:
            xmin = 234.855 
            xmax = 272.914 
            text = "" 
        intervals [20]:
            xmin = 272.914 
            xmax = 277.565 
            text = "un ir gedenkt ver hot dos gemakht? di rumenish, di ungarish? di rumener." 
        intervals [21]:
            xmin = 277.565 
            xmax = 347.097 
            text = "" 
        intervals [22]:
            xmin = 347.097 
            xmax = 348.593 
            text = "nogl UNK." 
