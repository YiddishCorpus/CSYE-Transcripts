        intervals [103]:
            xmin = 305.618 
            xmax = 314.01 
            text = "un dortn hot men gebrakht eh di rumener mit alerley, vos ir vilt antisemitn mit goyim, vos iz ales geven oyf di pleytse fun yidn." 
        intervals [104]:
