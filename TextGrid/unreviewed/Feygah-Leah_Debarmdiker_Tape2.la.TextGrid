            xmax = 355.632 
            text = "in hartn fleysh funem fus." 
        intervals [121]:
            xmin = 355.632 
            xmax = 361.707 
            text = "yorn hot er gelitn tomer s'hot zikh oysgeheylt, di di negl zenen arayn a a mazldik s'iz geven oyf a plats" 
