            text = "" 
        intervals [451]:
            xmin = 1233.861 
            xmax = 1240.993 
            text = "meydlekh aleyn hot men nisht gevolt lozn geyn, fleg di rebetsn, di rebetsn, di mame ole-hasholem mit undz zi vil oykh kloybn, m'hot nisht UNK," 
        intervals [452]:
            xmin = 1240.993 
            xmax = 1241.016 
            text = "" 
        intervals [453]:
            xmin = 1241.016 
            xmax = 1243.392 
            text = "mir geyen tsuzamen grupenvayz nokh." 
        intervals [454]:
            xmin = 1243.392 
            xmax = 1246.117 
            text = "un kloybn, zeklekh, kloybn di di zangen." 
        intervals [455]:
            xmin = 1246.117 
            xmax = 1250.167 
            text = "gegangen kumen eyn mol oyf der nakht un m'hot es opge- UNK," 
        intervals [456]:
            xmin = 1250.167 
            xmax = 1255.269 
            text = "tseklopt un m'hot gemakht derfun UNK, dos vos ikh hob aykh dertseylt az di rebetsn un, yo." 
        intervals [457]:
            xmin = 1255.269 
            xmax = 1255.292 
            text = "" 
        intervals [458]:
