            text = "un eh UNK groyse plakatn, Doytshland get heym." 
        intervals [100]:
            xmin = 293.414 
            xmax = 301.699 
            text = "zey hobn ibergegebn, di rumenishe regirung hot zey batsolt far zeyere dires un zey hobn bakumen in Doytshland. dos heyst Bukhnland get heym. dos heyst di bukeviner gebt" 
        intervals [101]:
