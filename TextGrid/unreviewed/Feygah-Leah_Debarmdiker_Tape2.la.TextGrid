            xmax = 473.434 
            text = "nokh dem s'gevorn ongehoybn tsu vern a shtarke panik in der shtot." 
        intervals [161]:
            xmin = 473.434 
            xmax = 473.44 
            text = "" 
        intervals [162]:
            xmin = 473.44 
            xmax = 479.137 
            text = "az a a bay undz flegn zayn a sakh tshares, ir veyst vos heyst tshares, di shvartse feygl, vi azoy heysn zey oyf ivrit?" 
        intervals [163]:
            xmin = 479.137 
            xmax = 480.338 
            text = "" 
        intervals [164]:
            xmin = 480.338 
            xmax = 483.089 
            text = "OR- OR- OR- OR- ORVIM iz geven a sakh." 
        intervals [165]:
            xmin = 483.089 
            xmax = 488.385 
            text = "s'geven a gantse bay di politsey vos zey hobn gemegt trogn eh vafn, eh NESHEK," 
        intervals [166]:
            xmin = 488.385 
            xmax = 488.458 
            text = "" 
        intervals [167]:
            xmin = 488.458 
            xmax = 493.227 
            text = "tsu lernen zikh LIKLOA EL HAMATARA s'iz a di feyglekh zenen gezesn oyfn" 
        intervals [168]:
            xmin = 493.227 
            xmax = 493.453 
            text = "" 
        intervals [169]:
            xmin = 493.453 
            xmax = 496.619 
            text = "oyfn CHASHMAL dortn, aroptsushisn feygl." 
        intervals [170]:
            xmin = 496.619 
            xmax = 496.963 
            text = "" 
        intervals [171]:
            xmin = 496.963 
            xmax = 501.626 
            text = "un dos iz m'hot shoyn gevust, s'hot zikh nisht dershrokn. ober nokh dem vos s'gevorn aza min panik un m'hot gehert" 
        intervals [172]:
            xmin = 501.626 
            xmax = 504.618 
            text = "a koyl shisn, afile nor fun aza dos fun a," 
        intervals [173]:
            xmin = 504.618 
            xmax = 504.945 
            text = "" 
        intervals [174]:
            xmin = 504.945 
            xmax = 509.844 
            text = "iz ale yidn m'hot zikh bahaltn in di in in di in di shtiber, m'iz nisht aroysgega-" 
        intervals [175]:
            xmin = 509.844 
            xmax = 514.831 
            text = "ir hot gefilt di moyre, ir hot zi gekent onkhapn mit di hent. aza min panik." 
        intervals [176]:
            xmin = 514.831 
            xmax = 519.986 
            text = "az ikh bin gekumen keyn Erets-Yisroel, gehert hobn mir, eh fray oder vos UNK hobn zikh arumgeringlt UNK." 
        intervals [177]:
            xmin = 519.986 
            xmax = 525.209 
            text = "ikh bin gekumen shpet, do iz shoyn geven shtil. mikh ongehoybn mir dertseyln, rumenisher, vi azoy s'iz haynt in Rumenye," 
        intervals [178]:
            xmin = 525.209 
            xmax = 530.111 
            text = "hob ikh a bisl gevolt dertseyln, hob ikh koydem azoy mikh gut umgekukt tsi UNK tsi s'hert mikh nisht," 
        intervals [179]:
            xmin = 530.111 
            xmax = 533.596 
            text = "hot zikh eyner zeyer tselakht, vos hot gefilt vos ikh tu, zogt zi bist do in Erets-Yisroel," 
        intervals [180]:
            xmin = 533.596 
            xmax = 539.212 
            text = "do megstu afile oyfn ROSH-MEMSHALA redn, s'vet dir keyner gornisht ton. zi hot gefilt vos ikh tu spn." 
        intervals [181]:
            xmin = 539.212 
            xmax = 539.235 
            text = "" 
        intervals [182]:
            xmin = 539.235 
            xmax = 542.317 
            text = "azoy, neyn, azoy iz dos nokhgelofn der pakhed." 
        intervals [183]:
            xmin = 542.317 
            xmax = 544.045 
            text = "" 
        intervals [184]:
            xmin = 544.045 
            xmax = 547.313 
            text = "un dernokh hot ongehoybn mit undz aroystraybn." 
        intervals [185]:
            xmin = 547.313 
            xmax = 547.555 
            text = "" 
        intervals [186]:
            xmin = 547.555 
            xmax = 549.99 
            text = "ofitsyel m'zol zikh tsugreytn," 
        intervals [187]:
            xmin = 549.99 
            xmax = 556.357 
            text = "in yere eyn un fertsik. dos tsvey yor iz geven unruen azolkhe vos undz hobn gelebt in shreklekhn pakhed, far," 
        intervals [188]:
            xmin = 556.357 
            xmax = 558.237 
            text = "" 
        intervals [189]:
            xmin = 558.237 
            xmax = 560.731 
            text = "zenen gezesn in der heym, vos zey hobn getun, yo." 
        intervals [190]:
            xmin = 560.731 
            xmax = 564.626 
            text = "ikh zog dokh aykh, dos vos hot mir dertseylt fun Beys Yankev, vi azoy m'hot geshlosn di Beys Yankev shul," 
        intervals [191]:
            xmin = 564.626 
            xmax = 564.835 
            text = "" 
        intervals [192]:
            xmin = 564.835 
            xmax = 568.643 
            text = "iz a shtikl tsayt, nisht keyn sakh, s'hot nisht oysgehaltn, di lererin hot gemuzt aheymforn." 
        intervals [193]:
            xmin = 568.643 
            xmax = 569.307 
            text = "" 
        intervals [194]:
            xmin = 569.307 
            xmax = 574.341 
            text = "flegn mir yedes mol bayn an anderer in shtub lernen, un eyne iz geshtanen SHMIRA." 
        intervals [195]:
            xmin = 574.341 
            xmax = 577.243 
            text = "gemakht dem simen tomer iz emetser CHASHUD," 
        intervals [196]:
            xmin = 577.243 
            xmax = 579.392 
            text = "hot men geleygt oyf UNK di hefter," 
        intervals [197]:
            xmin = 579.392 
            xmax = 579.465 
            text = "" 
        intervals [198]:
            xmin = 579.465 
            xmax = 586.347 
            text = "un eh m'iz zikh gegangen shpiln, hot z- m'iz aribergeshprungen a ployt un m'iz avek. dos hot gedoyert a kertse, s'hot nisht oysgehaltn dos oykh nisht." 
        intervals [199]:
            xmin = 586.347 
            xmax = 587.845 
            text = "m'hot dos oykh nisht gekent." 
        intervals [200]:
            xmin = 587.845 
            xmax = 588.325 
            text = "" 
        intervals [201]:
            xmin = 588.325 
            xmax = 591.407 
            text = "nokh fleg men onheybn tsu raysn bay di peyes." 
        intervals [202]:
            xmin = 591.407 
            xmax = 591.902 
            text = "" 
        intervals [203]:
            xmin = 591.902 
            xmax = 593.814 
            text = "eh yo." 
        intervals [204]:
            xmin = 593.814 
            xmax = 596.148 
            text = "nokh dem s'gekumen a gezets optsushern di berd." 
        intervals [205]:
            xmin = 596.148 
            xmax = 597.235 
            text = "" 
        intervals [206]:
            xmin = 597.235 
            xmax = 599.996 
            text = "oy dos iz geven a bitere gere- eh gzeyre!" 
        intervals [207]:
            xmin = 599.996 
            xmax = 601.082 
            text = "" 
        intervals [208]:
            xmin = 601.082 
            xmax = 605.694 
            text = "eh a klal mayn tate borekh-hashem hot oysgefirt, m'hot im m'hot zikh nisht gelozt opshern di bord." 
        intervals [209]:
            xmin = 605.694 
            xmax = 610.242 
            text = "eyner hot zikh fleg fleg zikh ontun a shal, er hot tseyn vey, UNK, yo." 
        intervals [210]:
            xmin = 610.242 
            xmax = 613.642 
            text = "argste vos iz geven, noent farn evakuirn," 
        intervals [211]:
            xmin = 613.642 
            xmax = 616.617 
            text = "di mener hobn nisht getort shlofn in der heym. s'geven" 
        intervals [212]:
            xmin = 616.617 
            xmax = 616.692 
            text = "" 
        intervals [213]:
            xmin = 616.692 
            xmax = 618.711 
            text = "a gemakht azoy vi a geto," 
        intervals [214]:
            xmin = 618.711 
            xmax = 618.733 
            text = "" 
        intervals [215]:
            xmin = 618.733 
            xmax = 623.486 
            text = "dortn yede mol oyf der nakht hobn gemuzt ahinkumen di mener. ikh veys nisht fun akhtsn yor tsi fun vifl." 
        intervals [216]:
            xmin = 623.486 
            xmax = 623.543 
            text = "" 
        intervals [217]:
            xmin = 623.543 
            xmax = 627.413 
            text = "shloft dortn biz in der fri, nokh dem hobn zey gemegt aheymgeyn, m'zol zey hobn" 
        intervals [218]:
            xmin = 627.413 
            xmax = 628.836 
            text = "m'zol zey hobn in di hent." 
        intervals [219]:
            xmin = 628.836 
            xmax = 630.023 
            text = "" 
        intervals [220]:
            xmin = 630.023 
            xmax = 638.808 
            text = "un dernokh eh fleg zayn eh oyf epes UNK yo, dernokh hot zikh ongehoybn der krig Rusland mit Daytshland." 
        intervals [221]:
            xmin = 638.808 
            xmax = 639.49 
            text = "" 
        intervals [222]:
            xmin = 639.49 
            xmax = 643.637 
            text = "iz Rumenye hot dokh nisht gekemft, nor der daytsh." 
        intervals [223]:
            xmin = 643.637 
            xmax = 647.094 
            text = "nor di rusishe, nor vayl s'iz geven a daytshe," 
        intervals [224]:
            xmin = 647.094 
            xmax = 647.1 
            text = "" 
        intervals [225]:
            xmin = 647.1 
            xmax = 651.296 
            text = "s'hot gehert tsum daytsh, flegn di rusn, zenen geven di ershte AVIRONIM" 
        intervals [226]:
            xmin = 651.296 
            xmax = 651.488 
            text = "" 
        intervals [227]:
            xmin = 651.488 
            xmax = 655.768 
            text = "vos zenen gegangen hobn n- nokh in Ridevits ho'mir gekhapt a bombe dermint." 
        intervals [228]:
            xmin = 655.768 
            xmax = 655.96 
            text = "" 
        intervals [229]:
            xmin = 655.96 
            xmax = 658.789 
            text = "vos heyst, in mitn heln tog." 
        intervals [230]:
            xmin = 658.789 
            xmax = 659.453 
            text = "" 
        intervals [231]:
            xmin = 659.453 
            xmax = 662.985 
            text = "azoy vi di feygl, hert di rusn. rusn." 
        intervals [232]:
            xmin = 662.985 
            xmax = 664.678 
            text = "zey hobn zikh aropgelozt niderik," 
        intervals [233]:
            xmin = 664.678 
            xmax = 665.123 
            text = "" 
        intervals [234]:
            xmin = 665.123 
            xmax = 674.904 
            text = "m'hot gezen afile dem roytn shtern. un afile nisht mit keyn bombn, zondern mit mit ralerer, vos heyst ralerer, s'iz a gever azoy vi a katushye mit, s'shist aroys mit a mil a sakh eh" 
        intervals [235]:
            xmin = 674.904 
            xmax = 675.147 
            text = "" 
        intervals [236]:
            xmin = 675.147 
            xmax = 678.803 
            text = "a sakh kuglen. a vi azoy heyst oyfn ivrit? s'hot a nomen." 
        intervals [237]:
            xmin = 678.803 
            xmax = 678.808 
            text = "" 
        intervals [238]:
            xmin = 678.808 
            xmax = 681.657 
            text = "maystns hot es geheysn mit- eh yo, TROROT, yo." 
        intervals [239]:
            xmin = 681.657 
            xmax = 685.299 
            text = "hobn zikh azoy az makhn a GICHA, un araynlozn in a hoyf," 
        intervals [240]:
            xmin = 685.299 
            xmax = 685.558 
            text = "" 
        intervals [241]:
            xmin = 685.558 
            xmax = 688.567 
            text = "un azoy az zey viln mit a zikher shis." 
        intervals [242]:
            xmin = 688.567 
            xmax = 691.29 
            text = "ir hert. der dakh undzerer iz geven tselekhert." 
        intervals [243]:
            xmin = 691.29 
            xmax = 691.448 
            text = "" 
        intervals [244]:
            xmin = 691.448 
            xmax = 694.159 
            text = "dos roy-materyal undzers iz geven zeyer," 
        intervals [245]:
            xmin = 694.159 
            xmax = 694.266 
            text = "" 
        intervals [246]:
            xmin = 694.266 
            xmax = 696.656 
            text = "s'hot zikh gikh ongetsundn, vi azoy heyst eh," 
        intervals [247]:
            xmin = 696.656 
            xmax = 696.696 
            text = "" 
        intervals [248]:
            xmin = 696.696 
            xmax = 697.719 
            text = "DALIK." 
        intervals [249]:
            xmin = 697.719 
            xmax = 697.995 
            text = "" 
        intervals [250]:
            xmin = 697.995 
            xmax = 699.845 
            text = "hot oysgebrokhn a sreyfe." 
        intervals [251]:
            xmin = 699.845 
            xmax = 700.729 
            text = "" 
        intervals [252]:
            xmin = 700.729 
            xmax = 705.358 
            text = "un m'hot ongehoybn, s'geven, un di behole un di panik, ver s'ken, dos ken men nisht farshteyn." 
        intervals [253]:
            xmin = 705.358 
            xmax = 709.652 
            text = "dos iz geven di rusishe AVIRONIM. di rusishe AVIRONIM zenen geven kleyne, azoy vi feyglekh." 
        intervals [254]:
            xmin = 709.652 
            xmax = 712.214 
            text = "zey hobn oykh gehat kalye makhn, UNK." 
        intervals [255]:
            xmin = 712.214 
            xmax = 713.166 
            text = "" 
        intervals [256]:
            xmin = 713.166 
            xmax = 717.483 
            text = "shvere bombardimentn vos hobn mitgemakht in Rusland iz fun di daytshn." 
        intervals [257]:
            xmin = 717.483 
            xmax = 720.231 
            text = "der daytsher eh MAFTSITS," 
        intervals [258]:
            xmin = 720.231 
            xmax = 720.49 
            text = "" 
        intervals [259]:
            xmin = 720.49 
            xmax = 725.945 
            text = "khuts vos er hot MAFTSITS geven, hot geven aza min meshune kol, koydem iz er geven groys un shver," 
        intervals [260]:
            xmin = 725.945 
            xmax = 734.915 
            text = "un ven der kol zayne iz geven azoy vi khayes toyref, azoy vi zey zenen geven spn. fun der vaytns, ir hert, zenen shoyn geven mumkhim, az dos iz daytshe AVIRONIM," 
        intervals [261]:
            xmin = 734.915 
            xmax = 736.431 
            text = "un dos iz rusishe, di" 
        intervals [262]:
            xmin = 736.431 
            xmax = 736.707 
            text = "" 
        intervals [263]:
            xmin = 736.707 
            xmax = 740.306 
            text = "oybn iz geven luft-kamfn. vi azoy zogt men, KRAV AVIRI." 
        intervals [264]:
            xmin = 740.306 
            xmax = 740.92 
            text = "KEN." 
        intervals [265]:
            xmin = 740.92 
            xmax = 741.718 
            text = "" 
        intervals [266]:
            xmin = 741.718 
            xmax = 744.702 
            text = "lemayse dos iz shoyn, dos tseyl ikh shoyn ven undz ze'mir geven in lager," 
        intervals [267]:
            xmin = 744.702 
            xmax = 747.267 
            text = "ven m'hot undz ariber getribn dem Dnyester, ven m'hot undz shoyn farshikt," 
        intervals [268]:
            xmin = 747.267 
            xmax = 750.622 
            text = "iz ze'mir undz geven, di front iz forgega-" 
        intervals [269]:
            xmin = 750.622 
            xmax = 750.662 
            text = "" 
        intervals [270]:
            xmin = 750.662 
            xmax = 753.806 
            text = "un undz hot men alts geshikt untern untern front." 
        intervals [271]:
            xmin = 753.806 
            xmax = 760.747 
            text = "di MATARA iz geven undz farnikhtn. ofn gezogt, undz zo'mir faln fun di bomben, farhungern, un fun masn-greber, vifl zey hobn gekent fun undz dershisn." 
        intervals [272]:
            xmin = 760.747 
            xmax = 760.939 
            text = "" 
        intervals [273]:
            xmin = 760.939 
            xmax = 764.766 
            text = "khuts mize iz di shverste geven undz fleg'mir zayn SHETACH-hefker." 
        intervals [274]:
            xmin = 764.766 
            xmax = 769.095 
            text = "di tomed ze'mir geven tsvishn di KRAVOT. biz der eybershter hot geholfn" 
        intervals [275]:
            xmin = 769.095 
            xmax = 773.099 
            text = "az der rus iz arayn tif, der der daytsh iz arayn tif in Rusland," 
        intervals [276]:
            xmin = 773.099 
            xmax = 773.443 
            text = "" 
        intervals [277]:
            xmin = 773.443 
            xmax = 775.541 
            text = "un er hot zikh fartsoygn biz MOSCOW," 
        intervals [278]:
            xmin = 775.541 
            xmax = 779.242 
            text = "un undz ze'mir geblibn lebn Dnyester, ho'mir dos anderthalbn sho" 
        intervals [279]:
            xmin = 779.242 
            xmax = 779.839 
            text = "" 
        intervals [280]:
            xmin = 779.839 
            xmax = 784.054 
            text = "gerut, ho'mir fun dem nisht gelitn, vos iz geven der hunger un der tifus." 
        intervals [281]:
            xmin = 784.054 
            xmax = 788.788 
            text = "ober keyn bombardirung ho'mir di anderthalbn yor nisht gelitn." 
        intervals [282]:
            xmin = 788.788 
            xmax = 792.388 
            text = "nor vos den, nor ven zey hobn zikh umgekert, zey hobn tsurik gegilt dem front" 
        intervals [283]:
            xmin = 792.388 
            xmax = 792.546 
            text = "" 
        intervals [284]:
            xmin = 792.546 
            xmax = 795.875 
            text = "demolts iz frish gevorn di zelbe SIPUR, flegn mir" 
        intervals [285]:
            xmin = 795.875 
            xmax = 799.594 
            text = "blaybn TAKUA tsvishn tsvishn di tsvey," 
        intervals [286]:
            xmin = 799.594 
            xmax = 799.887 
            text = "" 
        intervals [287]:
            xmin = 799.887 
            xmax = 802.446 
            text = "BEIN, yo, un laydn," 
        intervals [288]:
            xmin = 802.446 
            xmax = 802.705 
            text = "" 
        intervals [289]:
            xmin = 802.705 
            xmax = 810.405 
            text = "lemayse hobn zey undz nisht gemeynt azoy dos kleyne derfl, di kleyne, zondern lebn undz iz geven a groyse shtot Zhmering hot dos geheysn, dortn geven a groyse" 
        intervals [290]:
            xmin = 810.405 
            xmax = 817.121 
            text = "militer-RIKUZ, mit a sakh vegn iber gants Rusland. fun dortn, s'geven a knoytn-punkt hot dos geheysn." 
        intervals [291]:
            xmin = 817.121 
            xmax = 820.451 
            text = "eh fun dort hot men geshikt ale CHAYALIM un ale," 
        intervals [292]:
            xmin = 820.451 
            xmax = 821.335 
            text = "" 
        intervals [293]:
            xmin = 821.335 
            xmax = 827.381 
            text = "zey hobn gezukht Zhmerinken, nor oyf tsu kumen tsu Zhmerinko ven zey hobn zikh aropgelozt hobn shoyn ongehoybn fun undz," 
        intervals [294]:
            xmin = 827.381 
            xmax = 828.706 
            text = "du farshteyst, azoy tsu geyn," 
        intervals [295]:
            xmin = 828.706 
            xmax = 832.233 
            text = "nor ven der AVIRON, der shtarker rus- daytsher AVIRON" 
        intervals [296]:
            xmin = 832.233 
            xmax = 837.05 
            text = "iz derkh undzer MIKNA, ho'mir gemuzt ale hobn mir gemuzt aroysloyfn, di hayzer zenen geven ARUA fun di" 
        intervals [297]:
            xmin = 837.05 
            xmax = 841.376 
            text = "fun di frierike, iz es geven di ershte sakone fun eh fun dem HEDEF," 
        intervals [298]:
            xmin = 841.376 
            xmax = 841.804 
            text = "" 
        intervals [299]:
            xmin = 841.804 
            xmax = 846.298 
            text = "zol undz nisht aynshitn. dos ershte vos m'hot getun ho'mir gemuzt aroysloyfn." 
        intervals [300]:
            xmin = 846.298 
            xmax = 849.934 
            text = "lebn undz iz geven a kleyn veldl, hot men genumen loyfn ahin. vos <dosh> optsutun veys ikh nisht." 
        intervals [301]:
            xmin = 849.934 
            xmax = 852.007 
            text = "nor koydem hot men gemuzt aroysloyfn fun der shtub." 
        intervals [302]:
            xmin = 852.007 
            xmax = 852.132 
            text = "" 
        intervals [303]:
            xmin = 852.132 
            xmax = 855.348 
            text = "az afile, s'flegn s'flegt faln bomben bay undz oykh." 
        intervals [304]:
            xmin = 855.348 
            xmax = 855.388 
            text = "" 
        intervals [305]:
            xmin = 855.388 
            xmax = 860.967 
            text = "nor dos rov fleg men dort bashisn, un vos m'hot dort bashosn flegt bay undz tsitern dos," 
        intervals [306]:
            xmin = 860.967 
            xmax = 860.974 
            text = "" 
        intervals [307]:
            xmin = 860.974 
            xmax = 863.668 
            text = "fleg'mir muzn aroysloyfn. un demolts iz di panik geven shreklekh." 
        intervals [308]:
            xmin = 863.668 
            xmax = 863.725 
            text = "" 
        intervals [309]:
            xmin = 863.725 
            xmax = 865.389 
            text = "aroysgelofn, un bay nakht," 
        intervals [310]:
            xmin = 865.389 
            xmax = 865.463 
            text = "" 
        intervals [311]:
            xmin = 865.463 
            xmax = 873.256 
            text = "kinder, mit froyen, mit veynendike kinder, mit mit m'iz gelofn eyner oyfn andern, di behole iz geven, dos ken men nisht bashraybn." 
        intervals [312]:
            xmin = 873.256 
            xmax = 874.333 
            text = "dos iz shreklekh." 
        intervals [313]:
            xmin = 874.333 
            xmax = 875.115 
            text = "" 
        intervals [314]:
            xmin = 875.115 
            xmax = 882.208 
            text = "un eh nokh hot zikh UNK, ven der front iz vayter gegangen tsu Rumenye ho'mir frish gehat a bisl ru." 
        intervals [315]:
            xmin = 882.208 
            xmax = 885.127 
            text = "ober s'iz geven gefalene fun undzer oykh." 
        intervals [316]:
            xmin = 885.127 
            xmax = 888.964 
            text = "ven ir zogt dos, afile in lager hot men gelernt. iz geven a khazn," 
        intervals [317]:
            xmin = 888.964 
            xmax = 889.003 
            text = "" 
        intervals [318]:
            xmin = 889.003 
            xmax = 890.991 
            text = "iz far a a shtikl broyt" 
        intervals [319]:
            xmin = 890.991 
            xmax = 895.826 
            text = "fleg er zitsn mit di kinder. un undzer lernen mit di kinder, zenen geven nayn, tsen-yerike kinder demolts," 
        intervals [320]:
            xmin = 895.826 
            xmax = 898.509 
            text = "hot di mame gegebn avekgegebn a shtikl broyt" 
        intervals [321]:
            xmin = 898.509 
            xmax = 902.449 
            text = "der tate olev-asholem fleg nisht gegesn gekoyft bay goyish, un undz ho'mir yo gegesn, s'geven biliker," 
        intervals [322]:
            xmin = 902.449 
            xmax = 905.129 
            text = "fleg di mame a mol koyfn a bisl mel, m'fleg es aleyn bakn." 
        intervals [323]:
            xmin = 905.129 
            xmax = 905.22 
            text = "" 
        intervals [324]:
            xmin = 905.22 
            xmax = 910.026 
            text = "iz der melamed vos hot gelernt mit mayne di yingelekh, mit di tsvey briderlekh mayne," 
        intervals [325]:
            xmin = 910.026 
            xmax = 911.981 
            text = "az far broyt hot er gelernt." 
        intervals [326]:
            xmin = 911.981 
            xmax = 912.088 
            text = "" 
        intervals [327]:
            xmin = 912.088 
            xmax = 918.562 
            text = "un aza melamed iz geven bayn a bay bayn a HAFTSATSA, bayn an anderer mishpokhe gelernt mit a yingele fun fir finef yor," 
        intervals [328]:
            xmin = 918.562 
            xmax = 919.193 
            text = "" 
        intervals [329]:
            xmin = 919.193 
            xmax = 922.286 
            text = "er iz gezesn baym tish azoy vi do mitn kind un gelernt," 
        intervals [330]:
            xmin = 922.286 
            xmax = 924.519 
            text = "a PTSATSA iz gefaln bay der tir." 
        intervals [331]:
            xmin = 924.519 
            xmax = 924.778 
            text = "" 
        intervals [332]:
            xmin = 924.778 
            xmax = 926.783 
            text = "UNK der eybershter UNK." 
        intervals [333]:
            xmin = 926.783 
            xmax = 929.902 
            text = "eyn neyn, dos iz geven a soykher vos iz arayngekumen tsum foter." 
        intervals [334]:
            xmin = 929.902 
            xmax = 930.178 
            text = "" 
        intervals [335]:
            xmin = 930.178 
            xmax = 935.491 
            text = "nebekh er iz gefaln, un der melamed mitn kind, un di mame iz geven in shtub, hot zi gornisht gehat ki-hu-ze." 
        intervals [336]:
            xmin = 935.491 
            xmax = 938.492 
            text = "un do azoy bay der tir iz gefaln epes a PTSATSA nebekh UNK." 
        intervals [337]:
            xmin = 938.492 
            xmax = 938.515 
            text = "" 
        intervals [338]:
            xmin = 938.515 
            xmax = 941.583 
            text = "ikh zog aykh s'do tsu dertseyln un tsu dertseyln." 
        intervals [339]:
            xmin = 941.583 
            xmax = 943.97 
            text = "di lage iz geven azoy groyzam az nor," 
        intervals [340]:
            xmin = 943.97 
            xmax = 947.303 
            text = "un fun dest vegn, ir zet, hot men avekgegebn di shtikl broyt fun dem moyl" 
        intervals [341]:
            xmin = 947.303 
            xmax = 948.92 
            text = "oyf tsu lernen di kinder." 
        intervals [342]:
            xmin = 948.92 
            xmax = 949.433 
            text = "" 
        intervals [343]:
            xmin = 949.433 
            xmax = 953.156 
            text = "un eh di di SIPUR vos ikh hob aykh dertseylt mitn veyts." 
        intervals [344]:
            xmin = 953.156 
            xmax = 953.196 
            text = "" 
        intervals [345]:
            xmin = 953.196 
            xmax = 955.451 
            text = "vos eh dos ze'mir shoyn geven in lager." 
        intervals [346]:
            xmin = 955.451 
            xmax = 955.845 
            text = "" 
        intervals [347]:
            xmin = 955.845 
            xmax = 957.611 
            text = "vos s'geven far pe-" 
        intervals [348]:
            xmin = 957.611 
            xmax = 958.512 
            text = "" 
        intervals [349]:
            xmin = 958.512 
            xmax = 960.328 
            text = "yare eyn un fertsik." 
        intervals [350]:
            xmin = 960.328 
            xmax = 962.322 
            text = "" 
        intervals [351]:
            xmin = 962.322 
            xmax = 965.931 
            text = "vos iz geven, tsores tsroyres. ershtnser m'iz geven" 
        intervals [352]:
            xmin = 965.931 
            xmax = 966.173 
            text = "" 
        intervals [353]:
            xmin = 966.173 
            xmax = 970.082 
            text = "eh koydem vos m'hot undz getribn, biz undz ze'mir gekumen in mokem menukh-" 
        intervals [354]:
            xmin = 970.082 
            xmax = 970.138 
            text = "" 
        intervals [355]:
            xmin = 970.138 
            xmax = 972.579 
            text = "in dem Zhurin vu undz ze'mir geven dray yor." 
        intervals [356]:
            xmin = 972.579 
            xmax = 972.889 
            text = "" 
        intervals [357]:
            xmin = 972.889 
            xmax = 979.45 
            text = "dort in dem derfl ho'mir zikh bahaltn, nisht nor undz, a gantse KVUTSA, azoy vi ikh dertseyl aykh, m'hot zikh ongetun di kufalkes mit di dos." 
        intervals [358]:
            xmin = 979.45 
            xmax = 983.12 
            text = "undz UNK undz zo'mir nisht zayn oyffalnd, m'zol undz nisht nemen, m'fleg alts khapn" 
        intervals [359]:
            xmin = 983.12 
            xmax = 988.593 
            text = "un avekshikn. dos hot ge- dos di dos dos deys peltsl heyst kufalke oyf rusish." 
        intervals [360]:
            xmin = 988.593 
            xmax = 988.684 
            text = "" 
        intervals [361]:
            xmin = 988.684 
            xmax = 995.743 
            text = "un deys di di KOVA di ho'mir gemuzt trogn far kelt. oykh khuts mize undz zo'mir oyszen mer eh rusishe bafelkerung." 
        intervals [362]:
            xmin = 995.743 
            xmax = 997.689 
            text = "m'zol nisht zen az undz ze'mir yidn." 
        intervals [363]:
            xmin = 997.689 
            xmax = 997.932 
            text = "" 
        intervals [364]:
            xmin = 997.932 
            xmax = 1003.123 
            text = "dos undz zol'mir nisht zayn azoy BOLET. khuts mize ho'mir farkoyft di gute zakhn undz zo'mir hobn vos tsu esn. dos iz geven," 
        intervals [365]:
            xmin = 1003.123 
            xmax = 1003.298 
            text = "" 
        intervals [366]:
            xmin = 1003.298 
            xmax = 1006.433 
            text = "ot vegn dem ze'mir geblibn lebn, undz ho'mir gehat," 
        intervals [367]:
            xmin = 1006.433 
            xmax = 1008.197 
            text = "di gute kleydung." 
        intervals [368]:
            xmin = 1008.197 
            xmax = 1009.648 
            text = "" 
        intervals [369]:
            xmin = 1009.648 
            xmax = 1011.85 
            text = "ho'mir zikh ongetun dos beste." 
        intervals [370]:
            xmin = 1011.85 
            xmax = 1018.381 
            text = "un vel ikh nokh dertseyln a fal. bayn undz ven a meydl azoy vi m'zogt, zi vert geboyrn s'ge- hot men geflantst a tenenboym, UNK azoy vi s'shteyt in a," 
        intervals [371]:
            xmin = 1018.381 
            xmax = 1024.402 
            text = "hot men bay undz azoy a meydele iz geboyrn hot men ongehoybn tsu neyen shtofir hot es geheysn. shtofir heyst eh" 
        intervals [372]:
            xmin = 1024.402 
            xmax = 1024.425 
            text = "" 
        intervals [373]:
            xmin = 1024.425 
            xmax = 1029.245 
            text = "eh vi azoy zol ikh zogn shtofir, oysshtatung. yo." 
        intervals [374]:
            xmin = 1029.245 
            xmax = 1029.353 
            text = "" 
        intervals [375]:
            xmin = 1029.353 
            xmax = 1032.756 
            text = "dos hot men aleyn geshtikt, un afile UNK, NEDUNYA." 
        intervals [376]:
            xmin = 1032.756 
            xmax = 1032.846 
            text = "" 
        intervals [377]:
            xmin = 1032.846 
            xmax = 1037.424 
            text = "iz geven met- der tate flegt koyfn gantse roln layvnt un s'fleg kumen a shnayderin un tsushnaydn." 
        intervals [378]:
            xmin = 1037.424 
            xmax = 1040.183 
            text = "un di do fornt flegn mir aleyn shtikn, iz demolts geven." 
        intervals [379]:
            xmin = 1040.183 
            xmax = 1044.309 
            text = "iz geven bay undz in shtub a sakh layvnt, un a sakh gute zakhn nisht genutste." 
        intervals [380]:
            xmin = 1044.309 
            xmax = 1048.899 
            text = "tsum bayshpil, tsikhn, betgevant, gehat oysgeshtikte di zelbe UNK." 
        intervals [381]:
            xmin = 1048.899 
            xmax = 1054.038 
            text = "dos ales iz geven, dos ershte far mir, ikh bin geven di eltste. zest Feygele, dos iz dayn nadn." 
        intervals [382]:
            xmin = 1054.038 
            xmax = 1056.786 
            text = "fleg men haltn azoy sheyn mit a mash tsugebundn." 
        intervals [383]:
            xmin = 1056.786 
            xmax = 1057.062 
            text = "" 
        intervals [384]:
            xmin = 1057.062 
            xmax = 1060.451 
            text = "dos ho'mir zikh, fun di zakhn vos ho'mir mitgenumen, un far aza tsikh" 
        intervals [385]:
            xmin = 1060.451 
            xmax = 1063.401 
            text = "mit aza set layvnt hot men gekent vokhn lebn." 
        intervals [386]:
            xmin = 1063.401 
            xmax = 1063.407 
            text = "" 
        intervals [387]:
            xmin = 1063.407 
            xmax = 1067.08 
            text = "di goyim hobn nisht gezen keyn layvnt nor ir veyst di proste," 
        intervals [388]:
            xmin = 1067.08 
            xmax = 1067.44 
            text = "" 
        intervals [389]:
            xmin = 1067.44 
            xmax = 1070.454 
            text = "fleg mir alts farkoyfn al- dos ho'mir mitgeshlept mit zikh." 
        intervals [390]:
            xmin = 1070.454 
            xmax = 1070.46 
            text = "" 
        intervals [391]:
            xmin = 1070.46 
            xmax = 1073.519 
            text = "un di gute hemder zikh ongeton, finef zeks gute hemder." 
        intervals [392]:
            xmin = 1073.519 
            xmax = 1076.363 
            text = "un di gute mentlen, di shabesdike UNK." 
        intervals [393]:
            xmin = 1076.363 
            xmax = 1078.886 
            text = "un dos fleg'mir langzam langzam farkoyfn." 
        intervals [394]:
            xmin = 1078.886 
            xmax = 1080.985 
            text = "un fun dem ho'mir ibergelebt dos ershte yor." 
        intervals [395]:
            xmin = 1080.985 
            xmax = 1081.378 
            text = "" 
        intervals [396]:
            xmin = 1081.378 
            xmax = 1085.928 
            text = "dos tsveyte yor ho'mir gelebt fun, o vi ir zogt fun hant-arbayt in di," 
        intervals [397]:
            xmin = 1085.928 
            xmax = 1086.12 
            text = "" 
        intervals [398]:
            xmin = 1086.12 
            xmax = 1092.538 
            text = "di MEMSHALA, zenen geven shtarke keltn, un di ru- di rumenishe soldatn, nisht di daytshe zenen gevoynt geven mit azolkhe keltn." 
        intervals [399]:
            xmin = 1092.538 
            xmax = 1095.719 
            text = "hot men gegebn MAS oyf di ukrainishe bafelkerung" 
        intervals [400]:
            xmin = 1095.719 
            xmax = 1097.876 
            text = "az yede mishpokhe muz gebn" 
        intervals [401]:
            xmin = 1097.876 
            xmax = 1098.27 
            text = "" 
        intervals [402]:
            xmin = 1098.27 
            xmax = 1100.781 
            text = "a por hantshu hantshu eh," 
        intervals [403]:
            xmin = 1100.781 
            xmax = 1103.642 
            text = "KFAFOT, un a por vareme zokn far CHAYALIM." 
        intervals [404]:
            xmin = 1103.642 
            xmax = 1107.444 
            text = "dos hot men gemuzt untershraybn az m'git frayvilik, nisht zey hobn nisht geheysn UNK." 
        intervals [405]:
            xmin = 1107.444 
            xmax = 1107.518 
            text = "" 
        intervals [406]:
            xmin = 1107.518 
            xmax = 1113.885 
            text = "zey hobn nisht shtrikn, zey hobn nisht gevust. vol hobn zey gehat, ir veyst zey flegn aleyn shpiln poshete eynfakhe vol." 
        intervals [407]:
            xmin = 1113.885 
            xmax = 1119.42 
            text = "un zey hobn afile nisht gevust, un ho'mir shoyn gekent shtrikn a zok mit hantshu fun fun kleynvayz on." 
        intervals [408]:
            xmin = 1119.42 
            xmax = 1124.724 
            text = "mumkhim ze'mir geven. dos iz geven alts vayl m'hot gelernt di yidishe tokhter arbet in der heym." 
        intervals [409]:
            xmin = 1124.724 
            xmax = 1124.815 
            text = "" 
        intervals [410]:
            xmin = 1124.815 
            xmax = 1129.992 
            text = "ir hert, un fun dem ho'mir undz oyf vinter gelebt. zey flegn undz brengen di goyishe vol," 
        intervals [411]:
            xmin = 1129.992 
            xmax = 1136.447 
            text = "m'hot ge- der tate olev-asholem fleg makhn fun holts shpitslekh, eh MAS- eh MASREG- yo," 
        intervals [412]:
            xmin = 1136.447 
            xmax = 1138.36 
            text = "neyn eh MASREGOT." 
        intervals [413]:
            xmin = 1138.36 
            xmax = 1138.568 
            text = "" 
        intervals [414]:
            xmin = 1138.568 
            xmax = 1142.122 
            text = "un undz ho'mir geshtrikt far di goyim hantshu un zokn." 
        intervals [415]:
            xmin = 1142.122 
            xmax = 1142.196 
            text = "" 
        intervals [416]:
            xmin = 1142.196 
            xmax = 1146.645 
            text = "<mame iz oykh> geven UNK vi azoy m'hot gemakht a UNK, dos iz a gantse kunts a UNK." 
        intervals [417]:
            xmin = 1146.645 
            xmax = 1147.107 
            text = "" 
        intervals [418]:
            xmin = 1147.107 
            xmax = 1152.399 
            text = "un keyn gelt hot men nisht genumen derfar, nor produktn. dos heyst kartofl, mel." 
        intervals [419]:
            xmin = 1152.399 
            xmax = 1152.675 
            text = "" 
        intervals [420]:
            xmin = 1152.675 
            xmax = 1155.251 
            text = "un dos iz mamesh vert, dos iz geven mer vi gold." 
        intervals [421]:
            xmin = 1155.251 
            xmax = 1155.578 
            text = "" 
        intervals [422]:
            xmin = 1155.578 
            xmax = 1161.326 
            text = "un fun dem ho'mir undz gelebt kimat a vinter. fleg'mir zitsn tog un nakht un arbetn," 
        intervals [423]:
            xmin = 1161.326 
            xmax = 1162.041 
            text = "" 
        intervals [424]:
            xmin = 1162.041 
            xmax = 1167.452 
            text = "un s'iz iz zeyer shver geven, vayl s'geven shtark shvere, s'nisht di fayne vol vos m'koyft yetst do." 
        intervals [425]:
            xmin = 1167.452 
            xmax = 1167.576 
            text = "" 
        intervals [426]:
            xmin = 1167.576 
            xmax = 1172.48 
            text = "khuts mize ho'mir gehat ge- sheyn geshtrikte sveters. undzer hant-arbayt UNK." 
        intervals [427]:
            xmin = 1172.48 
            xmax = 1172.622 
            text = "" 
        intervals [428]:
            xmin = 1172.622 
            xmax = 1175.985 
            text = "un az di goyte hot dos derzen iz zi oysgegangen." 
        intervals [429]:
            xmin = 1175.985 
            xmax = 1180.744 
            text = "ikh fleg oystun dem sveter un farkoyfn far a zekl mel un far a dos." 
        intervals [430]:
            xmin = 1180.744 
            xmax = 1183.517 
            text = "un undz ho'mir zikh ongeton vi goyishe poshete," 
        intervals [431]:
            xmin = 1183.517 
            xmax = 1184.13 
            text = "" 
        intervals [432]:
            xmin = 1184.13 
            xmax = 1185.828 
            text = "s'zol s'zol nisht zayn kalt." 
        intervals [433]:
            xmin = 1185.828 
            xmax = 1186.071 
            text = "" 
        intervals [434]:
            xmin = 1186.071 
            xmax = 1192.927 
            text = "vayl undz ho'mir gemuzt hobn, dos ershte iz geven dos dos eh di dos UNK. dernokh hot zikh ongehoybn ven s'geven shtil, ven der front iz geven vayt," 
        intervals [435]:
            xmin = 1192.927 
            xmax = 1197.776 
            text = "iz geven felder arum um in af- af- arum dem derfl." 
        intervals [436]:
            xmin = 1197.776 
            xmax = 1197.917 
            text = "" 
        intervals [437]:
            xmin = 1197.917 
            xmax = 1205.842 
            text = "dos iz geven zi hot gehert a mol tsum rusishn kolhoz. dernokh hot es ibergenumen di rumener un di tvue hot men geshikt farn far di soldatn farn front esn." 
        intervals [438]:
            xmin = 1205.842 
            xmax = 1205.882 
            text = "" 
        intervals [439]:
            xmin = 1205.882 
            xmax = 1207.58 
            text = "un m'hot getsvungen di goyim" 
        intervals [440]:
            xmin = 1207.58 
            xmax = 1207.688 
            text = "" 
        intervals [441]:
            xmin = 1207.688 
            xmax = 1216.018 
            text = "di UNK zoln dos baarbetn. zey hobn gehat sheyne mashinen, kombaynes mit dos. flegn zey arbetn tog, far nakht flegn zey avekgeyn," 
        intervals [442]:
            xmin = 1216.018 
            xmax = 1216.024 
            text = "" 
        intervals [443]:
            xmin = 1216.024 
            xmax = 1220.726 
            text = "un oyfn feld iz geblibn zangen, ir farshteyt eh ehm" 
        intervals [444]:
            xmin = 1220.726 
            xmax = 1220.985 
            text = "" 
        intervals [445]:
            xmin = 1220.985 
            xmax = 1225.316 
            text = "SHIBOLIM mit fun veyts un fun fun gershtn, fun vos s'iz geven." 
        intervals [446]:
            xmin = 1225.316 
            xmax = 1225.373 
            text = "" 
        intervals [447]:
            xmin = 1225.373 
            xmax = 1230.345 
            text = "dos iz geven azoy arum undzer arum undzer di arum undzer derfl." 
        intervals [448]:
            xmin = 1230.345 
            xmax = 1230.537 
            text = "" 
        intervals [449]:
            xmin = 1230.537 
            xmax = 1233.754 
            text = "azoy zey zenen avek funem <mashin nemen> paze, flegn mir aroysgeyn" 
        intervals [450]:
            xmin = 1233.754 
