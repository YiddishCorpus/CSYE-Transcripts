            text = "dos iz geven bay undz in shtub," 
        intervals [89]:
            xmin = 262.414 
            xmax = 267.879 
            text = "az ikh bin demolts lebn, un di politsey iz gekumen, politsey vos hot nisht tsugelozt, ober vern nokh dem vayl m'hot nisht undz ge-" 
        intervals [90]:
