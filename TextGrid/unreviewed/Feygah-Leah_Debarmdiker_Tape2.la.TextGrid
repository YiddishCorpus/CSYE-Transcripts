            text = "" 
        intervals [6]:
            xmin = 34.352 
            xmax = 39.931 
            text = "s'iz do deriber a sakh tsu tseyln, dos iz di bafelkerung, di OCHLUSIYA, azoy vi m'zogt es oyf ivrit," 
        intervals [7]:
            xmin = 39.931 
            xmax = 39.988 
            text = "" 
        intervals [8]:
            xmin = 39.988 
            xmax = 43.824 
            text = "iz geven zeyer gemisht, un d'geven Estraykh iz geven a sakh daytshn," 
        intervals [9]:
            xmin = 43.824 
            xmax = 45.655 
            text = "un ungarn zenen geven a sakh." 
        intervals [10]:
            xmin = 45.655 
            xmax = 50.462 
            text = "geven sektn, rusishe SHVATIM, vos zey hobn geheysn lipoverner." 
        intervals [11]:
            xmin = 50.462 
            xmax = 51.936 
            text = "" 
        intervals [12]:
            xmin = 51.936 
            xmax = 56.734 
            text = "un eh un UNK. iz undz ze'mir geven, undz ho'mir gevoynt di yidn" 
        intervals [13]:
            xmin = 56.734 
            xmax = 61.273 
            text = "bederekh klal in tsentrum. di yidn zenen geven di raykhe, di bafelkerung iz geven" 
        intervals [14]:
            xmin = 61.273 
            xmax = 64.181 
            text = "zeyer veynik raykhe. di bafelkerung iz geven zeyer orem." 
        intervals [15]:
            xmin = 64.181 
            xmax = 65.942 
            text = "" 
        intervals [16]:
            xmin = 65.942 
            xmax = 68.74 
            text = "ober undz ho'mir gehat shkheynim daytsher." 
        intervals [17]:
            xmin = 68.74 
            xmax = 72.5 
            text = "undz hobn gehat shkheynim rumenisher. ungarn." 
        intervals [18]:
            xmin = 72.5 
            xmax = 74.143 
            text = "" 
        intervals [19]:
            xmin = 74.143 
            xmax = 77.489 
            text = "eh dos heyst azoy ar- arum undz nisht vayt fun UNK." 
        intervals [20]:
            xmin = 77.489 
            xmax = 83.789 
            text = "eh eh ey- eyn daytshike iz gekumen voynen in zibete hoyz fun undz, yene hobn shoyn geheysn di raykhe." 
        intervals [21]:
