            text = "ofitsyel nisht gelozt geyn davenen." 
        intervals [127]:
            xmin = 371.537 
            xmax = 375.88 
            text = "un nokh hot geven nokh shtarkere tsores. plutsem hot ongehoybn" 
        intervals [128]:
            xmin = 375.88 
            xmax = 375.919 
            text = "" 
        intervals [129]:
            xmin = 375.919 
            xmax = 380.857 
            text = "dos iz shoyn geven mitn bafel funem daytsh, hot shoyn ongehoybn der oysrotung der JUDEN." 
