        intervals [116]:
            xmin = 343.435 
            xmax = 348.46 
            text = "un in dem kugl iz geven arayngeshtekt negl ober farkert, ir farshteyt, di shpits funem nogl iz geven gor," 
        intervals [117]:
            xmin = 348.46 
            xmax = 350.212 
            text = "un der tate olev-asholem hot gekhapt," 
