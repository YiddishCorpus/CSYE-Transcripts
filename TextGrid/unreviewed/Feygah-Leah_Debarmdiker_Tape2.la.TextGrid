            text = "" 
        intervals [32]:
            xmin = 109.075 
            xmax = 112.056 
            text = "di goyishe shokhnte, meshum darkey sholem." 
        intervals [33]:
            xmin = 112.056 
            xmax = 112.635 
            text = "" 
        intervals [34]:
            xmin = 112.635 
            xmax = 116.426 
            text = "ober vos iz geven, az m'hot gehat tsum bayshpil a SICHSUCH mitn" 
