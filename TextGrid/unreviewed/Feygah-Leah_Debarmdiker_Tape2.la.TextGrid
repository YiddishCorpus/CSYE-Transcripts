            text = "" 
        intervals [488]:
            xmin = 1326.927 
            xmax = 1333.333 
            text = "hot <oykh frish> der tate farkoyft er hot gehat epes a peltsl zeyer a sheyns un m'hot gekoyft a a halb zekl veyts." 
        intervals [489]:
            xmin = 1333.333 
            xmax = 1334.25 
            text = "" 
        intervals [490]:
            xmin = 1334.25 
            xmax = 1339.036 
            text = "gekoyft veyts bayn a goy, un dos hot men gemuzt ober kloybn s'zol zayn oyf peysekh UNK." 
        intervals [491]:
            xmin = 1339.036 
            xmax = 1339.043 
            text = "" 
        intervals [492]:
            xmin = 1339.043 
            xmax = 1341.737 
            text = "hot men gehat eyn tish azolkhe UNK," 
        intervals [493]:
            xmin = 1341.737 
            xmax = 1342.435 
            text = "" 
        intervals [494]:
            xmin = 1342.435 
            xmax = 1346.259 
            text = "hot men dos azoy ze'mir geven, der tate olev-asholem hot undz gevizn velekh" 
        intervals [495]:
            xmin = 1346.259 
            xmax = 1346.383 
            text = "" 
        intervals [496]:
            xmin = 1346.383 
            xmax = 1352.671 
            text = "veyts iz trikn aher ahin, un dos rest hot men opgekokht. un dem hot men oysgeklibn az der vet zayn oyf matses oyf peysekh." 
        intervals [497]:
            xmin = 1352.671 
            xmax = 1352.931 
            text = "" 
        intervals [498]:
            xmin = 1352.931 
            xmax = 1357.729 
            text = "un demolts hob ikh aykh dertseyln in tsveytn peysekh iz geven ven di rusn zenen shoyn ongehoybn tsuriktsukumen," 
        intervals [499]:
            xmin = 1357.729 
            xmax = 1361.331 
            text = "un m'hot ongehoybn tsu bombardirn. zenen mir gezesn a tog, undz ho'mir geklibn veyts," 
        intervals [500]:
            xmin = 1361.331 
            xmax = 1366.036 
            text = "mir ho'mir gehert di AVIRONIM kl- kumen ze'mir aroysgelofn, m'hot gelozt ales azoy oyfn tish." 
        intervals [501]:
            xmin = 1366.036 
            xmax = 1366.768 
            text = "" 
        intervals [502]:
            xmin = 1366.768 
            xmax = 1375.469 
            text = "ze'mir tsurikgekumen, s'ales geshtanen. der HEDEF hot gornisht gut getun. ir hert, vi azoy s'geven bintelekh geklibene, in mitn iz geven der gantser hoyfn, azoy ho'mir undz es ge-" 
        intervals [503]:
            xmin = 1375.469 
            xmax = 1375.56 
            text = "" 
        intervals [504]:
            xmin = 1375.56 
            xmax = 1378.017 
            text = "ir veyst shtelt zikh for, dos vos ikh kler tsurik," 
        intervals [505]:
            xmin = 1378.017 
            xmax = 1378.075 
            text = "" 
        intervals [506]:
            xmin = 1378.075 
            xmax = 1383.316 
            text = "mir ho'mir azoy zelbst farshtendlekh getun. oybn hot geshvebt der toyt, bombardirungen," 
        intervals [507]:
            xmin = 1383.316 
            xmax = 1383.424 
            text = "" 
        intervals [508]:
            xmin = 1383.424 
            xmax = 1387.063 
            text = "s'shtil gevorn, gekumen tsurik, gegangen m'hot geklibn veyts oyf peysekh." 
        intervals [509]:
            xmin = 1387.063 
            xmax = 1388.757 
            text = "" 
        intervals [510]:
            xmin = 1388.757 
            xmax = 1392.575 
            text = "demolts ho'mir es nisht gefilt. undz ho'mir, s'nisht geven z-, az ikh kler haynt tsurik," 
        intervals [511]:
            xmin = 1392.575 
            xmax = 1395.736 
            text = "mit aza min zelbst-farshtendlekhkeyt, mit aza min," 
        intervals [512]:
            xmin = 1395.736 
            xmax = 1395.793 
            text = "" 
        intervals [513]:
            xmin = 1395.793 
            xmax = 1400.361 
            text = "shoyn, nokh s'gekumen dos moln dem veyts. ho'mir ge- opgedungen bayn a goyte" 
        intervals [514]:
            xmin = 1400.361 
            xmax = 1404.793 
            text = "tsvey mil-shteyner. dos zenen geven in gants HAKOL azoy groys, un dos hot es gehat a lokh mit aza" 
        intervals [515]:
            xmin = 1404.793 
            xmax = 1404.923 
            text = "" 
        intervals [516]:
            xmin = 1404.923 
            xmax = 1410.184 
            text = "shtekn, un m'hot alts arayngeleygt a bisl veyts. arings arum hot men untergeleygt aza tsikhl," 
        intervals [517]:
            xmin = 1410.184 
            xmax = 1411.801 
            text = "un dos mel fleg araynfaln." 
        intervals [518]:
            xmin = 1411.801 
            xmax = 1411.858 
            text = "" 
        intervals [519]:
            xmin = 1411.858 
            xmax = 1413.796 
            text = "ho'mir <zoyber> gemakht undzer shtub," 
        intervals [520]:
            xmin = 1413.796 
            xmax = 1419.969 
            text = "undz ho'mir farshtupt in a vinkl, un der rebe, der Nadverner rebe, zol zayn a guter meylets far undz, mit nokh etlekhe yunge layt mit der tate." 
        intervals [521]:
            xmin = 1419.969 
            xmax = 1420.296 
            text = "" 
        intervals [522]:
            xmin = 1420.296 
            xmax = 1426.486 
            text = "hot koydem der rebe gemoln zayn veyts, vayl zayne iz dokh geven opgehit fun mamesh shmire mishays ketsire." 
        intervals [523]:
            xmin = 1426.486 
            xmax = 1429.414 
            text = "nor s'geven zeyer shver, m'hot zikh alts gemuzt vayl," 
        intervals [524]:
            xmin = 1429.414 
            xmax = 1433.886 
            text = "nor az der rebe hot gedreyt di shteyner, fleg ikh shrayen leshem matses mitsve, ir hert," 
        intervals [525]:
            xmin = 1433.886 
            xmax = 1439.91 
            text = "ir v- ir kent dem nusekh fun Nadvernerers davenen? zey davenen azoy di kol azoy vi di karliner." 
        intervals [526]:
            xmin = 1439.91 
            xmax = 1445.046 
            text = "ver s'hot nisht gezen di ayngehoykerte biktaves, zey hobn zikh gemuzt azoy aynbeygn arayntsukumen tsun undz," 
        intervals [527]:
            xmin = 1445.046 
            xmax = 1445.085 
            text = "" 
        intervals [528]:
            xmin = 1445.085 
            xmax = 1451.339 
            text = "un di sheyn opgekalkhte vent. undz flegn zey haltn zeyer reyn, undz hobn gekoyft kalekh, flegn mir alts kalkhn di budke az s'zol zayn zoyber." 
        intervals [529]:
            xmin = 1451.339 
            xmax = 1451.346 
            text = "" 
        intervals [530]:
            xmin = 1451.346 
            xmax = 1452.656 
            text = "ze'mir shoyn geven UNK." 
        intervals [531]:
            xmin = 1452.656 
            xmax = 1453.489 
            text = "" 
        intervals [532]:
            xmin = 1453.489 
            xmax = 1457.347 
            text = "neyn, a gants yor, vayl der kalekh hot geshitst far mikrobn." 
        intervals [533]:
            xmin = 1457.347 
            xmax = 1458.062 
            text = "" 
        intervals [534]:
            xmin = 1458.062 
            xmax = 1463.169 
            text = "khuts mize s'zol reyn. <s'zenen di plotses flegn kumen> arayngekumen flegn makhn blote di vent. dos iz a zakh far zikh." 
        intervals [535]:
            xmin = 1463.169 
            xmax = 1464.087 
            text = "" 
        intervals [536]:
            xmin = 1464.087 
            xmax = 1467.29 
            text = "ver s'hot nisht gezen di dos bild, in aza min" 
        intervals [537]:
            xmin = 1467.29 
            xmax = 1470.325 
            text = "farshtupt ort, in aza farshtupte bikta," 
        intervals [538]:
            xmin = 1470.325 
            xmax = 1470.398 
            text = "" 
        intervals [539]:
            xmin = 1470.398 
            xmax = 1475.499 
            text = "shteyt a rebe un molt dem veyts mit ale koyles un shrayt mit a koyles leshem matses mitsve." 
        intervals [540]:
            xmin = 1475.499 
            xmax = 1476.956 
            text = "dos iz geven. yetst di" 
        intervals [541]:
            xmin = 1476.956 
            xmax = 1477.03 
            text = "" 
        intervals [542]:
            xmin = 1477.03 
            xmax = 1483.132 
            text = "un un shoyn azoy s'flegt alts zayn di bombardirung, dernokh hot zikh der front avek geshtupt un s'gevezn a bisl shtil un di rusn zenen arayn." 
        intervals [543]:
            xmin = 1483.132 
            xmax = 1483.459 
            text = "" 
        intervals [544]:
            xmin = 1483.459 
            xmax = 1488.296 
            text = "di rusn zenen arayn, dos megt ir oykh hern. s'iz an interesante zakh, ikh veys nisht tsi ikh hob es shoyn dertseylt." 
        intervals [545]:
            xmin = 1488.296 
            xmax = 1488.859 
            text = "" 
        intervals [546]:
            xmin = 1488.859 
            xmax = 1499.436 
            text = "ho'mir ge- iz in a shul, al pi rov hot men aynkvatirt di ale bezhnitses hobn zey geheysn, di ale flikhtlungen, in MOSDOT, shuln groyse." 
        intervals [547]:
            xmin = 1499.436 
            xmax = 1503.891 
            text = "iz geven a groyse shul, geboyt take azoy vi a shul, a groyse PROZDOR mit groyse klasn." 
        intervals [548]:
            xmin = 1503.891 
            xmax = 1508.574 
            text = "baym sof iz geven UNK vi epes a kekh. ken zayn s'geven a mol a kekh fun der shul." 
        intervals [549]:
            xmin = 1508.574 
            xmax = 1513.811 
            text = "iker di mentshn vos hobn gevoynt in der der kekh hobn maskem geven un m'hot gekashert dem oyvn." 
        intervals [550]:
            xmin = 1513.811 
            xmax = 1513.885 
            text = "" 
        intervals [551]:
            xmin = 1513.885 
            xmax = 1519.042 
            text = "un dortn hobn di ale yidn vos hobn gehat biselekh veyts gemolene, m'hot es tsunoyfgenumen a tog," 
        intervals [552]:
            xmin = 1519.042 
            xmax = 1519.116 
            text = "" 
        intervals [553]:
            xmin = 1519.116 
            xmax = 1520.662 
            text = "mir bakn matses." 
        intervals [554]:
            xmin = 1520.662 
            xmax = 1521.647 
            text = "" 
        intervals [555]:
            xmin = 1521.647 
            xmax = 1525.196 
            text = "s'geven shtil, m'hot gevust di rusn zenen shoyn do, ober s'hot undz nisht derkutshet." 
        intervals [556]:
            xmin = 1525.196 
            xmax = 1530.52 
            text = "plutsem funem ek PROZDOR, un ikh hob dos <gez- -hert>, kumt arayn a a" 
        intervals [557]:
            xmin = 1530.52 
            xmax = 1538.718 
            text = "o- a rusisher eh natshalnik flegn zey, natshalnik heyst a greserer ofitsir, nor a greserer eh mit DARGOT, eh KATZIN." 
        intervals [558]:
            xmin = 1538.718 
            xmax = 1540.412 
            text = "" 
        intervals [559]:
            xmin = 1540.412 
            xmax = 1546.99 
            text = "un kukt azoy rekhts links. vos hot men gezen? mentshn krank oyf der erd. iz geven etlekhe UNK. un der UNK" 
        intervals [560]:
            xmin = 1546.99 
            xmax = 1549.603 
            text = "un er shpant glaykh tsum sof," 
        intervals [561]:
            xmin = 1549.603 
            xmax = 1550.52 
            text = "" 
        intervals [562]:
            xmin = 1550.52 
            xmax = 1552.55 
            text = "er hot derfilt dem gerukh fun di matses." 
        intervals [563]:
            xmin = 1552.55 
            xmax = 1553.942 
            text = "do hot men gevust azoy." 
        intervals [564]:
            xmin = 1553.942 
            xmax = 1562.816 
            text = "do ze'mir poter gevorn funem daytsh ze'mir fizish geratevet gevorn, nor <hitst vayzt> undz a shvere MAARACHA, a gaystishe UNK, vi loyt vi di rusishe yidn hobn undz dertseylt" 
        intervals [565]:
            xmin = 1562.816 
            xmax = 1562.89 
            text = "" 
        intervals [566]:
            xmin = 1562.89 
            xmax = 1567.389 
            text = "az vi azoy m'tor nisht haltn yidishkeyt, dos zey flegn groyzame zakhn dertseylt az zey hobn gezen" 
        intervals [567]:
            xmin = 1567.389 
            xmax = 1567.463 
            text = "" 
        intervals [568]:
            xmin = 1567.463 
            xmax = 1573.785 
            text = "a kind geyn in shul oder vos hot di gantse mishpokhe fleg men shikn far Sibir. ho'mir shtark moyre gehat far yidishkeyt." 
        intervals [569]:
            xmin = 1573.785 
            xmax = 1573.825 
            text = "" 
        intervals [570]:
            xmin = 1573.825 
            xmax = 1577.886 
            text = "un do hot men zey gekhapt AL CHAM, der rus hobn gekha- matses bakn." 
        intervals [571]:
            xmin = 1577.886 
            xmax = 1577.925 
            text = "" 
        intervals [572]:
            xmin = 1577.925 
            xmax = 1581.395 
            text = "ir hert, der iz geshtanen a por minut ongeshpart on der tir," 
        intervals [573]:
            xmin = 1581.395 
            xmax = 1581.418 
            text = "" 
        intervals [574]:
            xmin = 1581.418 
            xmax = 1584.596 
            text = "un kukt azoy un nokh git a derfreg a reyn yidish," 
        intervals [575]:
            xmin = 1584.596 
            xmax = 1587.234 
            text = "s'iz m- shmire mishays ketsire?" 
        intervals [576]:
            xmin = 1587.234 
            xmax = 1587.679 
            text = "" 
        intervals [577]:
            xmin = 1587.679 
            xmax = 1592.111 
            text = "ven ir zet di yidn vi azoy m'hot ongehoybn tsu tantsn, UNK a yid!" 
        intervals [578]:
            xmin = 1592.111 
            xmax = 1592.961 
            text = "" 
        intervals [579]:
            xmin = 1592.961 
            xmax = 1598.745 
            text = "un nokh hob ikh es dertseylt far mamen, er iz shoyn nisht geven keyn yunger mentshn der vos der ofits- der ofitsir." 
        intervals [580]:
            xmin = 1598.745 
            xmax = 1603.352 
            text = "iz varshaynlekh, hot mame oysgerekhnt, az er, ven di rusn zenen gekumen tsum makht hot gedarft zayn" 
        intervals [581]:
            xmin = 1603.352 
            xmax = 1606.927 
            text = "a mentsh fun tsvontsik yor. dos heyst er iz gevaksn in a yidisher shtub." 
        intervals [582]:
            xmin = 1606.927 
            xmax = 1610.038 
            text = "" 
        intervals [583]:
            xmin = 1610.038 
            xmax = 1611.567 
            text = "neyn, er hot epes gema-" 
        intervals [584]:
            xmin = 1611.567 
            xmax = 1611.591 
            text = "" 
        intervals [585]:
            xmin = 1611.591 
            xmax = 1613.812 
            text = "eh er hot gevaksn in a yidishe shtub," 
        intervals [586]:
            xmin = 1613.812 
            xmax = 1614.156 
            text = "" 
        intervals [587]:
            xmin = 1614.156 
            xmax = 1622.807 
            text = "oder iz er geven a aleyn a yeshive bokher oder mit a <zeyde>, er hot gevust fun, vayl afile di yidn vos zenen geven hobn shoyn nisht gevust fun eh shmire mishays ketsire, oyb er hot gevust fun matses." 
        intervals [588]:
            xmin = 1622.807 
            xmax = 1622.813 
            text = "" 
        intervals [589]:
            xmin = 1622.813 
            xmax = 1625.574 
            text = "ot der iz nokh geven a mentsh vos hot gelebt farn" 
        intervals [590]:
            xmin = 1625.574 
            xmax = 1625.715 
            text = "" 
        intervals [591]:
            xmin = 1625.715 
            xmax = 1628.623 
            text = "far di befor di rusn zenen gekumen tsum makht." 
        intervals [592]:
            xmin = 1628.623 
            xmax = 1630.434 
            text = "hot er nokh gevust fun aza zakh." 
        intervals [593]:
            xmin = 1630.434 
            xmax = 1630.626 
            text = "" 
        intervals [594]:
            xmin = 1630.626 
            xmax = 1635.643 
            text = "az fun ales vos er hot dertseylt, in Stalingrad hot der rus gekhapt dem ershtn klop un fun dortn hot men im avekge-" 
        intervals [595]:
            xmin = 1635.643 
            xmax = 1637.592 
            text = "zogt er, er kumt fun Stalingrad, zogt er," 
        intervals [596]:
            xmin = 1637.592 
            xmax = 1640.756 
            text = "vu er kumt in a shtetl, vu er <ober> tsurik vu," 
        intervals [597]:
            xmin = 1640.756 
            xmax = 1642.992 
            text = "dos ershte, zogt er, zukh a yid." 
        intervals [598]:
            xmin = 1642.992 
            xmax = 1645.25 
            text = "ir zent di ershte yidn vos ikh hob bagegnt." 
        intervals [599]:
            xmin = 1645.25 
            xmax = 1645.645 
            text = "" 
        intervals [600]:
            xmin = 1645.645 
            xmax = 1649.81 
            text = "ir hert, ven er iz aroys hob ikh im gezen, undz ho'mir zikh bahaltn, far vos ho'mir zikh undz bahaltn?" 
        intervals [601]:
            xmin = 1649.81 
            xmax = 1649.837 
            text = "" 
        intervals [602]:
            xmin = 1649.837 
            xmax = 1651.594 
            text = "demolts bin ikh shoyn geven in akhtsn yor," 
        intervals [603]:
            xmin = 1651.594 
            xmax = 1653.324 
            text = "shoyn geven a andere bitere sakone." 
        intervals [604]:
            xmin = 1653.324 
            xmax = 1656.04 
            text = "di rusn hobn genumen meydlekh in militer, in Rus-" 
        intervals [605]:
            xmin = 1656.04 
            xmax = 1656.492 
            text = "yo." 
