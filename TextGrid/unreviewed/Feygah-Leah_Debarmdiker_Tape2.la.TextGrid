            xmax = 86.8 
            text = "" 
        intervals [24]:
            xmin = 86.8 
            xmax = 92.97 
            text = "undz ho'mir dayke ho'mir undz zeyer gut gelebt. gu- gut gelebt, zol nokh nisht meynen epes mir ho'mir gut gelebt, nor" 
        intervals [25]:
            xmin = 92.97 
            xmax = 92.993 
            text = "" 
        intervals [26]:
            xmin = 92.993 
            xmax = 98.488 
            text = "farn krig iz es geven <farheltns> gut morgn, bay undz iz geven di heflekhkeyt zeyer groys." 
        intervals [27]:
            xmin = 98.488 
            xmax = 98.595 
            text = "" 
        intervals [28]:
            xmin = 98.595 
            xmax = 106.014 
            text = "un der der goy iz derkh, hot er gut morgn eh FRAU Frid, vi GEHTS, mir ho'mir ale gemuzt entfern, ven nisht hot men yo." 
        intervals [29]:
            xmin = 106.014 
            xmax = 106.02 
            text = "" 
        intervals [30]:
            xmin = 106.02 
            xmax = 108.882 
            text = "un di zelbe ho'mir undz bagr- gemuzt bagrisn di" 
        intervals [31]:
