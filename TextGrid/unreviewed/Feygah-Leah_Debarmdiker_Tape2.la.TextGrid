        intervals [114]:
            xmin = 337.343 
            xmax = 343.277 
            text = "hobn bafaln di yidn, m'hot zey ongehoybn tsu shlogn. hobn zey gehat azolkhe shtekenes ir zet azoy vi do un do a kugl," 
        intervals [115]:
            xmin = 343.277 
