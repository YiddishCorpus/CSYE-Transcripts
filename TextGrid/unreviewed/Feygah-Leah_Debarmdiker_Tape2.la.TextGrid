            text = "s'geven zeyer zeyer biter un zoyer." 
        intervals [137]:
            xmin = 405.396 
            xmax = 411.488 
            text = "azoy hot es langzam ongehoybn. un s'geven tsaytn vos s'hot zikh geshtilt, zey hobn es genumen mer in der hant s'zol nisht vern aza min," 
        intervals [138]:
            xmin = 411.488 
            xmax = 416.695 
            text = "vayl zey aleyn flegn zikh raysn bay di kep, ver s'zol mer rabeven un ver nemen. hobn zey oykh gehat tsores." 
        intervals [139]:
            xmin = 416.695 
            xmax = 418.711 
            text = "azoy az m'hot gemuzt a bisl ordenung makhn." 
        intervals [140]:
