            text = "" 
        intervals [72]:
            xmin = 218.29 
            xmax = 222.21 
            text = "zogt men hot men keyn mol nisht geven gegloybt. nisht nor ikh, nor a sakh." 
        intervals [73]:
            xmin = 222.21 
