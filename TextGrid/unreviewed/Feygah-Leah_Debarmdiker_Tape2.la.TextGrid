            text = "eh rumenishn eh shokhn, iz geven biter azoy." 
        intervals [37]:
            xmin = 120.411 
            xmax = 124.019 
            text = "m'hot tomer iz er geven shiker iz er geshprungen mitn meser punkt azoy vi der araber." 
        intervals [38]:
            xmin = 124.019 
            xmax = 124.532 
            text = "" 
        intervals [39]:
            xmin = 124.532 
            xmax = 128.761 
            text = "m'hot azoy moyre gehat tsu tshepen mit a goy a shokhn, iber a kleynikeyt." 
        intervals [40]:
            xmin = 128.761 
            xmax = 128.785 
            text = "" 
        intervals [41]:
            xmin = 128.785 
            xmax = 133.886 
            text = "eh ikh veys, a kind hot opgerisn a blum fun zayn gortn ober nisht velndik, oder arayn getantst, hot er" 
        intervals [42]:
            xmin = 133.886 
            xmax = 143.241 
            text = "oysgetretet di betn fun di royzn, hot er a tret getun, iz shoyn geven UNK, geshrign royzn un m'hot eh di kinder hobn a teyl gemakht dos kind gekumen koyle-koyles tsu der mame" 
        intervals [43]:
            xmin = 143.241 
            xmax = 143.365 
            text = "" 
        intervals [44]:
            xmin = 143.365 
            xmax = 146.076 
            text = "vos di mame hot zikh opgebetn, s'a kind, zi hot nisht oygepa-" 
        intervals [45]:
            xmin = 146.076 
            xmax = 146.571 
            text = "" 
        intervals [46]:
            xmin = 146.571 
            xmax = 152.792 
            text = "tomer oder bay der man gehat epes mit dem tate, ikh veys vos, UNK undzer arbet, hot men gehat alerley." 
        intervals [47]:
            xmin = 152.792 
            xmax = 152.899 
            text = "" 
        intervals [48]:
            xmin = 152.899 
            xmax = 158.844 
            text = "iz a mol, ikh veys, iz oysgekumen er hot nisht gut gemakht di arbet, oder er hot nisht gemakht vifl er hot gedarft, tsi er" 
        intervals [49]:
            xmin = 158.844 
            xmax = 164.033 
            text = "tsi eh un s'kumt a mol, vi azoy men arbet kumt a SICHSUCH," 
        intervals [50]:
            xmin = 164.033 
            xmax = 167.287 
            text = "hot er gekent in a por minut hot er gekent tsushpringen mitn meser." 
        intervals [51]:
            xmin = 167.287 
            xmax = 167.985 
            text = "" 
        intervals [52]:
            xmin = 167.985 
            xmax = 170.459 
            text = "dos iz geven der rumener. un der unger nokh arger." 
        intervals [53]:
            xmin = 170.459 
            xmax = 170.5 
            text = "" 
        intervals [54]:
            xmin = 170.5 
            xmax = 175.776 
            text = "di unger zenen geven di zey hobn gehat, zey flegn HOVALA azoy mit di veglekh, azoy kutshers, mit yo." 
        intervals [55]:
            xmin = 175.776 
            xmax = 175.95 
            text = "" 
        intervals [56]:
            xmin = 175.95 
            xmax = 180.166 
            text = "mit di iz es geven shreklekh. m'hot azoy zikh gehit tsu tshepen mit a goy azoy." 
        intervals [57]:
            xmin = 180.166 
            xmax = 181.347 
            text = "di rumener unger." 
        intervals [58]:
            xmin = 181.347 
            xmax = 184.129 
            text = "der daytsh, funem daytsh hot men nisht moyre gehat." 
        intervals [59]:
            xmin = 184.129 
            xmax = 184.523 
            text = "" 
        intervals [60]:
            xmin = 184.523 
            xmax = 187.11 
            text = "mit a daytsh hot men heflekh geredt, der" 
        intervals [61]:
            xmin = 187.11 
            xmax = 191.486 
            text = "der daytsh iz nisht geven a tipesh aza groyzamer vi dos andere, derfar" 
        intervals [62]:
            xmin = 191.486 
            xmax = 191.593 
            text = "" 
        intervals [63]:
            xmin = 191.593 
            xmax = 197.496 
            text = "iz di zog ikh, baton ikh alts, iz di SHOAH iz a ibernatirlekhe zakh." 
        intervals [64]:
            xmin = 197.496 
            xmax = 201.442 
            text = "vayl ver s'hot gekent dos daytshe folk iz geven a shtark, a sakh daytshe bafelkerung." 
        intervals [65]:
