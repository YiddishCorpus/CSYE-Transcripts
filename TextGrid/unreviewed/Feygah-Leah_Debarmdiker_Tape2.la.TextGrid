            text = "" 
        intervals [131]:
            xmin = 381.032 
            xmax = 388.26 
            text = "farshidene antisemitishe plakatn. m'hot dem kenig aropgevorfn, dos iz geven dos ershte. vi lang der kenig der kenig Karl iz geven oyf der melukhe," 
        intervals [132]:
            xmin = 388.26 
            xmax = 393.027 
            text = "hot men keyn yidish nisht azoy, s'demolts iz geven nor UNK. dos ershte hobn zey im aropgevorfn dem kenig," 
        intervals [133]:
            xmin = 393.027 
            xmax = 397.035 
            text = "un s'gevorn a groyse anarkhi, ir farshteyt, yeder hot getun vos er hot gevolt." 
        intervals [134]:
            xmin = 397.035 
            xmax = 402.71 
            text = "un ver s'hot gehat a a khrap oyf a a SICHSUCH mit a shokhn, hot zikh gehaltn MISHPAT aleyn." 
