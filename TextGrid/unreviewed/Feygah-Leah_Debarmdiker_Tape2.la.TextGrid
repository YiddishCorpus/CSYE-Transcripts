            xmin = 1315.277 
            xmax = 1316.11 
            text = "" 
        intervals [483]:
            xmin = 1316.11 
            xmax = 1319.397 
            text = "eh yo iz undz ze'mir aheymgekumen m'hot teykef eh" 
        intervals [484]:
            xmin = 1319.397 
            xmax = 1325.081 
            text = "eh tseklopt di zangen, m'hot gemakht a DAYSA, m'hot koym gevart zol zikh opkokhn un s'zol zayn vos tsu esn nakhtmol." 
        intervals [485]:
            xmin = 1325.081 
            xmax = 1325.323 
            text = "" 
        intervals [486]:
            xmin = 1325.323 
