            xmax = 234.102 
            text = "" 
        intervals [79]:
            xmin = 234.102 
            xmax = 240.064 
            text = "yo, vi azoy m'hot es gefilt? koydem tsu tsu ersht iz geven tsugemakht di shuln." 
        intervals [80]:
