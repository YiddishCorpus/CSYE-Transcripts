            text = "" 
        intervals [70]:
            xmin = 208.806 
            xmax = 217.878 
            text = "un heflekhe mentshn hobn gekent vern, zogn antisemitn, zenen di ale g-, ho'mir gevust az yedn goy iz antisem- ober vern azolkhe khayes roes," 
        intervals [71]:
            xmin = 217.878 
